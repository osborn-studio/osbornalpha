# ─── Supabase (required) ───
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GUEST_MODE_ALLOWED=true

# ─── LLM (one provider required for AI committee) ───
# Set DEEPSEEK_API_KEY for the cheaper, faster default
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat       # or deepseek-reasoner (R1 with CoT)
#
# ANTHROPIC_API_KEY=                 # fallback / pin via LLM_PROVIDER=anthropic
# LLM_PROVIDER=                      # deepseek | anthropic (auto if unset)

# ─── Data sources ───
# TUSHARE_TOKEN=                     # A-share deep data (PE/PB/ROE/financials/holders)
# ALPHAVANTAGE_API_KEY=              # US stocks (optional, EDGAR + Eastmoney covers most)
