# ─── Supabase (required) ───
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Comma-separated OAuth providers that are actually enabled in Supabase.
# Supported values: google,github,apple. Leave empty to show email auth only.
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=

# Server-side only (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used only when configuring Supabase Auth SMTP through the Management API.
# This is a Resend API key and must never be exposed to the browser.
# RESEND_SMTP_PASSWORD=re_xxxxxxxxx

# Operational alerts and signed Resend delivery webhooks.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# ALERT_EMAIL_FROM=osbornALPHA Alerts <alerts@mail.osbornalpha.com>
# ALERT_EMAIL_TO=operator@example.com
# AUTH_EMAIL_PROBE_TARGETS=probe-one@example.com,probe-two@example.net
# AUTH_EMAIL_PROBE_PASSWORD=use-a-random-32-character-secret
# OBSERVABILITY_HASH_SECRET=use-a-separate-random-32-byte-secret

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Metered platform LLM (required in production) ───
# Keep the reviewed production provider/model explicit. A pinned provider
# without its own key fails closed; release-preflight never prints key values.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
LLM_DAILY_COST_LIMIT_MICRORMB=8800000
LLM_USD_CNY_MICROS=7200000
LLM_RESERVATION_TTL_SECONDS=300

# Legacy data-source LLM facade only; not a substitute for the reviewed
# platform provider/model above.
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=

# ─── Research OS (local-only module) ───
# Gates /research pages + /api/research/* and the local SQLite store
# (research-data/research.db). NEVER set on Vercel — the module is designed to
# stay inert in production (APIs return 501 when unset).
# RESEARCH_OS_ENABLED=1
# RESEARCH_DB_PATH=research-data/research.db   # optional override

# ─── Data sources ───
# TUSHARE_TOKEN=                     # A-share deep data (PE/PB/ROE/financials/holders)
# ALPHAVANTAGE_API_KEY=              # US stocks (optional, EDGAR + Eastmoney covers most)
