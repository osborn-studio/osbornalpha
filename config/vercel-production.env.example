# Vercel Production environment template for stock-monitor.
# Fill every REQUIRED blank before importing this file in Vercel.
# Never commit a filled copy of this file.

# --- Supabase / authentication (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://mzfcaabhuwtfvsvadvsv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=
NEXT_PUBLIC_APP_URL=https://stock-monitor-nu.vercel.app

# --- Cron and privileged endpoints (required in production) ---
CRON_SECRET=
CACHE_PURGE_SECRET=
SECURITY_RATE_LIMIT_SECRET=

# --- Platform LLM / budget (required for metered AI) ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
LLM_DAILY_COST_LIMIT_MICRORMB=8800000
LLM_USD_CNY_MICROS=7200000
LLM_RESERVATION_TTL_SECONDS=300
LLM_ENC_KEY=
LLM_DIGEST_TAKE=off

# Optional provider keys. Keep only the provider keys you actually use.
ARK_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- External evidence search (optional; required for verified News/Reports) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# Optional vendor tariff for the search run audit ledger; integer micro-USD/query.
SEARCH_COST_MICRO_USD_PER_QUERY=

# --- Supabase Auth email probes (currently disabled; leave blank) ---
AUTH_EMAIL_PROBE_TARGETS=
AUTH_EMAIL_PROBE_PASSWORD=
OBSERVABILITY_HASH_SECRET=

# --- Resend email delivery (optional, but needed for email alerts) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Telegram delivery (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Datagateway Wind quotes and daily K-line (optional) ---
DATAGATEWAY_BASE_URL=
DATAGATEWAY_API_KEY=
DATAGATEWAY_DAILY_KLINE_PATH=/v1/market-data/security-prices/history/query
# Requires a successful Wind capability probe for the exact symbol/date.
DATAGATEWAY_INTRADAY_KLINE_ENABLED=false
DATAGATEWAY_REALTIME_QUOTE_PATH=/v1/market-data/tickers/query

# --- Other market data providers (optional fallbacks) ---
TUSHARE_TOKEN=
ALPHAVANTAGE_API_KEY=
EODHD_API_TOKEN=

# --- Security master search and S&P 500 ingestion ---
SECURITY_MASTER_SEARCH_ENABLED=true
SP500_CONSTITUENTS_URL=
SP500_APPROVED_HOSTS=
SP500_CONSTITUENTS_STORAGE_PATH=

# --- Stripe billing (optional until billing is enabled) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS_30D=
STRIPE_PRICE_SUB_MONTHLY=

# --- Research OS cloud owner (required only if research-daily cron is enabled) ---
RESEARCH_OWNER_USER_ID=
RESEARCH_OS_ENABLED=

# --- Local-only / CI variables: do not import into Vercel ---
# RADAR_REPORTS_DIR=
# RESEARCH_DB_PATH=research-data/research.db
# SECURITY_BENCHMARK_EXACT=002463,00700,AAPL,BABA
# SECURITY_BENCHMARK_NAMES=沪电股份,腾讯控股,Apple,Alibaba,hdgf
# E2E_BASE_URL=https://stock-monitor-nu.vercel.app
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_WRITE_ENABLED=false
