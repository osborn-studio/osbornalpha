// src/lib/macro/regime.ts
// Typed regime rules and the single classification function (spec §5.1–§5.3, §0.2 M8/M14). The
// value_text → Number conversion happens at this boundary only; Δ / 3M changes are computed in
// decimal first. Weights are part of the method (frozen within v1.0); the coverage denominator is
// the region's WEIGHTS_V1 sum, missing/restricted items included. Pure: no I/O.
import {catalogById} from './catalog';
import {subtract,yoyPct} from './decimal';
import {REGIMES} from './judgment-contract';
import type {Regime,RegimeResult} from './judgment-contract';
import type {Region,RegimeContribution,SeriesType} from './types';

export const METHODOLOGY_VERSION='v1.0';
export const RULES_VERSION='macro-regime-rules/1.0';
/** id → weight for every role=indicator monthly/quarterly regime item (spec §4.2), frozen in v1.0. */
export const WEIGHTS_V1:Readonly<Record<string,number>>=Object.freeze({
 US_DFF:25,US_DGS10:15,US_DTWEXBGS:10,US_CPI_YOY:15,US_UNRATE:10,US_PPI_FD_YOY:5,US_ISM_PMI:15,US_VIX:5,
 CN_CPI_YOY:10,CN_PPI_YOY:15,CN_PMI_MFG:15,CN_GDP_YOY:5,CN_M2_YOY:10,CN_EXPORT_YOY:10,CN_CGB_10Y:15,CN_USDCNY_CP:5,
 CN_LPR_1Y:10,CN_MLF_1Y:10,CN_AFRE_STOCK_YOY:20,
});
export type Support=Partial<Record<Regime,number>>;
/** v = latest value; d3 = change vs the period 3 months earlier (previous quarter for quarterly;
 *  for fx a percent change, else a difference in the series unit); d1 = change vs the previous
 *  period. null = comparison period missing ⇒ any rule needing it does not match. */
export interface Rule{id:string;when:(v:number,d3:number|null,d1:number|null)=>boolean;support:Support;label:{zh:string;en:string}}
const rule=(id:string,when:Rule['when'],support:Support,zh:string,en:string):Rule=>({id,when,support,label:{zh,en}});
const nn=(x:number|null):x is number=>x!==null;
export const RULES:Readonly<Record<SeriesType,readonly Rule[]>>={
 policy_rate:[
  rule('policy.lt2_5',v=>v<2.5,{recovery:0.2,recession:0.7},'政策利率 < 2.5%','policy rate < 2.5%'),
  rule('policy.2_5to4_5',v=>v>=2.5&&v<4.5,{recovery:0.3,overheat:0.2,stagflation:0.1,recession:0.1},'2.5% ≤ 政策利率 < 4.5%','2.5% ≤ policy rate < 4.5%'),
  rule('policy.ge4_5.up',(v,_d3,d1)=>v>=4.5&&nn(d1)&&d1>=0,{overheat:0.6,stagflation:0.3},'政策利率 ≥ 4.5% 且未下调','policy rate ≥ 4.5% and not cut'),
  rule('policy.ge4_5.down',(v,_d3,d1)=>v>=4.5&&nn(d1)&&d1<0,{overheat:0.2,stagflation:0.2,recession:0.4},'政策利率 ≥ 4.5% 且下调','policy rate ≥ 4.5% and cut'),
 ],
 bond_yield:[
  rule('bond.d3m.ge25bp',(_v,d3)=>nn(d3)&&d3>=0.25,{overheat:0.5,stagflation:0.3},'收益率 3 个月上行 ≥ 25bp','yield up ≥ 25bp over 3 months'),
  rule('bond.d3m.le-25bp',(_v,d3)=>nn(d3)&&d3<=-0.25,{recovery:0.2,recession:0.5},'收益率 3 个月下行 ≥ 25bp','yield down ≥ 25bp over 3 months'),
  rule('bond.d3m.other',(_v,d3)=>nn(d3)&&d3>-0.25&&d3<0.25,{recovery:0.2,overheat:0.2,stagflation:0.2,recession:0.2},'收益率 3 个月变动在 ±25bp 内','yield 3-month change within ±25bp'),
 ],
 fx:[
  rule('fx.chg3m.ge2',(_v,d3)=>nn(d3)&&d3>=2,{overheat:0.4,stagflation:0.3},'汇率 3 个月变动 ≥ +2%','FX 3-month change ≥ +2%'),
  rule('fx.chg3m.le-2',(_v,d3)=>nn(d3)&&d3<=-2,{recovery:0.5,recession:0.2},'汇率 3 个月变动 ≤ −2%','FX 3-month change ≤ −2%'),
 ],
 inflation_yoy:[
  rule('infl.lt1',v=>v<1,{recovery:0.1,recession:0.7},'通胀同比 < 1%','inflation < 1% y/y'),
  rule('infl.1to2',v=>v>=1&&v<2,{recovery:0.5,recession:0.3},'1% ≤ 通胀同比 < 2%','1% ≤ inflation < 2% y/y'),
  rule('infl.2to3',v=>v>=2&&v<=3,{recovery:0.4,overheat:0.3,stagflation:0.1,recession:0.1},'2% ≤ 通胀同比 ≤ 3%','2% ≤ inflation ≤ 3% y/y'),
  rule('infl.3to4',v=>v>3&&v<=4,{overheat:0.6,stagflation:0.3},'3% < 通胀同比 ≤ 4%','3% < inflation ≤ 4% y/y'),
  rule('infl.gt4',v=>v>4,{overheat:0.4,stagflation:0.6},'通胀同比 > 4%','inflation > 4% y/y'),
 ],
 pmi:[
  rule('pmi.ge55',v=>v>=55,{recovery:0.3,overheat:0.6},'PMI ≥ 55','PMI ≥ 55'),
  rule('pmi.50to55',v=>v>=50&&v<55,{recovery:0.5,overheat:0.3},'50 ≤ PMI < 55','50 ≤ PMI < 55'),
  rule('pmi.47to50',v=>v>=47&&v<50,{recovery:0.1,stagflation:0.4,recession:0.4},'47 ≤ PMI < 50','47 ≤ PMI < 50'),
  rule('pmi.lt47',v=>v<47,{stagflation:0.3,recession:0.7},'PMI < 47','PMI < 47'),
 ],
 labor_rate:[
  rule('labor.d3m.ge0_3',(_v,d3)=>nn(d3)&&d3>=0.3,{stagflation:0.4,recession:0.5},'失业率 3 个月上升 ≥ 0.3pp','unemployment up ≥ 0.3pp over 3 months'),
  rule('labor.d3m.le-0_1',(_v,d3)=>nn(d3)&&d3<=-0.1,{recovery:0.5,overheat:0.4},'失业率 3 个月下降 ≥ 0.1pp','unemployment down ≥ 0.1pp over 3 months'),
 ],
 growth_yoy:[
  rule('growth.ge5.up',(v,_d3,d1)=>v>=5&&nn(d1)&&d1>=0,{recovery:0.5,overheat:0.3},'增长同比 ≥ 5% 且不低于上期','growth ≥ 5% y/y and not below the previous period'),
  rule('growth.lt4_5',v=>v<4.5,{stagflation:0.3,recession:0.6},'增长同比 < 4.5%','growth < 4.5% y/y'),
 ],
 liquidity_yoy:[
  rule('liq.ge8.up',(v,_d3,d1)=>v>=8&&nn(d1)&&d1>=0,{recovery:0.5,overheat:0.3},'流动性同比 ≥ 8% 且不低于上期','liquidity ≥ 8% y/y and not below the previous period'),
  rule('liq.ge8.down',(v,_d3,d1)=>v>=8&&nn(d1)&&d1<0,{recovery:0.2,overheat:0.4,stagflation:0.2},'流动性同比 ≥ 8% 且低于上期','liquidity ≥ 8% y/y and below the previous period'),
  rule('liq.lt8',v=>v<8,{stagflation:0.3,recession:0.5},'流动性同比 < 8%','liquidity < 8% y/y'),
 ],
 risk_index:[
  rule('risk.lt15',v=>v<15,{recovery:0.4,overheat:0.4},'风险指数 < 15','risk index < 15'),
  rule('risk.15to25',v=>v>=15&&v<25,{recovery:0.3,overheat:0.3,stagflation:0.2,recession:0.2},'15 ≤ 风险指数 < 25','15 ≤ risk index < 25'),
  rule('risk.ge25',v=>v>=25,{stagflation:0.5,recession:0.5},'风险指数 ≥ 25','risk index ≥ 25'),
 ],
 asset_price:[],
};
/** First rule of the series' own type whose condition holds (rules within a type are disjoint). */
export function matchRule(type:SeriesType,v:number,d3:number|null,d1:number|null):Rule|null{
 return RULES[type].find(r=>r.when(v,d3,d1))??null;
}
export interface ObsRef{observation_id:string;period_end:string;value_text:string}
export interface RegimeSeriesInput{latest:ObsRef;prev?:ObsRef;prev3m?:ObsRef}
export interface RegimeInput{region:Region;series:Record<string,RegimeSeriesInput>}
export interface RegimeOutput{regime:RegimeResult|null;contributions:RegimeContribution[];uncoveredWeight:number}

const r6=(x:number)=>Math.round(x*1e6)/1e6;
const zero=():Record<Regime,number>=>({recovery:0,overheat:0,stagflation:0,recession:0});
const GROWTH_TYPES:readonly SeriesType[]=['pmi','labor_rate','growth_yoy'];
/** WEIGHTS_V1 restricted to one region, in WEIGHTS_V1 order. */
export function regionWeights(region:Region):Record<string,number>{
 return Object.fromEntries(Object.entries(WEIGHTS_V1).filter(([id])=>catalogById(id)?.region===region));
}
function comparisons(type:SeriesType,s:RegimeSeriesInput):{v:number;d3:number|null;d1:number|null}|null{
 const v=Number(s.latest.value_text);
 if(!Number.isFinite(v))return null;
 const d1=s.prev?Number(subtract(s.latest.value_text,s.prev.value_text)):null;
 let d3:number|null=null;
 if(s.prev3m){
  if(type==='fx')d3=Number(s.prev3m.value_text)===0?null:Number(yoyPct(s.latest.value_text,s.prev3m.value_text));
  else d3=Number(subtract(s.latest.value_text,s.prev3m.value_text));
 }
 return {v,d3:d3!==null&&Number.isFinite(d3)?d3:null,d1:d1!==null&&Number.isFinite(d1)?d1:null};
}
/** argmax with the fixed tie order of REGIMES; secondary = best other state with norm > 0. */
export function pickStates(norm:Record<Regime,number>):{primary:Regime;secondary:Regime|null}{
 let primary:Regime=REGIMES[0];
 for(const s of REGIMES)if(norm[s]>norm[primary])primary=s;
 let secondary:Regime|null=null;
 for(const s of REGIMES){
  if(s===primary||norm[s]<=0)continue;
  if(secondary===null||norm[s]>norm[secondary])secondary=s;
 }
 return {primary,secondary};
}
/** The one classification function: snapshot publishing and MacroReadApi.classifyAsOf both call it. */
export function classifyRegime(input:RegimeInput):RegimeOutput{
 const weights=regionWeights(input.region);
 const denominator=Object.values(weights).reduce((a,b)=>a+b,0);
 const scores=zero();const contributions:RegimeContribution[]=[];
 let matched=0;const growth={num:0,w:0},inflation={num:0,w:0};
 for(const [id,weight] of Object.entries(weights)){
  const s=input.series[id];const def=catalogById(id);
  if(!s||!def||def.status!=='active'||!def.type||weight<=0)continue;   // second guard: a restricted / missing series never scores
  const c=comparisons(def.type,s);if(!c)continue;
  const hit=matchRule(def.type,c.v,c.d3,c.d1);if(!hit)continue;
  matched+=weight;
  const contribution=zero();
  for(const r of REGIMES){const x=weight*(hit.support[r]??0);scores[r]+=x;contribution[r]=r6(x);}
  const sp=(r:Regime)=>hit.support[r]??0;
  if(GROWTH_TYPES.includes(def.type)){growth.num+=weight*(sp('recovery')+sp('overheat')-sp('stagflation')-sp('recession'));growth.w+=weight;}
  if(def.type==='inflation_yoy'){inflation.num+=weight*(sp('overheat')+sp('stagflation')-sp('recovery')-sp('recession'));inflation.w+=weight;}
  contributions.push({series_id:id,observation_id:s.latest.observation_id,rule_id:hit.id,weight,support:{...hit.support},contribution});
 }
 const uncoveredWeight=r6(denominator-matched);
 const total=REGIMES.reduce((a,r)=>a+scores[r],0);
 const coverage=denominator>0?matched/denominator:0;
 if(coverage<0.6||total<=0)return {regime:null,contributions,uncoveredWeight};
 const norm=zero();for(const r of REGIMES)norm[r]=scores[r]/total;
 const {primary,secondary}=pickStates(norm);
 const regime:RegimeResult={
  primary_state:primary,secondary_state:secondary,
  scores:{recovery:r6(scores.recovery),overheat:r6(scores.overheat),stagflation:r6(scores.stagflation),recession:r6(scores.recession)},
  norm:{recovery:r6(norm.recovery),overheat:r6(norm.overheat),stagflation:r6(norm.stagflation),recession:r6(norm.recession)},
  coverage:r6(coverage),
  margin_pp:r6(100*(norm[primary]-(secondary===null?0:norm[secondary]))),
  growth_axis:growth.w>0?r6(growth.num/growth.w):null,
  inflation_axis:inflation.w>0?r6(inflation.num/inflation.w):null,
 };
 return {regime,contributions,uncoveredWeight};
}
// src/lib/macro/types.ts
// Shared macro types (spec §4). Every later module imports from here; changing a shape here is a
// plan change, not an implementation detail.
export type Region='US'|'CN';
export type SeriesType='policy_rate'|'bond_yield'|'fx'|'inflation_yoy'|'pmi'|'labor_rate'|'growth_yoy'|'liquidity_yoy'|'risk_index'|'asset_price';
export type SeriesStatus='active'|'missing'|'restricted';
export type Adapter='fred_csv'|'akshare';
export type Rights='public_domain'|'official_open'|'third_party';
export type ChangeKind='bp'|'pp'|'pct'|'points';
export type NativeFrequency='daily'|'monthly'|'quarterly'|'event';
export type PeriodKind='day'|'month'|'quarter';
export interface Bilingual{zh:string;en:string}
export interface SeriesSource{adapter:Adapter;fetchHost:string;publisher:Bilingual;via?:Bilingual;seriesKey:string;rights:Rights;attribution:Bilingual}
export type DeriveRule={kind:'month_end';from:string}|{kind:'yoy_from_index';from:string}|{kind:'index_minus_100';from:string};
export interface MacroSeriesDef{
 id:string;region:Region;role:'indicator'|'asset'|'event_source';type:SeriesType|null;name:Bilingual;unit:string;
 nativeFrequency:NativeFrequency;period:PeriodKind;adjustment:'sa'|'nsa'|'na';status:SeriesStatus;reason?:Bilingual;
 source:SeriesSource|null;            // null only for status missing; derived series carry the source of their input
 derive?:DeriveRule;                  // present ⇒ series is derived (no own evidence)
 aliasOf?:string;                     // asset view of another series (same observations); no own rows
 revisionPolicy:'revisable'|'immutable';weight:number;changeKind:ChangeKind;releaseLagDays?:number;definitionVersion:number;
}
/** Where a parser found a value inside the evidence bytes. html_cell (Task 9, ChinaBond / SAFE HTML tables): table = 0-based
 *  index of the <table> start tag in document order (comments stripped), row = 0-based <tr> directly inside it (header = 0),
 *  cell = 0-based <td>/<th> in that row (parsers/html-table.ts). */
export type Locator={kind:'csv_row';line:number;column:number}|{kind:'json_pointer';pointer:string}|{kind:'html_cell';table:number;row:number;cell:number};
/** Exact fetched bytes plus the receipt of this one retrieval (spec §0.2 N2). sha256 = hex of bytes. */
export interface EvidenceInput{sha256:string;bytes:Uint8Array;adapter:Adapter;fetchUrl:string;fetchHost:string;httpStatus:number;contentType:string;fetchedAt:string;toolVersions:Record<string,string>}
/** macro_evidence_objects: byte object, deduplicated by sha256. */
export interface EvidenceObject{sha256:string;object_path:string;adapter:Adapter;content_type:string;byte_length:number;created_at:string}
/** macro_retrievals: one row per retrieval, even when the bytes repeat. */
export interface Retrieval{retrieval_id:string;sha256:string;fetch_url:string;fetch_host:string;http_status:number;fetched_at:string;batch_id:string;tool_versions:Record<string,string>}
/** One value located inside one evidence object by a parser. periodEnd is ISO date (period end per series definition). */
export interface ParsedPoint{seriesId:string;periodEnd:string;valueText:string;locator:Locator}
/** rejected = a quarantined version refused by macro_resolve_conflict (never eligible again, never readable by anon). */
export type ObservationStatus='ok'|'quarantined'|'rejected';
export interface ObservationRow{
 observation_id:string;series_id:string;period_end:string;value_text:string;version:number;
 available_at:string;availability_basis:'first_seen';ingested_at:string;status:ObservationStatus;
 retrieval_id:string|null;locator:Locator|null;derived_from:string[]|null;transform:string|null;code_version:string;batch_id:string;
}
/** A row submitted to macro_write_observations. Exactly one of (retrieval_id+locator) | (derived_from+transform).
 *  available_at: native = the retrieval's fetched_at; derived = max available_at of ALL inputs (spec §0.2 M6). */
export type ObservationWrite=
 |{series_id:string;period_end:string;value_text:string;available_at:string;revisable:boolean;retrieval_id:string;locator:Locator}
 |{series_id:string;period_end:string;value_text:string;available_at:string;revisable:boolean;derived_from:string[];transform:string};
/** previously_rejected (第 5 稿 P1-2): the value was rejected before for this (series, period); nothing is inserted, the call
 *  counts it under `duplicates`, and the conflict is informational (no quarantine item, no error). */
export type WriteConflictReason='unexpected_revision'|'conflicting_rows'|'stale_delivery'|'missing_evidence'|'missing_input'|'previously_rejected';
export interface WriteResult{
 inserted:number;duplicates:number;versioned:number;quarantined:number;
 /** observation_id: the quarantined row (newly inserted, or the existing same-value quarantined row of an eligible or the
  *  current batch — 第 5 稿 P1-6) for unexpected_revision / stale_delivery; the rejected row for previously_rejected; null for
  *  conflicting_rows / missing_evidence / missing_input (nothing stored). Task 6 links quarantined rows to the dq_quarantine
  *  item via macro_link_quarantine (第 4 稿 P1-4). */
 conflicts:{series_id:string;period_end:string;reason:WriteConflictReason;value_text:string;current_value_text:string|null;observation_id:string|null}[];
}
export interface CatalogCounts{verified:number;missing:number;restricted:number}
export interface RegimeContribution{series_id:string;observation_id:string;rule_id:string;weight:number;support:Partial<Record<'recovery'|'overheat'|'stagflation'|'recession',number>>;contribution:Record<'recovery'|'overheat'|'stagflation'|'recession',number>}
export interface PublishInput{
 region:Region;expectedRevision:number;expectedInputRevision:number;asOf:string;methodologyVersion:string;catalogVersion:string;
 observationIds:string[];
 /** Frozen display history (第 4 稿 P1-8): the last 24 eligible observations per indicator (sparklines); validated like the manifest. */
 historyIds:string[];catalogCounts:CatalogCounts;
 regime:import('./judgment-contract').RegimeResult|null;contributions:RegimeContribution[];rulesVersion:string;uncoveredWeight:number;
 /** Idempotency key (第 5 稿 P1-4): 'ingest:<batch_id>' (ingest finish) or 'cron:<batch_id>' (cron). A key that already
  *  published returns that snapshot (replayed:true) instead of publishing again. Omitted only by tests and the rollback path. */
 publishKey?:string;
 /** Owner fence (第 5 稿 P1-3): the AKShare finish passes its batch and owner token; cron passes neither (its batch has no run). */
 batchId?:string;ownerToken?:string|null;
 /** Finish fence (review A2): the run's CURRENT finish token; required with ownerToken, else `fenced` (a rotated-out finisher cannot claim the publish key). */
 finishToken?:string|null;
}
export interface PublishResult{snapshot_id:string;revision:number;replayed:boolean}
export interface SnapshotRecord{
 snapshot_id:string;region:Region;as_of:string;revision:number;methodology_version:string;catalog_version:string;
 observation_ids:string[];history_ids:string[];catalog_counts:CatalogCounts;status:'active'|'superseded'|'failed';failure_reason:string|null;created_at:string;
}
export interface RegimeRecord{snapshot_id:string;region:Region;regime:import('./judgment-contract').RegimeResult|null;contributions:RegimeContribution[];rules_version:string;uncovered_weight:number}
export type AnalysisKind='change'|'level'|'rolling'|'event_window';
export interface ChunkCounts{fetched:number;inserted:number;duplicates:number;versioned:number;quarantined:number;failed:number}
/** Same shape as dq/batches BatchError (kept structural so types.ts imports nothing from dq). */
export interface ChunkError{code:string;key?:string;message?:string}
/** macro_ingest_chunks row (第 4 稿 P1-6/P2-1): claimed as processing, completed once with counts, errors and claim/location keys.
 *  Chunk counts are NATIVE outcomes only (chunks carry evidence); derived counts live in FinishProgress.derived (第 5 稿 P2-2).
 *  native_usable (第 6 稿 P2-1): native rows that are usable data = inserted + versioned + duplicates EXCLUDING previously_rejected
 *  (the RPC counts a rejected redelivery under duplicates); kept apart from the six DQ counters, which stay unchanged. Derivation,
 *  publication and freshness ok gate on Σ native_usable > 0. */
export interface ChunkRecord{seq:number;total:number;state:'processing'|'done';counts:ChunkCounts;native_usable:number;errors:ChunkError[];claim_keys:string[];located_keys:string[]}
/** aborted (第 5 稿 P1-3): a takeover fenced this run; every later mutation carrying its owner token raises `fenced`. */
export type IngestRunState='open'|'finishing'|'finished'|'aborted';
/** The lease answer of macro_claim_ingest (第 5 稿 P1-3/P2-1). ownerToken only when claimed. aborted = batch ids of this
 *  dataset's aborted runs whose ingest_batches row is still running (the caller finishes them failed; idempotent sweep). */
export interface IngestClaim{status:'claimed'|'busy';ownerToken:string|null;aborted:string[];holder:string|null}
/** Exclusive finish (第 5 稿 P1-4): beginFinish hands the owner a fresh finishToken (rotated on every resume, which fences an
 *  older concurrent finisher of the same owner at its next checkpoint); every recordFinishStep presents both tokens. */
export interface FinishFence{ownerToken:string;finishToken:string}
/** Steps recorded through macro_record_finish_step. freshness_recorded is NOT one of them (第 6 稿 P1-1): only
 *  macro_record_freshness writes it, in the same transaction as the dq_freshness upsert. */
export type FinishStep='derived'|'batch_finished'|'published'|'publish_attempt'|'receipt';
/** macro_ingest_runs.finish_progress (第 4 稿 P2-4; 第 5 稿 P1-4/P1-5/P2-2; 第 6 稿 P1-1): every finish step that already happened,
 *  so a retried finish resumes. freshness_recorded is written atomically with the freshness side effect (status = the stored
 *  dq_freshness status), so a retry either sees it and skips, or repeats a write that never committed — never a double count.
 *  publish_attempt appends to attempts[] (retryable publication failures; the run stays finishing). */
export interface FinishProgress{
 /** series_outcomes (T9-3): the collector's failed-series report, frozen by the first finish; retries must present the same one. usable (T9-2): derived usable rows. */
 derived?:({counts:ChunkCounts;errors:ChunkError[];usable?:number}|{skipped:'no_native_outcomes'})&{series_outcomes?:{series_id:string;ok:boolean;code?:string}[]};
 batch_finished?:{status:string;date:string};
 freshness_recorded?:{ok:boolean;status:string};
 published?:Record<string,unknown>;
 attempts?:{at:string;status:string;reason:string|null}[];
 receipt?:Record<string,unknown>;
 aborted?:{by:string;reason:'max_age'|'stalled_chunk'};
}
/** ingest_batches statuses a finalizer may write (第 6 稿 P1-1/P2-4); 'running' is only ever read back. Structural twin of
 *  dq/batches BatchStatus (types.ts imports nothing from dq). */
export type FinalStatus='success'|'partial'|'failed'|'rejected';
/** MacroDb.finalizeBatch input: status computed in TS (batchStatusFromCounts, or an explicit 'failed' for a fatal abort), the six
 *  counters, errors already capped like finishBatch (≤ 100 + one `truncated`, messages ≤ 500), finishedAt ISO (SQL keeps it ≥ started_at). */
export interface FinalizeInput{status:FinalStatus;counts:ChunkCounts;errors:ChunkError[];finishedAt:string}
/** finalized=false: the batch was no longer running (an earlier attempt finished it); status is the stored one, read back. */
export interface FinalizeResult{status:FinalStatus|'running';finalized:boolean}
/** MacroDb.recordFreshness input (第 6 稿 P1-1): same semantics as dq/freshness recordAttempt. dataset must be the run's dataset. */
export interface FreshnessWrite{dataset:string;ok:boolean;cadence:'daily'|'monthly'|'quarterly'|'event';now:string;detail:Record<string,unknown>}
/** One member of a dq_quarantine item (macro_quarantine_members ⨝ macro_observations; 第 4 稿 P1-4). */
export interface QuarantineMember{observation_id:string;series_id:string;period_end:string;value_text:string;version:number;status:ObservationStatus}
export type Timeliness='current'|'late'|'missing'|'n/a';
// src/lib/macro/views.ts
// Overview read model (spec §3.2, §4.5, §8 Envelope; 第 4 稿 P1-3/P1-8/P1-9/P2-3). Facts only: no regime field
// ever appears here (judgments come from F4 /api/judgments). Values come from the active snapshot's frozen
// manifest, sparklines from its frozen history_ids; one observationsByIds call reads both (plus the previous
// snapshot's manifest for "changes"), then ancestors are resolved one batched read per derivation level and
// their retrievals in one call. Never a per-indicator history query. compact skips history and provenance.
import type {TableClient} from '../db/table-client';
import {CATALOG_VERSION} from './catalog';
import type {MacroDb} from './db';
import {canonical,compare,subtract,yoyPct} from './decimal';
import {collectionStatus,datasetOf,releaseTimeliness} from './freshness';
import type {CollectionStatus} from './freshness';
import {catalogItemsOf} from './snapshots';
import type {Bilingual,CatalogCounts,ChangeKind,MacroSeriesDef,ObservationRow,Region,Timeliness} from './types';

export interface IndicatorRow{
 /** The exact manifest version shown (the drawer selects it); null without data. */
 observation_id:string|null;
 series_id:string;name:Bilingual;value_text:string|null;unit:string;change:{kind:ChangeKind;value_text:string}|null;
 period_end:string|null;available_at:string|null;availability_basis:'first_seen'|null;
 /** Release timeliness (schedule) — independent of presence (data in this snapshot or not). */
 timeliness:Timeliness;presence:'present'|'missing';
 status:'A'|'M'|'R';reason?:Bilingual;publisher:Bilingual|null;via:Bilingual|null;
 /** First native ancestor's retrieval; evidence = every native ancestor (derived provenance = ancestors' retrievals). */
 retrieval_id:string|null;evidence:{retrieval_id:string;sha256:string}[];sparkline:string[];
}
export type ChangeItemKind='new_release'|'revised'|'late'|'missing';
export interface ChangeItem{series_id:string;kind:ChangeItemKind;period_end:string|null}
export interface Changes{counts:Record<ChangeItemKind,number>;items:ChangeItem[]}
export interface Envelope{
 snapshotId:string|null;asOf:string|null;catalogVersion:string;methodologyVersion:string|null;
 collection:CollectionStatus[];indicators:IndicatorRow[];changes:Changes;catalogCounts:CatalogCounts|null;
}
export interface ViewDeps{db:MacroDb;tables:TableClient;now?:()=>Date}
export const COMPACT_KEYS:Record<Region,readonly string[]>={US:['US_DFF','US_DGS10','US_CPI_YOY'],CN:['CN_CPI_YOY','CN_PMI_MFG','CN_CGB_10Y']};
const SPARK_POINTS=24;
const MAX_DEPTH=4;
const STATUS_LETTER={active:'A',missing:'M',restricted:'R'} as const;

/** Exact ×100 of a canonical decimal (pct-point difference → bp). */
export function scaleBy100(text:string):string{
 const m=/^(-?)(\d+)(?:\.(\d+))?$/.exec(text);
 if(!m)throw new Error(`invalid_decimal:${text}`);
 const frac=(m[3]??'').padEnd(2,'0');
 return canonical(`${m[1]}${m[2]}${frac.slice(0,2)}${frac.length>2?`.${frac.slice(2)}`:''}`);
}
/** Change vs the previous comparable period in the series' declared kind; pct against zero → null. */
export function changeOf(kind:ChangeKind,cur:string,prev:string):{kind:ChangeKind;value_text:string}|null{
 if(kind==='bp')return {kind,value_text:scaleBy100(subtract(cur,prev))};
 if(kind==='pct')return compare(prev,'0')===0?null:{kind,value_text:yoyPct(cur,prev)};   // exact zero test: no float here (§0.2 M8)
 return {kind,value_text:subtract(cur,prev)};
}
/** series → [latest, previous] by period_end (a manifest holds one row per period). */
function latestTwo(rows:ObservationRow[]):Map<string,ObservationRow[]>{
 const by=new Map<string,ObservationRow[]>();
 for(const r of rows){const a=by.get(r.series_id)??[];a.push(r);by.set(r.series_id,a);}
 for(const [k,a] of by)by.set(k,a.sort((x,y)=>x.period_end<y.period_end?1:x.period_end>y.period_end?-1:y.version-x.version).slice(0,2));
 return by;
}
type Provenance={retrieval_ids:string[];evidence:{retrieval_id:string;sha256:string}[]};
/** Native retrievals behind each row (derived: all ancestors), resolved level by level: one observationsByIds per
 *  derivation level and one retrievalsByIds for everything (第 4 稿 P2-3). */
export async function resolveClosure(db:Pick<MacroDb,'observationsByIds'>,rows:ObservationRow[]):Promise<Map<string,ObservationRow>>{
 const known=new Map(rows.map(r=>[r.observation_id,r]));
 let frontier=[...new Set(rows.flatMap(r=>r.derived_from??[]))].filter(id=>!known.has(id));
 for(let depth=0;frontier.length>0&&depth<MAX_DEPTH;depth++){
  const got=await db.observationsByIds(frontier);
  for(const r of got)known.set(r.observation_id,r);
  frontier=[...new Set(got.flatMap(r=>r.derived_from??[]))].filter(id=>!known.has(id));
 }
 return known;
}
async function provenanceOf(db:MacroDb,rows:ObservationRow[]):Promise<Map<string,Provenance>>{
 const known=await resolveClosure(db,rows);
 const leaves=(r:ObservationRow,depth=0):string[]=>r.retrieval_id?[r.retrieval_id]:depth>=MAX_DEPTH?[]:(r.derived_from??[]).flatMap(id=>{const i=known.get(id);return i?leaves(i,depth+1):[];});
 const perRow=new Map(rows.map(r=>[r.observation_id,[...new Set(leaves(r))]]));
 const sha=new Map((await db.retrievalsByIds([...new Set([...perRow.values()].flat())])).map(x=>[x.retrieval_id,x.sha256]));
 return new Map([...perRow].map(([id,ids])=>[id,{retrieval_ids:ids,evidence:ids.flatMap(rid=>{const h=sha.get(rid);return h?[{retrieval_id:rid,sha256:h}]:[];})}]));
}
function emptyRow(def:MacroSeriesDef,timeliness:Timeliness):IndicatorRow{
 return {observation_id:null,series_id:def.id,name:def.name,value_text:null,unit:def.unit,change:null,period_end:null,available_at:null,availability_basis:null,timeliness,presence:'missing',
  status:STATUS_LETTER[def.status],...(def.reason?{reason:def.reason}:{}),publisher:def.source?.publisher??null,via:def.source?.via??null,retrieval_id:null,evidence:[],sparkline:[]};
}
/** "missing" in the changes card = no data in the snapshot (presence), restricted items excluded (第 4 稿 P1-3). */
const countsAsMissing=(r:IndicatorRow)=>r.presence==='missing'&&r.status!=='R';
const timelinessOf=(def:MacroSeriesDef,latest:string|null,today:string):Timeliness=>
 def.status==='missing'?'missing':def.status==='restricted'?'n/a':releaseTimeliness(def,latest,today);

export async function overviewEnvelope(deps:ViewDeps,region:Region,today:string,opts:{compact?:boolean}={}):Promise<Envelope>{
 const now=deps.now?.()??new Date();
 const [snap,allCollection]=await Promise.all([deps.db.activeSnapshot(region),collectionStatus(deps.tables,now)]);
 const collection=allCollection.filter(c=>c.dataset===datasetOf(region));
 const items=catalogItemsOf(region);
 const keep=(id:string)=>!opts.compact||COMPACT_KEYS[region].includes(id);
 const counts:Record<ChangeItemKind,number>={new_release:0,revised:0,late:0,missing:0};
 const changeItems:ChangeItem[]=[];
 const note=(series_id:string,kind:ChangeItemKind,period_end:string|null)=>{counts[kind]++;changeItems.push({series_id,kind,period_end});};
 if(!snap){
  const rows=items.map(d=>emptyRow(d,timelinessOf(d,null,today)));
  for(const r of rows)if(countsAsMissing(r))note(r.series_id,'missing',null);
  return {snapshotId:null,asOf:null,catalogVersion:CATALOG_VERSION,methodologyVersion:null,collection,
   indicators:rows.filter(r=>keep(r.series_id)),changes:{counts,items:opts.compact?[]:changeItems},catalogCounts:null};
 }
 const prevSnap=await deps.db.previousSnapshot(region,snap.created_at);
 // One read for everything shown: frozen manifest, frozen sparkline history, previous manifest (第 4 稿 P1-8/P2-3).
 const wanted=[...new Set([...snap.observation_ids,...(opts.compact?[]:snap.history_ids),...(prevSnap?.observation_ids??[])])];
 const byId=new Map((await deps.db.observationsByIds(wanted)).map(r=>[r.observation_id,r]));
 const pick=(ids:readonly string[])=>ids.flatMap(id=>{const r=byId.get(id);return r?[r]:[];});
 const manifest=latestTwo(pick(snap.observation_ids));
 const prevLatest=prevSnap?latestTwo(pick(prevSnap.observation_ids)):null;
 const history=new Map<string,ObservationRow[]>();
 for(const r of opts.compact?[]:pick(snap.history_ids)){const a=history.get(r.series_id)??[];a.push(r);history.set(r.series_id,a);}
 const shown=[...manifest.values()].map(a=>a[0]);
 const provenance=opts.compact?new Map<string,Provenance>():await provenanceOf(deps.db,shown);
 const rows:IndicatorRow[]=[];
 for(const def of items){
  const [latest,prev]=manifest.get(def.id)??[];
  const timeliness=timelinessOf(def,latest?.period_end??null,today);
  if(!latest){
   const row=emptyRow(def,timeliness);rows.push(row);
   if(countsAsMissing(row))note(def.id,'missing',null);
   continue;
  }
  const sparkline=(history.get(def.id)??[]).sort((a,b)=>a.period_end<b.period_end?-1:a.period_end>b.period_end?1:0).slice(-SPARK_POINTS).map(h=>h.value_text);
  const prov=provenance.get(latest.observation_id);
  rows.push({observation_id:latest.observation_id,series_id:def.id,name:def.name,value_text:latest.value_text,unit:def.unit,change:prev?changeOf(def.changeKind,latest.value_text,prev.value_text):null,
   period_end:latest.period_end,available_at:latest.available_at,availability_basis:latest.availability_basis,timeliness,presence:'present',status:STATUS_LETTER[def.status],
   ...(def.reason?{reason:def.reason}:{}),publisher:def.source?.publisher??null,via:def.source?.via??null,
   retrieval_id:prov?prov.retrieval_ids[0]??null:latest.retrieval_id,evidence:prov?.evidence??[],sparkline});
  if(prevLatest){
   const [p]=prevLatest.get(def.id)??[];
   if(!p||latest.period_end>p.period_end)note(def.id,'new_release',latest.period_end);
   else if(latest.period_end===p.period_end&&latest.observation_id!==p.observation_id)note(def.id,'revised',latest.period_end);
  }
  if(timeliness==='late')note(def.id,'late',latest.period_end);
 }
 return {snapshotId:snap.snapshot_id,asOf:snap.as_of,catalogVersion:snap.catalog_version,methodologyVersion:snap.methodology_version,collection,
  indicators:rows.filter(r=>keep(r.series_id)),changes:{counts,items:opts.compact?[]:changeItems},catalogCounts:snap.catalog_counts};
}
// Calendar helpers for period_end (spec §4.2: day = the date, month = last day of the month, quarter =
// last day of the quarter). Pure UTC date arithmetic on ISO YYYY-MM-DD strings; no Date parsing of
// local time. Shared by parsers (period_end of a source row), derive (month_end, yoy) and later tasks.
import type {PeriodKind} from './types';

const ISO=/^(\d{4})-(\d{2})-(\d{2})$/;
const pad=(n:number,w=2)=>String(n).padStart(w,'0');
/** True for a real calendar date in YYYY-MM-DD form (rejects 2026-02-30). */
export function isIsoDate(s:string):boolean{
 const m=ISO.exec(s);if(!m)return false;
 const y=Number(m[1]),mo=Number(m[2]),d=Number(m[3]);
 return mo>=1&&mo<=12&&d>=1&&d<=daysInMonth(y,mo);
}
export function daysInMonth(year:number,month:number):number{return new Date(Date.UTC(year,month,0)).getUTCDate();}
/** Last day of month (month 1..12). */
export function monthEnd(year:number,month:number):string{
 if(!Number.isInteger(year)||!Number.isInteger(month)||month<1||month>12)throw new Error('invalid_month');
 return `${pad(year,4)}-${pad(month)}-${pad(daysInMonth(year,month))}`;
}
/** Last day of quarter (q 1..4). */
export function quarterEnd(year:number,q:number):string{
 if(!Number.isInteger(q)||q<1||q>4)throw new Error('invalid_quarter');
 return monthEnd(year,q*3);
}
/** period_end of the period containing `date` for the series' period kind. */
export function periodEndOf(date:string,period:PeriodKind):string{
 if(!isIsoDate(date))throw new Error(`invalid_date:${date.slice(0,20)}`);
 const y=Number(date.slice(0,4)),m=Number(date.slice(5,7));
 return period==='day'?date:period==='month'?monthEnd(y,m):quarterEnd(y,Math.ceil(m/3));
}
/** Month end n months after the month of `date` (n may be negative). */
export function shiftMonthEnd(date:string,n:number):string{
 if(!isIsoDate(date)||!Number.isInteger(n))throw new Error('invalid_shift');
 const total=Number(date.slice(0,4))*12+Number(date.slice(5,7))-1+n;
 return monthEnd(Math.floor(total/12),(total%12+12)%12+1);
}
/** 'YYYY-MM' of an ISO date. */
export const monthKey=(date:string)=>date.slice(0,7);

