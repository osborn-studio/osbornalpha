  t: MacroT;
  region?: "US" | "CN";
  locale?: "zh" | "en";
  date?: string;
  rows?: ClockRow[];
  card?: JudgmentCard | null;
  loading?: boolean;
  onRefresh?: () => void;
  onEvidence?: (row: ClockRow) => void;
}
/** Current classification is supplied by clockFrom. Inspection is independent local UI state. */
export function MacroRegimeClock({
