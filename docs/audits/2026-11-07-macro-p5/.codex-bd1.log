diff --git a/src/components/macro/clock-weighted.test.ts b/src/components/macro/clock-weighted.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9dad4797e4463d4a679c76e1a4b59759d16e9d5f
--- /dev/null
+++ b/src/components/macro/clock-weighted.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { RULES_VERSION } from "@/lib/macro/regime";
+import { weightedClockFrom } from "./clock-weighted";
+import { quadrantRows } from "./clock-model";
+
+const scores = { recovery: 18.5, overheat: 21, stagflation: 8.5, recession: 4 };
+const total = 52;
+const obs = (series_id: string, period_end: string, value_text: string) => ({
+  observation_id: `${series_id}:${period_end}`, series_id, period_end, value_text, version: 1,
+});
+const observations = [
+  obs("US_CPI_YOY", "2026-06-30", "2.1"), obs("US_CPI_YOY", "2026-09-30", "2.5"),
+  obs("US_DFF", "2026-09-30", "4"),
+  obs("US_DGS10", "2026-06-30", "3.5"), obs("US_DGS10", "2026-08-31", "3.7"), obs("US_DGS10", "2026-09-30", "3.8"),
+  obs("US_UNRATE", "2026-06-30", "4.1"), obs("US_UNRATE", "2026-09-30", "3.9"),
+  obs("US_DTWEXBGS", "2026-09-30", "100"),
+];
+const contribution = (series_id: string, rule_id: string, weight: number, support: Record<string, number>, points: Record<string, number>) => ({
+  series_id, rule_id, weight, support, contribution: points,
+  observation_id: observations.filter(o => o.series_id === series_id).at(-1)!.observation_id,
+});
+const dto = {
+  snapshot: { snapshot_id: "bound", region: "US", observation_ids: observations.map(o => o.observation_id) },
+  observations, rulesVersion: RULES_VERSION, uncoveredWeight: 35,
+  contributions: [
+    contribution("US_CPI_YOY", "infl.2to3", 15, { recovery: .4, overheat: .3, stagflation: .1, recession: .1 }, { recovery: 6, overheat: 4.5, stagflation: 1.5, recession: 1.5 }),
+    contribution("US_DFF", "policy.2_5to4_5", 25, { recovery: .3, overheat: .2, stagflation: .1, recession: .1 }, { recovery: 7.5, overheat: 5, stagflation: 2.5, recession: 2.5 }),
+    contribution("US_DGS10", "bond.d3m.ge25bp", 15, { overheat: .5, stagflation: .3 }, { recovery: 0, overheat: 7.5, stagflation: 4.5, recession: 0 }),
+    contribution("US_UNRATE", "labor.d3m.le-0_1", 10, { recovery: .5, overheat: .4 }, { recovery: 5, overheat: 4, stagflation: 0, recession: 0 }),
+  ],
+  regime: { scores, norm: Object.fromEntries(Object.entries(scores).map(([k,v]) => [k, Math.round(v/total*1e6)/1e6])), coverage: .65,
+    primary_state: "overheat", secondary_state: "recovery", margin_pp: Math.round(2.5/total*100*1e6)/1e6,
+    growth_axis: .9, inflation_axis: -.1 },
+};
+
+describe("weighted clock", () => {
+  it("projects every weighted series and comparison roles from the frozen observations", () => {
+    const view = weightedClockFrom(dto, "bound", "en");
+    expect(view.status).toBe("ok");
+    expect(view.rows.map(r => [r.seriesId, r.state])).toEqual([
+      ["US_DFF", "matched"], ["US_DGS10", "matched"], ["US_DTWEXBGS", "not_matched"],
+      ["US_CPI_YOY", "matched"], ["US_UNRATE", "matched"], ["US_PPI_FD_YOY", "no_data"],
+      ["US_ISM_PMI", "missing"], ["US_VIX", "restricted"],
+    ]);
+    expect(view.rows.find(r => r.seriesId === "US_CPI_YOY")?.comparisons.map(c => c.role)).toEqual(["prev", "prev3m"]);
+    expect(view.rows.find(r => r.seriesId === "US_DGS10")?.comparisons.map(c => c.role)).toEqual(["prev", "prev3m"]);
+    expect(view.rows.find(r => r.seriesId === "US_DGS10")?.support).toEqual({ recovery: 0, overheat: .5, stagflation: .3, recession: 0 });
+    expect(view.rows.find(r => r.seriesId === "US_ISM_PMI")?.latest).toBeNull();
+    expect(quadrantRows(view.rows, "overheat").filter(r => r.amount > 0).slice(0, 3).map(r => r.seriesId))
+      .toEqual(["US_DGS10", "US_DFF", "US_CPI_YOY"]);
+    expect(view.insufficientCoverage).toBe(false);
+  });
+  it("hides all rows on stored-score tampering", () => {
+    const bad = structuredClone(dto);
+    bad.contributions[0].contribution.recovery = 7;
+    expect(weightedClockFrom(bad, "bound", "zh")).toMatchObject({ status: "reconcile_failed", rows: [], diagnostics: ["invariant_2"] });
+  });
+  it("marks insufficient coverage and rejects a different snapshot", () => {
+    expect(weightedClockFrom({ ...dto, regime: null }, "bound", "en").insufficientCoverage).toBe(true);
+    expect(weightedClockFrom(dto, "other", "en")).toMatchObject({ status: "unavailable", rows: [] });
+  });
+});
diff --git a/src/components/macro/clock-weighted.ts b/src/components/macro/clock-weighted.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2b2bcdade0df7e08143186e531aac7ebd4a47bd
--- /dev/null
+++ b/src/components/macro/clock-weighted.ts
@@ -0,0 +1,88 @@
+import { catalogById } from "@/lib/macro/catalog";
+import { reconcileStorage } from "@/lib/macro/clock-view";
+import type { Regime } from "@/lib/macro/judgment-contract";
+import { RULES, RULES_VERSION, regionWeights } from "@/lib/macro/regime";
+import { shiftMonthEnd } from "@/lib/macro/periods";
+import type { ObservationRow, RegimeRecord, Region } from "@/lib/macro/types";
+import { basisFrom } from "./judgment-view";
+import { formatValueText } from "./macro-format";
+
+const REGIMES: Regime[] = ["recovery", "overheat", "stagflation", "recession"];
+const isObject = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+const zero = (): Record<Regime, number> => ({ recovery: 0, overheat: 0, stagflation: 0, recession: 0 });
+const valueWithUnit = (value: string, unit: string) => formatValueText(value) + (unit === "pct" || unit === "pct_yoy" ? "%" : unit === "index" ? "" : unit);
+
+export interface WeightedRow {
+  seriesId: string;
+  name: string;
+  unit: string;
+  weight: number;
+  state: "matched" | "not_matched" | "no_data" | "missing" | "restricted";
+  latest: { observationId: string; period: string; value: string } | null;
+  comparisons: { role: "prev" | "prev3m"; period: string; value: string }[];
+  rule: string | null;
+  ruleId: string | null;
+  support: Record<Regime, number> | null;
+  contribution: Record<Regime, number> | null;
+  reason: string | null;
+}
+export interface WeightedClock {
+  status: "ok" | "reconcile_failed" | "unavailable";
+  rows: WeightedRow[];
+  insufficientCoverage: boolean;
+  diagnostics: string[];
+}
+const unavailable = (insufficientCoverage = false): WeightedClock => ({ status: "unavailable", rows: [], insufficientCoverage, diagnostics: [] });
+
+/** Project the exact stored decomposition only after its score and coverage invariants pass. */
+export function weightedClockFrom(json: unknown, snapshotId: string, locale: "zh" | "en"): WeightedClock {
+  const basis = basisFrom(json, snapshotId);
+  if (!basis || !isObject(json) || !isObject(json.snapshot) || !Array.isArray(json.observations)) return unavailable();
+  const region = json.snapshot.region;
+  if (region !== "US" && region !== "CN") return unavailable();
+  const insufficientCoverage = json.regime === null || (isObject(json.regime) && typeof json.regime.coverage === "number" && json.regime.coverage < .6);
+  if (typeof json.rulesVersion !== "string" || typeof json.uncoveredWeight !== "number" ||
+      (json.regime !== null && !isObject(json.regime))) return unavailable(insufficientCoverage);
+  const manifest = new Set(Array.isArray(json.snapshot.observation_ids) ? json.snapshot.observation_ids : []);
+  const observations: ObservationRow[] = [];
+  for (const raw of json.observations) {
+    if (!isObject(raw) || typeof raw.observation_id !== "string" || typeof raw.series_id !== "string" ||
+        typeof raw.period_end !== "string" || typeof raw.value_text !== "string" || typeof raw.version !== "number" ||
+        !manifest.has(raw.observation_id)) return unavailable(insufficientCoverage);
+    // Reconciliation reads only these five fields; the public DTO omits storage-only fields.
+    observations.push(raw as unknown as ObservationRow);
+  }
+  const rec: RegimeRecord = {
+    snapshot_id: snapshotId, region: region as Region,
+    regime: json.regime as RegimeRecord["regime"], contributions: basis,
+    rules_version: json.rulesVersion, uncovered_weight: json.uncoveredWeight,
+  };
+  const result = reconcileStorage({ region, observations, rec, snapshotCatalogVersion: typeof json.catalogVersion === "string" ? json.catalogVersion : undefined });
+  if (!result.ok) return { status: "reconcile_failed", rows: [], insufficientCoverage, diagnostics: result.diagnostics.map(d => d.code) };
+  const contributions = new Map(basis.map(c => [c.series_id, c]));
+  const bySeries = new Map<string, ObservationRow[]>();
+  for (const o of observations) bySeries.set(o.series_id, [...(bySeries.get(o.series_id) ?? []), o]);
+  const rows = Object.entries(regionWeights(region)).map(([seriesId, weight]): WeightedRow => {
+    const def = catalogById(seriesId)!;
+    const c = contributions.get(seriesId);
+    const all = (bySeries.get(seriesId) ?? []).sort((a, b) => a.period_end.localeCompare(b.period_end) || a.version - b.version);
+    const state: WeightedRow["state"] = def.status === "missing" ? "missing" : def.status === "restricted" ? "restricted" : c ? "matched" : all.length ? "not_matched" : "no_data";
+    const hidden = state === "missing" || state === "restricted";
+    const latest = hidden ? undefined : all.at(-1);
+    const earlier = latest ? all.filter(o => o.period_end < latest.period_end) : [];
+    const prev = earlier.at(-1);
+    const prev3m = latest ? earlier.find(o => o.period_end === shiftMonthEnd(latest.period_end, -3)) : undefined;
+    const comparisons: WeightedRow["comparisons"] = [];
+    if (prev) comparisons.push({ role: "prev", period: prev.period_end, value: valueWithUnit(prev.value_text, def.unit) });
+    if (prev3m) comparisons.push({ role: "prev3m", period: prev3m.period_end, value: valueWithUnit(prev3m.value_text, def.unit) });
+    const rule = c && json.rulesVersion === RULES_VERSION && def.type ? RULES[def.type].find(r => r.id === c.rule_id) : undefined;
+    const support = c ? { ...zero(), ...c.support } : null;
+    return {
+      seriesId, name: def.name[locale], unit: def.unit, weight, state,
+      latest: latest ? { observationId: latest.observation_id, period: latest.period_end, value: valueWithUnit(latest.value_text, def.unit) } : null,
+      comparisons, rule: c ? rule?.label[locale] ?? c.rule_id : null, ruleId: c?.rule_id ?? null,
+      support, contribution: c?.contribution ?? null, reason: def.reason?.[locale] ?? null,
+    };
+  });
+  return { status: "ok", rows, insufficientCoverage, diagnostics: [] };
+}

