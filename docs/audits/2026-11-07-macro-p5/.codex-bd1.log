.clock-breakdown {
  margin-top: 16px;
  border-top: 1px solid var(--border);
  padding-top: 12px;
}
.clock-table-scroll {
  overflow: visible;
  min-width: 0;
  margin-top: 12px;
}
.clock-breakdown table {
  table-layout: fixed;
  min-width: 0;
  width: 100%;
  font-size: 11px;
  text-align: left;
  border-collapse: collapse;
}
.clock-breakdown th,
.clock-breakdown td {
  padding: 10px 8px 10px 0;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  overflow-wrap: anywhere;
}
.clock-breakdown thead th {
  font-weight: 500;
  color: var(--text-dim);
}
.clock-breakdown tbody th {
  font-weight: 400;
  min-width: 0;
}
.clock-breakdown tbody a {
  color: var(--text);
}
.clock-breakdown small {
  display: block;
  color: var(--text-dim);
  font-size: 10px;
  margin-top: 4px;
}
.clock-breakdown td:nth-last-child(-n + 2) {
  text-align: right;
  font-family: var(--font-mono);
}
.clock-breakdown th:last-child {
  padding-right: 0;
  text-align: right;
}
.clock-breakdown td:last-child {
  padding-right: 0;
  color: var(--phase);
}
.clock-evidence-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 11px;
  margin-block: 12px;
}
.clock-evidence-links a,
.clock-evidence-links button {
  color: var(--phase);
  text-align: left;
}
.clock-footer {
  border-top: 1px solid var(--border);
  padding: 20px 28px;
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--text);
  }
  .macro-local-nav a:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
}
@container clock-phase (max-width: 560px) {
  .clock-table-scroll {
    overflow: visible;
  }
  .clock-breakdown table {
    min-width: 0;
    display: block;
  }
  .clock-breakdown thead {
    position: absolute;
    clip-path: inset(50%);
    height: 1px;
    width: 1px;
    overflow: hidden;
  }
  .clock-breakdown tbody {
    display: block;
  }
  .clock-breakdown tr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .clock-breakdown tbody th {
    grid-column: 1/-1;
    padding: 0;
    border: 0;
    font-size: 12px;
  }
  .clock-breakdown td {
    display: block;
    padding: 0;
    border: 0;
    font-size: 11px;
  }
  .clock-breakdown td:nth-child(3) {
    grid-column: 1/-1;
  }
  .clock-breakdown td:nth-last-child(-n + 2) {
    text-align: left;
  }
  .clock-breakdown td:before {
    content: attr(data-label);
    display: block;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 10px;
    margin-bottom: 4px;
  }
}
@media (min-width: 601px) {
  .clock-panel[data-phase="recession"] {
    grid-column: 1;
    grid-row: 2;
  }
  .clock-panel[data-phase="stagflation"] {
    grid-column: 2;
    grid-row: 2;
  }
}

.clock-breakdown col:nth-child(1) {
  width: 28%;
}
.clock-breakdown col:nth-child(2) {
  width: 16%;
}
.clock-breakdown col:nth-child(3) {
  width: 28%;
}
.clock-breakdown col:nth-child(4) {
  width: 12%;
}
.clock-breakdown col:nth-child(5) {
  width: 16%;
}
@container clock-phase (max-width: 560px) {
  .clock-breakdown td,
  .clock-breakdown tbody th {
    min-width: 0;
  }
  .clock-breakdown td:nth-child(2) {
    grid-column: 1 / -1;
  }
}
