      expect(html).toContain(
        t("judgment.clock.missingAxis", { axes: t("judgment.clock.growth") }),
      );
      expect(html).toContain(
        t("judgment.clock.tie", {
          primary: t("judgment.clock.stagflation"),
          secondary: t("judgment.clock.recession"),
        }),
      );
      expect(
        html.indexOf(t("judgment.widget.coverage", { value: 60 })),
