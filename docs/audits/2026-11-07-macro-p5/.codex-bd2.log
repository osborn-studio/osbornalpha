function toCard(v:unknown):JudgmentCard|null{
 if(!isObj(v)||typeof v.judgment_id!=='string'||typeof v.lifecycle!=='string'||!LIFECYCLES.has(v.lifecycle)||typeof v.calibration!=='string'||typeof v.as_of!=='string')return null;
