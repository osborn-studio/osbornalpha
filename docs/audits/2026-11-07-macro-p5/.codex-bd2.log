const isObj=(v:unknown):v is Record<string,unknown>=>typeof v==='object'&&v!==null&&!Array.isArray(v);
const isBilingual=(v:unknown):v is Bilingual=>isObj(v)&&typeof v.zh==='string'&&typeof v.en==='string';
