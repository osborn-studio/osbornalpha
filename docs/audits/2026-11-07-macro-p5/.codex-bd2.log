  color: var(--text-dim);
  margin-top: 6px;
}
.clock-total {
  margin-left: auto;
  text-align: right;
  flex-shrink: 0;
}
.clock-total strong {
  font-family: var(--font-mono);
  font-size: 24px;
  font-weight: 500;
  line-height: 1.1;
  color: var(--phase);
}
.clock-total small {
  display: block;
  font-size: 10px;
  color: var(--text-dim);
  margin-top: 4px;
}
.clock-meaning {
  font-size: 14px;
  font-weight: 500;
  margin-top: 20px;
}
.clock-signal {
  font-size: 12px;
  line-height: 1.7;
  color: var(--text-dim);
  margin-top: 6px;
  min-height: 40px;
}
.clock-drivers {
  border-top: 1px solid var(--border);
  margin-top: 20px;
  padding-top: 16px;
  min-height: 100px;
}
.clock-drivers .clock-eyebrow {
  letter-spacing: 0.04em;
  margin-bottom: 8px;
}
.clock-driver {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 12px;
  align-items: baseline;
  padding: 5px 0;
  font-size: 12px;
}
.clock-driver a {
  color: var(--text);
  line-height: 1.5;
}
.clock-driver span {
  font-size: 11px;
  color: var(--text-dim);
  font-variant-numeric: tabular-nums;
}
.clock-driver strong {
  color: var(--phase);
  font-family: var(--font-mono);
  font-weight: 500;
  min-width: 28px;
  text-align: right;
}
.clock-inspect {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 500;
  color: var(--phase);
  padding-top: 12px;
  margin-top: 12px;
  border-top: 1px solid var(--border);
}
.clock-inspect:hover {
  text-decoration: underline;
}
.clock-inspect span {
  font-size: 18px;
  line-height: 1;
}
.clock-cycle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 62px;
  height: 62px;
  border: 1px solid var(--border);
  border-radius: 50%;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  color: var(--text-dim);
}
.clock-cycle svg {
  position: absolute;
  inset: 3px;
  width: 54px;
  height: 54px;
  stroke: var(--text-dim);
  stroke-width: 1;
  fill: none;
}
.clock-cycle span {
  max-width: 34px;
  font-size: 8px;
  text-align: center;
  line-height: 1.2;
}
.clock-grid-wrap:has([aria-expanded="true"]) .clock-cycle {
  display: none;
}
.clock-breakdown {
  margin-top: 16px;
  border-top: 1px solid var(--border);
  padding-top: 12px;
}
.clock-table-scroll {
  overflow: visible;
  min-width: 0;
  margin-top: 12px;
}
.clock-breakdown table {
  table-layout: fixed;
  min-width: 0;
  width: 100%;
  font-size: 11px;
  text-align: left;
  border-collapse: collapse;
}
.clock-breakdown th,
.clock-breakdown td {
  padding: 10px 8px 10px 0;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  overflow-wrap: anywhere;
}
.clock-breakdown thead th {
  font-weight: 500;
  color: var(--text-dim);
}
.clock-breakdown tbody th {
  font-weight: 400;
  min-width: 0;
}
.clock-breakdown tbody a {
  color: var(--text);
}
.clock-breakdown small {
  display: block;
  color: var(--text-dim);
  font-size: 10px;
  margin-top: 4px;
}
.clock-breakdown td:nth-last-child(-n + 2) {
  text-align: right;
  font-family: var(--font-mono);
}
.clock-breakdown th:last-child {
  padding-right: 0;
  text-align: right;
}
.clock-breakdown td:last-child {
  padding-right: 0;
  color: var(--phase);
}
.clock-evidence-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 11px;
  margin-block: 12px;
}
.clock-evidence-links a,
.clock-evidence-links button {
  color: var(--phase);
  text-align: left;
}
.clock-footer {
  border-top: 1px solid var(--border);
  padding: 20px 28px;
  background: var(--bg-card);
}
.clock-footer h3 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 4px;
}
.clock-scenarios {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
  margin-block: 20px;
}
.clock-scenarios h4 {
  font-size: 11px;
  font-weight: 500;
  margin-bottom: 6px;
}
.clock-scenarios p {
  font-size: 11px;
  line-height: 1.7;
  color: var(--text-dim);
}
.clock-audit-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12px 24px;
  border-top: 1px solid var(--border);
  padding-top: 12px;
  font-size: 11px;
}
.clock-audit-row > a {
  color: var(--clock-gold);
}
.clock-audit-row > span {
  margin-left: auto;
  font-size: 10px;
}
.clock-audit-row summary {
  cursor: pointer;
  color: var(--text-dim);
}
.clock-audit-row dl {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 8px 16px;
  padding-top: 12px;
  font-size: 11px;
  max-width: 100%;
  color: var(--text-dim);
}
.clock-audit-row dd {
  overflow-wrap: anywhere;
  font-family: var(--font-mono);
}
.clock-skeleton {
  padding: 28px;
}
.clock-skeleton-heading {
  width: 35%;
  height: 56px;
  background: var(--bg-hover);
  margin-bottom: 24px;
}
.clock-skeleton-panel {
  min-height: 290px;
  background: var(--bg-hover);
  border-radius: 6px;
  animation: clock-pulse 1.8s ease-in-out infinite;
}
@keyframes clock-pulse {
  50% {
    opacity: 0.5;
  }
}
@media (prefers-reduced-motion: reduce) {
  .clock-skeleton-panel {
    animation: none;
  }
}
@media (min-width: 1200px) {
  .clock-panel {
    padding: 28px;
  }
  .clock-grid {
    gap: 24px;
  }
  .clock-phase-heading h3 {
    font-size: 22px;
  }
  .clock-meaning {
    font-size: 15px;
  }
}
@media (max-width: 900px) {
  .clock-header,
  .clock-context,
  .clock-footer {
    padding-inline: 20px;
  }
  .clock-grid-wrap {
    padding: 24px 20px;
  }
  .clock-panel {
    padding: 20px 16px;
  }
  .clock-phase-heading {
    gap: 8px;
  }
  .clock-phase-heading h3 small {
    display: block;
    margin: 4px 0 0;
  }
  .clock-phase-heading h3 {
    font-size: 18px;
  }
  .clock-driver {
    gap: 8px;
  }
  .clock-scenarios {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
}
@media (max-width: 600px) {
  .clock-header {
    align-items: flex-start;
    padding: 20px 16px;
    gap: 12px;
  }
  .clock-header h2 {
    font-size: 22px;
  }
  .clock-header-actions {
    max-width: 42%;
    gap: 12px;
    text-align: right;
  }
  .clock-current-label {
    font-size: 12px;
  }
  .clock-context {
    padding: 12px 16px;
    gap: 8px;
  }
  .clock-limitations {
    flex-basis: 100%;
    font-size: 11px;
  }
  .clock-grid-wrap {
    padding: 24px 16px;
  }
  .clock-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  .clock-panel {
    padding: 20px;
  }
  .clock-panel[data-phase="recession"] {
    order: 4;
  }
  .clock-panel[data-phase="stagflation"] {
    order: 3;
  }
  .clock-cycle {
    display: none;
  }
  .clock-phase-heading h3 small {
    display: inline-block;
    margin: 0 0 0 6px;
  }
  .clock-signal {
    min-height: 0;
  }
  .clock-drivers {
    min-height: 0;
  }
  .clock-footer {
    padding: 20px 16px;
  }
  .clock-scenarios {
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .clock-scenarios > div {
    border-left: 2px solid var(--border);
    padding-left: 12px;
  }
  .clock-audit-row > span {
    margin-left: 0;
  }
  .clock-audit-row details {
    width: 100%;
  }
  .clock-skeleton {
    padding: 16px;
  }
}
.macro-overview-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 24px;
}
.macro-overview-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.macro-local-nav {
  display: none;
}
.macro-overview-main [id] {
  scroll-margin-top: 24px;
}
@media (min-width: 1280px) {
  .macro-overview-layout {
    grid-template-columns: 180px minmax(0, 1fr);
  }
  .macro-local-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: sticky;
    top: 24px;
    height: fit-content;
    border-left: 1px solid var(--border);
    padding-top: 4px;
  }
  .macro-local-nav a {
    padding: 10px 16px;
    font-size: 12px;
    color: var(--text-dim);
    border-left: 2px solid transparent;
    margin-left: -1px;
  }
  .macro-local-nav a:first-child {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--text);
  }
  .macro-local-nav a:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
}
@container clock-phase (max-width: 560px) {
  .clock-table-scroll {
    overflow: visible;
  }
  .clock-breakdown table {
    min-width: 0;
    display: block;
  }
  .clock-breakdown thead {
    position: absolute;
    clip-path: inset(50%);
    height: 1px;
    width: 1px;
    overflow: hidden;
  }
  .clock-breakdown tbody {
    display: block;
  }
  .clock-breakdown tr {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .clock-breakdown tbody th {
    grid-column: 1/-1;
    padding: 0;
    border: 0;
    font-size: 12px;
  }
  .clock-breakdown td {
    display: block;
    padding: 0;
    border: 0;
    font-size: 11px;
  }
  .clock-breakdown td:nth-child(3) {
    grid-column: 1/-1;
  }
  .clock-breakdown td:nth-last-child(-n + 2) {
    text-align: left;
  }
  .clock-breakdown td:before {
    content: attr(data-label);
    display: block;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 10px;
    margin-bottom: 4px;
  }
}
@media (min-width: 601px) {
  .clock-panel[data-phase="recession"] {
    grid-column: 1;
    grid-row: 2;
  }
  .clock-panel[data-phase="stagflation"] {
    grid-column: 2;
    grid-row: 2;
  }
}

.clock-breakdown col:nth-child(1) {
  width: 28%;
}
.clock-breakdown col:nth-child(2) {
  width: 16%;
}
.clock-breakdown col:nth-child(3) {
  width: 28%;
}
.clock-breakdown col:nth-child(4) {
  width: 12%;
}
.clock-breakdown col:nth-child(5) {
  width: 16%;
}
@container clock-phase (max-width: 560px) {
  .clock-breakdown td,
  .clock-breakdown tbody th {
    min-width: 0;
  }
  .clock-breakdown td:nth-child(2) {
    grid-column: 1 / -1;
  }
}
.clock-reconcile-warning {
  margin: 16px 28px;
  color: var(--clock-gold);
}
.clock-row-dim { opacity: .7; }
.clock-comparison, .clock-support { display: block; white-space: nowrap; }
.clock-number { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.clock-breakdown .clock-table-scroll { overflow-x: auto; }
.clock-breakdown table { min-width: 900px; table-layout: auto; }
@container clock-phase (max-width: 560px) {
  .clock-breakdown .clock-table-scroll { overflow-x: auto; }
  .clock-breakdown table { display: table; min-width: 900px; }
  .clock-breakdown thead { position: static; clip-path: none; height: auto; width: auto; overflow: visible; }
  .clock-breakdown tbody { display: table-row-group; }
  .clock-breakdown tr { display: table-row; }
  .clock-breakdown tbody th, .clock-breakdown td { display: table-cell; padding: 10px 8px; border-bottom: 1px solid var(--border); }
  .clock-breakdown td:before { content: none; }
}
