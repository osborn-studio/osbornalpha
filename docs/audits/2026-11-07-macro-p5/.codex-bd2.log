  implications:{favored:[{zh:'大宗商品',en:'Commodities'}],disfavored:[{zh:'债券',en:'Bonds'}]},
  watch:['US_CPI_YOY','US_PPI_FD_YOY','US_DFF','US_WTI','CN_PPI_YOY','CN_CGB_10Y']},
 {regime:'stagflation',title:{zh:'滞胀',en:'Stagflation'},
