function flat(v:unknown,p=''):[string,string][]{
 if(typeof v==='string')return [[p,v]];
 if(typeof v!=='object'||v===null||Array.isArray(v))throw new Error(`non-string message at ${p}`);
 return Object.entries(v).flatMap(([k,c])=>flat(c,p?`${p}.${k}`:k));
}
