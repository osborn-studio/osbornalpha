const SPDJI:Bilingual={zh:'标普道琼斯指数公司',en:'S&P Dow Jones Indices LLC'};
const NASDAQ:Bilingual={zh:'纳斯达克',en:'Nasdaq, Inc.'};
const NBS:Bilingual={zh:'国家统计局',en:'National Bureau of Statistics of China'};
