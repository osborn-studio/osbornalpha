  const a=byMonth(d.a!),b=byMonth(d.b!);
  for(const [ym,x] of a){const y=b.get(ym);if(y)points.set(ym,{period_end:x.period_end,value_text:subtract(x.value_text,y.value_text),inputs:[toObsRef(x),toObsRef(y)]});}
