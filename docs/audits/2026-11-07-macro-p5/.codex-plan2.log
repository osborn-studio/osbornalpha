/bin/zsh -lc "sed -n '150,340p' docs/superpowers/plans/2026-11-07-macro-p5.md" in /Volumes/AIMATE_WORK/Developer/CodeX/OsbornAlpha/.claude/worktrees/company-research-ebd56f
