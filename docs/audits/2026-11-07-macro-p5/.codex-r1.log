}
export const MACRO_DATASETS=['macro.fred','macro.akshare'] as const;
export type MacroDataset=typeof MACRO_DATASETS[number];
export const datasetOf=(region:Region):MacroDataset=>region==='US'?'macro.fred':'macro.akshare';
