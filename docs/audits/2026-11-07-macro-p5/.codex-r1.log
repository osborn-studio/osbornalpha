'use client';
// CorrelationResult — one stored analysis run (spec §3.4, §7): numbers, the rule-generated sentence, charts with table
// views (scatter → table below 640px), and the frozen-input receipt (cutoff, catalog version, inputs hash, counts).
import type { AnalysisResult, AnalysisSpec, EventResult, FrozenInputs, PairResult, RollingResult } from '@/lib/macro/correlation';
import type { AnalysisKind, Bilingual } from '@/lib/macro/types';
import { DataTableToggle } from './charts/DataTableToggle';
import { MacroLineChart } from './charts/MacroLineChart';
import { ScatterFit } from './charts/ScatterFit';
import { sparklinePoints } from './charts/chart-geometry';
import { formatInstant } from './macro-format';
import { useMacroT, type MacroT } from './use-macro-t';
import { pick, type Locale } from './view-model';

export interface RunJson {
  run_id: string; request_id: string; kind: AnalysisKind; spec: AnalysisSpec; inputs: FrozenInputs; inputs_hash: string;
  results: (AnalysisResult & { explanation: Bilingual }) | null; code_version: string; method_version: string; status: 'ok' | 'failed'; error: string | null; created_at: string;
}
const f = (v: number, d = 2) => v.toFixed(d);
const cell = 'py-1 pr-3';

function Stat({ label, value }: { label: string; value: string }) {
  return <div><div className="text-[10px] uppercase tracking-wider text-text-dim">{label}</div><div className="font-mono tabular-nums">{value}</div></div>;
}

function Pairs({ res, t }: { res: PairResult; t: MacroT }) {
  const x = sparklinePoints(res.pairs.map((p) => String(p.x)), 480, 110, 4);
  const y = sparklinePoints(res.pairs.map((p) => String(p.y)), 480, 110, 4);
  return (
    <DataTableToggle
      t={t}
      narrowTable
      chart={
        <div className="space-y-3">
          <svg role="img" aria-label={`${t('correlation.result.x')} / ${t('correlation.result.y')}`} viewBox="0 0 480 110" className="h-auto w-full">
            {x && <polyline fill="none" stroke="var(--text)" strokeWidth={1.2} points={x} />}
            {y && <polyline fill="none" stroke="var(--accent)" strokeWidth={1.2} points={y} />}
          </svg>
          <div className="flex gap-4 text-[11px] text-text-dim">
            <span><span className="mr-1 inline-block h-0.5 w-3 bg-[var(--text)] align-middle" />{t('correlation.result.x')}</span>
            <span><span className="mr-1 inline-block h-0.5 w-3 bg-accent align-middle" />{t('correlation.result.y')}</span>
          </div>
          <ScatterFit pairs={res.pairs} slope={res.slope} intercept={res.intercept} label={t('correlation.result.scatterLabel')} xLabel={`${t('correlation.result.x')} (${res.x_unit})`} yLabel={`${t('correlation.result.y')} (${res.y_unit})`} />
          <div className="font-mono text-[11px] text-text-dim">{t('correlation.result.fit', { intercept: f(res.intercept, 4), slope: f(res.slope, 4) })}</div>
        </div>
      }
      table={
        <div className="max-h-80 overflow-y-auto">
          <table className="w-full text-xs">
            <thead><tr className="text-left text-[10px] text-text-dim"><th className={cell}>{t('correlation.result.t')}</th><th className={cell}>{t('correlation.result.s')}</th><th className={`${cell} text-right`}>{t('correlation.result.x')}</th><th className={`${cell} text-right`}>{t('correlation.result.y')}</th></tr></thead>
            <tbody>{res.pairs.map((p) => <tr key={p.t} className="border-t border-border"><td className={`${cell} font-mono`}>{p.t}</td><td className={`${cell} font-mono`}>{p.s}</td><td className={`${cell} text-right font-mono tabular-nums`}>{f(p.x, 4)}</td><td className={`${cell} text-right font-mono tabular-nums`}>{f(p.y, 4)}</td></tr>)}</tbody>
          </table>
        </div>
      }
    />
  );
}

function Rolling({ res, t }: { res: RollingResult; t: MacroT }) {
  return (
    <DataTableToggle
      t={t}
      chart={<MacroLineChart points={res.points.map((p) => ({ time: `${p.end}-01`, value: p.r }))} ariaLabel={t('correlation.result.rollingLabel')} height={200} />}
      table={
        <table className="w-full text-xs">
          <thead><tr className="text-left text-[10px] text-text-dim"><th className={cell}>{t('correlation.result.windowEnd')}</th><th className={`${cell} text-right`}>{t('correlation.result.r')}</th><th className={`${cell} text-right`}>{t('correlation.result.validPairs')}</th></tr></thead>
          <tbody>{res.points.map((p) => <tr key={p.end} className="border-t border-border"><td className={`${cell} font-mono`}>{p.end}</td><td className={`${cell} text-right font-mono tabular-nums`}>{f(p.r)}</td><td className={`${cell} text-right font-mono tabular-nums`}>{p.n}</td></tr>)}</tbody>
        </table>
      }
    />
  );

codex
| # | Severity P1/P2/P3 | Section | Defect | Concrete fix |
|---|---|---|---|---|
| 1 | P1 | §2.4 D1 | **D1 bypasses existing publication conditions.** The flag permits the snapshot API to expose stored results, but P1 §3.2 explicitly requires F4 cards, forbids percentages without `display.percent`, and forbids fallback to macro numbers when F4 fails. F4 §4.1 makes `publishable` a licensing gate for **all judgment cards**, not merely probabilities. Showing scores while `publishable=false` contradicts these rules and the owner’s “只有满足既有发布条件才展示”. | Require the server flag **and** a publishable, eligible F4 judgment bound to the same snapshot/method before displaying judgment numbers. Explicitly revise P1’s percentage policy if non-probability score shares are desired; do not reinterpret the existing gate. |
| 2 | P1 | §§3.2–3.3 | The client-importable view calls `matchRule`, reconstructs rule inputs, computes coverage and normalisation, and decides whether classification should have matched. This introduces client-side judgment computation despite §3.7. Reusing the matcher avoids a duplicate rule table, but does not satisfy the stated boundary. | Produce the decomposition/status projection server-side using version-selected inputs. Keep client work to formatting, sorting and navigation. Perform reconciliation on the server; never substitute its computed values for stored results. |
| 3 | P1 | §§3.3–3.4 | `regionWeights(region)` reads **current code**, not snapshot-time weights. The proposed `{version, weights}` cannot truthfully claim historical provenance. Current catalog status/name/unit also misdescribes old snapshots after WP-D changes missing rows to active. A rules-version check does not catch catalog or methodology mismatch. | Read the catalog frozen under `snapshot.catalog_version` from `macro_catalog_versions`, select the matching methodology weights, and return frozen metadata. Reject unsupported versions explicitly. Iterate the complete historical weight set, including missing/restricted rows. |
| 4 | P2 | §3.3 | `comparison_missing` has two incompatible definitions. “All rules require comparisons” fails mixed rule types; “either d1 or d3 missing” falsely labels GDP at 4.8, or FX inside ±2% with d3 present but d1 absent, as comparison-missing. | Define rule-specific input requirements in the authoritative server evaluator. Test intrinsic no-rule gaps separately from absent required comparisons; do not infer dependencies from arbitrary JavaScript predicates in the UI. |
| 5 | P2 | §§2.1, 3.3 | The comparison explanation is inaccurate: `typedChange` converts rate differences to **bp**, whereas the classifier uses percentage-point differences; FX d1 is a raw difference in `comparisons`, but a percentage change in `typedChange`. Also, §2.1 describes inflation-axis signs like growth-axis signs, while code uses the opposite inflation grouping. | Document rule-input value, unit and comparison period separately from display change. Correct the axis formula and footnote. Add examples for a 0.25pp/25bp yield move and FX d1/d3. |
| 6 | P2 | §§3.3–3.6 | `ClockView.status` cannot represent `no_regime_record`, loading, disabled or unavailable. `regime=null` is always labelled insufficient coverage even though the specification also allows zero-score and absent-record cases. Required reconciliation fields have no defined values when scores do not exist. | Use a discriminated response/state union with explicit record presence and no-regime reason. Make reconciliation nullable when unavailable; preserve absent coverage as null rather than inventing zero. |
| 7 | P1 | §§3.3, 3.8, 8 | Reconciliation checks only contribution sums and normalisation. It can pass with wrong support coefficients, duplicate rows, an observation belonging to another series, wrong coverage/uncovered weight, or inconsistent primary/secondary/margin. Nevertheless §8 claims complete arithmetic and snapshot proof. | Validate unique weighted rows, manifest membership and series identity, `weight × support = contribution`, complete denominator, matched plus uncovered weight, stored coverage, ranking and margin using defined rounding tolerances. Add deliberate corruption cases for each invariant. |
| 8 | P2 | §§2.3–2.4, 3.2 | The spec assumes list cards contain `inputs[].ref.snapshot_id`, but the proposed reused `parseJudgments` does not read that shape: it accepts top-level snapshot IDs or `inputs.snapshot_id`. Matching only snapshot ID also omits method/version and lifecycle eligibility. An empty list does not prove “v1 未开放发布”. | Specify and test the actual list/detail contract; fetch detail when necessary. Match method, version, snapshot and eligible lifecycle. Use a neutral empty-state message unless publication metadata establishes the cause. |
| 9 | P2 | §2.4 | `macro_regime@v1` is **categorical**, with `scores_are_not_probabilities=true`. Its sample threshold/ECE parameter does not establish a future calibrated probability output. “After enough months, percent becomes available” is therefore an unsupported premise. | Remove the expected probability path for this method. Only render probability for a separately defined probability claim whose F4 display contract permits it; preserve categorical evaluation terminology. |
| 10 | P2 | §§3.5, 3.8 | The mandatory label “规则得分占比（非概率）” fails the proposed prohibition on `概率` everywhere except the F4 percent key. The new methodology rule table also lacks an explicit off-state mounting rule; placing strings under `judgment.*` does not prevent rendering them when disabled. | Exempt a narrowly defined non-probability disclaimer. Gate the methodology judgment section with the server-provided prop and test rendered off-state content. Preserve `pages.test.ts`’s literal prohibition throughout component files, including comments. |
| 11 | P1 | §§3.3, 5.7, 10 | Formula-hash drift begins in **WP-B**, not only WP-D: `macroRegimeV1.deps` explicitly includes `snapshots.ts`, which WP-B refactors. WP-D also changes other dependencies. Unchanged numerical output does not prevent `methodology-sync` refusing the changed hash. | Include a method-version/hash migration strategy for every PR touching the closure or declared dependencies. Test sync against the previously registered row, not merely fresh registration. Do not describe P5-B as independently safe without this dependency. |
| 12 | P1 | §5.7 | Importing v1’s implementation functions and changing v2’s params will not work. Those functions are not exported, and both `gather` and `compute` close over **`macroRegimeV1.params.catalog_version`**. Reusing its object methods preserves the old pin too. | Implement a version-bound factory or independent v2 functions with an immutable explicit catalog pin. Test v2 through gather → compute → registration, including rejection of v1 snapshots. Account for the resulting v1 hash impact. |
| 13 | P1 | §§5.7, 8 | Removing v1 from `REGISTRY` avoids one sync comparison but does not preserve historical execution. v1 imports the mutable classifier/catalog, and `classifyAsOf` uses current catalog inputs. The spec changes v1 fixtures while claiming historical replay is unchanged. | Preserve original v1 fixtures and executable version bindings. Add v2 fixtures separately, define retirement explicitly, and prove that an existing v1 judgment can still replay/settle after the catalog upgrade—or state a concrete supported migration limitation. |
| 14 | P1 | §4.4 | Preset responses contain `inputs_hash` but neither frozen inputs nor a durable manifest reference. `CorrelationResult` currently requires `inputs`. `snapshotId` is insufficient: POST reads full histories at a new wall-clock cutoff, including assets/events outside the overview manifest. The displayed result cannot be replayed from its response. | Return a complete frozen input receipt or a durable immutable manifest reference, including cutoff and catalog/code/method versions. Bind computation to that receipt rather than merely labelling it with the active snapshot ID. |
| 15 | P2 | §4.4 | The memo key does not identify actual input histories or cutoff. Revisions can arrive without a new active snapshot, and different instances can compute different results under the same key. “Save as my analysis” POST rereads current data, so it can save different numbers from the displayed card. | Cache by an immutable input manifest/hash. Save that exact manifest through a validated server-issued reference, or rename the action “rerun and save” and show that the result may change. |
| 16 | P2 | §§4.4, 4.7 | “No stored runs” satisfies only half of P1 §3.4: P1 also says **不自动重算**. This route automatically computes results and bypasses run accounting for the eight presets. It is not an arbitrary-analysis quota bypass if strictly allowlisted, but process-local caching does not bound cold-start/multi-instance DB and compute cost. | Explicitly amend the product/quota policy for shared preset results. Specify authentication, a fixed preset allowlist, read/code-version/error limits, shared caching or request limits, and cost measurements. Define an actual per-preset API before promising “逐张加载”. |
| 17 | P2 | §4.1 | Each big-card heading uses the frozen overview envelope, while `IndicatorDetail` independently fetches latest histories and renders its own current value. After ingestion, one card can show two different “current” values and evidence versions. | Pass a frozen cutoff/manifest into the embedded detail, or explicitly separate “snapshot value” from “latest history” with their dates. Test an ingestion occurring between overview and detail requests. |
| 18 | P1 | §5.2 | WTREGEN is labelled `usd_bn`, with no conversion, but the primary series is **millions of U.S. dollars**, weekly ending Wednesday. This produces a 1,000× unit error and can quarantine valid values against the proposed 10,000 maximum. [FRED WTREGEN](https://fred.stlouisfed.org/series/WTREGEN) | Use `usd_mn` for native and derived WTREGEN, or introduce an explicit versioned ÷1,000 derivation with provenance. Test a known source value and its rendered unit. |
| 19 | P2 | §5.2 | `month_end` selects the last observation **dated within the month**. That is not necessarily “月末所在周的周平均”: a month ending after Wednesday can belong to a week ending in the next month. WALCL is similarly the last Wednesday observation, not a measured calendar-month-end balance. | Name both derived series by the exact selection rule. Preserve the source observation date and completion witness. Add a month ending Friday/Sunday and a missing final-week case; never silently treat an earlier available week as the expected final week. |
| 20 | P1 | §§5.3–5.5 | The migration plan targets a nonexistent `macro_series.adapter` CHECK. The actual adapter restriction is on `macro_evidence_objects.adapter`. It also omits the `macro_series.derive` CHECK for `effective_interval`, and changing the locator column CHECK alone leaves `macro_write_observations`’ locator allowlist rejecting `html_text`. | Enumerate and migrate the real table constraints and RPC validations. Include end-to-end database tests for official HTTP evidence, effective-interval catalog rows and native `html_text` observations. |
| 21 | P1 | §§5.3, 5.6 | Adding `official_http` functions to `cnSpecOf` is insufficient: `cnSeriesSpecs()` selects only `collectableOf('akshare')`, and `cnSpecOf` itself rejects other adapters. `worldbank_csv` has no complete type/provider/evidence/ingestion contract. | Define adapter routing through export, collector, ingest schema, parser, storage and freshness. Add a full evidence-to-observation test per adapter. Keep unimplemented sources missing with `source:null`. |
| 22 | P1 | §§5.3, 5.5 | LPR observations are stored at month-end, then used to derive policy events. The event contract exposes `effective_date`, but quote dates are not preserved in its observation fields. This can move a rate event to month-end. Existing `PolicyEvent`, `IndicatorDetail` and `seriesExtras` are US-specific; CN cycles do not become available automatically. | Preserve official quote/effective dates explicitly; define a discriminated CN event shape and update all consumers and cycle dispatch. Test actual event-date boundaries and missing intervening months. |
| 23 | P1 | §5.5 | Calling MLF carry-forward “不是插值” does not establish that an operation’s rate remains an effective policy rate until another operation. A missing announcement and a verified month without operations are indistinguishable; “完成见证” is undefined. The design can manufacture scored monthly values across collection gaps. | Require source-backed validity intervals and evidence of collection completeness, define the witness and `available_at`, and stop derivation across unverifiable gaps. Otherwise keep monthly MLF missing. |
| 24 | P2 | §5.4 | The balance-derived AFRE fallback lacks a complete `CN_AFRE_STOCK` definition and a comparable-statistical-scope rule. Taking current balance divided by a year-earlier balance across an expansion of coverage can fabricate economic growth. A mutable native/derived fallback under one series definition also changes provenance semantics. | Define the balance series and units, pin the derivation policy, require comparable scope/vintage across both endpoints, and leave incompatible comparisons missing. Prefer the officially published growth rate when available. |
| 25 | P2 | §§5.6, 10 | HK/World Bank rows have no resolved `region`, while TypeScript and SQL allow only US/CN. Pink Sheet monthly averages have no specified integration with daily/month-end historical boundaries. Adding rows alone also does not extend the frozen `CYCLE_COLUMNS_V1` list. | Decide regional assignment and average-price semantics before catalog insertion. Define units, quality rules and supported boundaries. If adding historical columns, introduce a new manifest configuration/version and fixture; preserve v1. |
| 26 | P2 | §§5.7–5.8, 10 | The rollout remains internally contradictory: D1 activates verified series before D2/D3 ship their adapters, D4/D5 later change the catalog again, and “missing + complete source” violates `macro_series_source_iff_not_missing`. Exact missing/restricted and `regimeInputsOf` lists in `catalog.test.ts` also change beyond the enumerated tests. | Publish a PR-by-PR matrix of catalog hash, method version, supported adapters and active statuses. Activate only when ingestion support is deployable. Preserve the missing/source invariant and enumerate all affected exact-list tests. |
| 27 | P2 | §§7–8 | The acceptance table cannot prove its claims as written: screenshots/view-model calls do not verify the evidence drawer retrieves the frozen row; old cutoff tests do not cover the new effective-interval witness; performance substitutes clock/preset timing for the handoff’s history/policy-response loading requirement. Canvas links are still empty. | Add focused API/component integration tests for frozen evidence and new derivation cutoffs, measure history/policy-response reads under stated cache conditions, and complete the required desktop/mobile canvases before UI implementation. |

