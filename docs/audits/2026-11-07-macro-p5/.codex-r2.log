 const seen=new Set((await db.latestEligible(active.map(d=>d.id))).map(r=>r.series_id));
 return {
  verified:active.filter(d=>seen.has(d.id)).length,
  missing:items.filter(d=>d.status==='missing').length+active.filter(d=>!seen.has(d.id)).length,
  restricted:items.filter(d=>d.status==='restricted').length,
 };
}
export type OnPublished=(snapshot:SnapshotRecord)=>Promise<void>;
/** Default judgment hook: F4 wires produce(macro_regime_v1, …) here later (F4 spec §11.1). */
export const noopOnPublished:OnPublished=async()=>{};
export interface PublishDeps{db:MacroDb;onPublished?:OnPublished;env?:Record<string,string|undefined>}
/** publishKey: 'cron:<batch>' | 'ingest:<batch>' (第 5 稿 P1-4); fence: the ingest run's batch + owner token (P1-3). */
export interface PublishOptions{publishKey?:string;fence?:{batchId:string;ownerToken:string|null;finishToken:string|null}}
export type PublishReceipt=
 |{status:'published';region:Region;snapshot_id:string;revision:number;observation_count:number;regime:'classified'|'null';uncovered_weight:number;attempts:number;hook:'skipped'|'ok'|'failed';replayed:boolean}
 |{status:'stale';region:Region;attempts:number}
 |{status:'failed';region:Region;reason:string;failed_snapshot_id:string|null;attempts:number};
async function runHook(deps:PublishDeps,env:Record<string,string|undefined>,snapshotId:string):Promise<'skipped'|'ok'|'failed'>{
 if(!macroJudgmentsEnabled(env))return 'skipped';
 try{
  const snap=await deps.db.snapshot(snapshotId);
  if(!snap)return 'failed';
  await (deps.onPublished??noopOnPublished)(snap);
  return 'ok';
 }catch(e){console.error('[macro-publish] judgment hook failed',e instanceof Error?e.message:e);return 'failed';}
}
const isFenced=(e:unknown)=>e instanceof MacroDbError&&e.code==='fenced';
/** Every outcome is a receipt, except `fenced` (a superseded ingest owner; 第 5 稿 P1-3), which is rethrown so the finish stops.
 *  `today` is the snapshot's as_of (YYYY-MM-DD). */
export async function publishRegion(deps:PublishDeps,region:Region,today:string,opts:PublishOptions={}):Promise<PublishReceipt>{
 const env=deps.env??process.env;
 let attempts=0;
 try{
  for(;;){
   attempts++;
   try{
    const state=await deps.db.publishState(region);
    const built=await buildRegimeInput(deps.db,region);
    const cls=classifyRegime(built.input);
    const counts=await catalogCounts(deps.db,region);
    const res=await deps.db.publishSnapshot({
     region,expectedRevision:state.revision,expectedInputRevision:state.inputRevision,asOf:today,
     methodologyVersion:METHODOLOGY_VERSION,catalogVersion:CATALOG_VERSION,observationIds:built.observations.map(o=>o.observation_id),historyIds:built.historyIds,
     catalogCounts:counts,regime:cls.regime,contributions:cls.contributions,rulesVersion:RULES_VERSION,uncoveredWeight:cls.uncoveredWeight,
     publishKey:opts.publishKey,batchId:opts.fence?.batchId,ownerToken:opts.fence?.ownerToken,finishToken:opts.fence?.finishToken,
    });
    if(res.replayed){
     // An earlier attempt published under this key (and ran or lost its hook; F4's produce is never re-triggered from a replay).
     // The receipt describes THAT snapshot from its persisted fields (第 6 稿 P2-2), not the inputs rebuilt above, which may differ.
     const snap=await deps.db.snapshot(res.snapshot_id);
     if(!snap)throw new MacroDbError('rpc_failed',`replayed_snapshot_missing:${res.snapshot_id}`);
     const stored=await deps.db.regimeOf(res.snapshot_id);                                             // admin read (service-only table)
     if(!stored)throw new MacroDbError('rpc_failed',`replayed_regime_missing:${res.snapshot_id}`);     // never invent uncovered_weight 0
     return {status:'published',region,snapshot_id:res.snapshot_id,revision:res.revision,observation_count:snap.observation_ids.length,
      regime:stored.regime?'classified':'null',uncovered_weight:stored.uncovered_weight,attempts,hook:'skipped',replayed:true};
    }
    const hook=await runHook(deps,env,res.snapshot_id);
    return {status:'published',region,snapshot_id:res.snapshot_id,revision:res.revision,observation_count:built.observations.length,
     regime:cls.regime?'classified':'null',uncovered_weight:cls.uncoveredWeight,attempts,hook,replayed:false};
   }catch(e){
    if(e instanceof MacroDbError&&e.code==='stale_publisher'){if(attempts<2)continue;return {status:'stale',region,attempts};}
    throw e;
   }
  }
 }catch(e){
  if(isFenced(e))throw e;                                                                             // protocol abort, not a failed publication
  const reason=(e instanceof MacroDbError?e.code:e instanceof Error?e.message:String(e)).slice(0,500);
  let failed:string|null=null;
  try{failed=await deps.db.recordFailedSnapshot({region,asOf:today,methodologyVersion:METHODOLOGY_VERSION,catalogVersion:CATALOG_VERSION,reason});}
  catch(e2){console.error('[macro-publish] recordFailedSnapshot failed',e2 instanceof Error?e2.message:e2);}
  return {status:'failed',region,reason,failed_snapshot_id:failed,attempts};
 }
}
// src/lib/judgments/methodologies/macro-regime.v1.ts
// macro_regime@v1 (spec §11.1, §8.1 G28; doc docs/methodologies/macro_regime/v1.md): current-period nowcast of the US/CN
// growth–inflation regime, bound to one published macro snapshot (binding.snapshot_id, spec §6.4). The claim restates the
// snapshot's primary state as a categorical claim: distribution = norm flagged scores_are_not_probabilities, margin_pp in
// percentage points, catalog_version frozen. The label is the same classifier re-run for the same reference month on the
// cutoff vintage (resolver macro_regime_replay, label_policy cutoff_vintage, horizon 3 calendar months).
// Active: the landed macro API reuses classifyRegime. Licenses remain unverified: publishable=false.
import type {Abstained,Active,CategoricalClaim,Condition,Input,JudgmentInputsDb,MacroSnapshotSnapshot,Methodology,Regime,Subject,Target,WorkItem} from '@/lib/judgments/types';
import {buildInput} from '@/lib/judgments/inputs';
import {addMonthsPeriod} from '@/lib/judgments/time';

import {METHODOLOGY_VERSION} from '@/lib/macro/regime';
export const MACRO_UPSTREAM_VERSION=METHODOLOGY_VERSION;
export const MACRO_REGIMES:readonly Regime[]=['recovery','overheat','stagflation','recession'];
/** Allowed gap (pp) between the snapshot's stored margin and the one recomputed from norm; a fraction-valued margin fails it (G28). */
export const MARGIN_UNIT_TOLERANCE_PP=0.01;
/** Macro spec §5.3 classifies nothing below this coverage; re-checked because compute never trusts the snapshot status. */
const MIN_COVERAGE=0.6;
const ZH:Record<Regime,string>={recovery:'复苏',overheat:'过热',stagflation:'滞胀',recession:'衰退'};
type SnapshotInput=Extract<Input,{kind:'macro_snapshot'}>;

const abstain=(reason:string,missing?:string[]):Abstained=>missing?{abstained:true,reason,missing}:{abstained:true,reason};
const snapshotOf=(inputs:Input[]):MacroSnapshotSnapshot|null=>inputs.find((i):i is SnapshotInput=>i.kind==='macro_snapshot')?.snapshot??null;
/** (norm[primary] − norm[secondary]) × 100, rounded to 6 decimals: percentage points (spec §8.1). */
export const marginPp=(norm:Record<Regime,number>,primary:Regime,secondary:Regime)=>Math.round((norm[primary]-norm[secondary])*1e8)/1e6;

async function gather(item:WorkItem,db:JudgmentInputsDb):Promise<Input[]|Abstained>{
 const snapshotId=item.binding?.snapshot_id;
 if(!snapshotId)return abstain('binding_missing',['snapshot_id']);
 const published=await db.macro.snapshot(snapshotId);
 if(published&&published.status!=='active'&&published.status!=='superseded')return abstain('snapshot_not_published');
 const snap=await buildInput({kind:'macro_snapshot',ref:{snapshot_id:snapshotId}},db,item.asOf,item.observedAt);
 if(snap.kind!=='macro_snapshot')throw new Error(`buildInput returned ${snap.kind} for a macro_snapshot ref`);
 const s=snap.snapshot;
 if(s.region!==item.subject.key||s.as_of!==item.asOf)return abstain('binding_mismatch');
 // A foreign upstream version is not computed on; the snapshot alone is frozen so the abstention stays findable by snapshot_id.
 if(s.methodology_version!==MACRO_UPSTREAM_VERSION||s.catalog_version!==macroRegimeV1.params.catalog_version)return [snap];
 const inputs:Input[]=[snap];
 for(const id of s.observation_ids){
  const o=await db.macro.observation(id);   // locator lookup only; every frozen value comes from buildInput
  if(!o)return abstain('observation_missing',[id]);
  inputs.push(await buildInput({kind:'macro_observation',ref:{series_id:o.series_id,period_end:o.period_end,vintage_id:o.vintage_id}},db,item.asOf,item.observedAt));
 }
 return inputs;
}

async function resolveTarget(item:WorkItem):Promise<Target>{
 return {kind:'period',period:addMonthsPeriod(item.asOf.slice(0,7),3)};
}

function compute(subject:Subject,inputs:Input[]):Active<CategoricalClaim>|Abstained{
 const s=snapshotOf(inputs);
 if(!s)return abstain('input_missing',['macro_snapshot']);
 if(s.methodology_version!==MACRO_UPSTREAM_VERSION||s.catalog_version!==macroRegimeV1.params.catalog_version)return abstain('upstream_version_mismatch');
 if(s.region!==subject.key)return abstain('binding_mismatch');
 if(!MACRO_REGIMES.every(r=>Number.isFinite(s.scores?.[r])&&Number.isFinite(s.norm?.[r])&&s.norm[r]>=0)
  ||Math.abs(MACRO_REGIMES.reduce((sum,r)=>sum+s.norm[r],0)-1)>5e-6
  ||s.primary_state===null||s.secondary_state===null
  ||!MACRO_REGIMES.includes(s.primary_state)||!MACRO_REGIMES.includes(s.secondary_state)||s.primary_state===s.secondary_state
  ||!Number.isFinite(s.margin_pp))return abstain('invalid_snapshot');
 if(s.coverage<MIN_COVERAGE)return abstain('coverage_below_threshold');
 if(inputs.filter(i=>i.kind==='macro_observation').length!==s.observation_ids.length)return abstain('observation_missing');
 const margin=marginPp(s.norm,s.primary_state,s.secondary_state);
 if(s.margin_pp!==null&&Math.abs(s.margin_pp-margin)>MARGIN_UNIT_TOLERANCE_PP)return abstain('margin_unit_mismatch');
 return {abstained:false,claim:{selected:s.primary_state,classes:[...MACRO_REGIMES],distribution:Object.fromEntries(MACRO_REGIMES.map(r=>[r,s.norm[r]])),
  scores_are_not_probabilities:true,margin_pp:margin,catalog_version:s.catalog_version}};
}

function condition(subject:Subject,inputs:Input[],claim:CategoricalClaim):Condition{
 const s=snapshotOf(inputs);
 if(!s)throw new Error('macro_regime@v1 condition() needs the macro_snapshot input');
 const period=s.as_of.slice(0,7);const sel=claim.selected as Regime;
 return {resolver:'macro_regime_replay',
  params:{region:s.region,reference_period:period,macro_methodology_version:MACRO_UPSTREAM_VERSION,catalog_version:s.catalog_version},
  predicate:{op:'eq',rhs:sel},
  text:{zh:`${s.region} ${period} 当期象限为“${ZH[sel]}”（同一分类函数在截止 vintage 下对同一参考期重算）`,
   en:`${s.region} ${period} regime is "${sel}" (same classifier re-run for the same reference month on the cutoff vintage)`}};
}

export const macroRegimeV1:Methodology<CategoricalClaim>={
 id:'macro_regime',version:'v1',judgment_type:'macro_regime',kind:'categorical',producer_kind:'rule',
 subject_types:['macro_region'],input_kinds:['macro_snapshot','macro_observation'],
 upstream:{macro_methodology_version:MACRO_UPSTREAM_VERSION},
 title:{zh:'宏观象限（当期 nowcast）',en:'Macro regime (current-period nowcast)'},
 doc:'docs/methodologies/macro_regime/v1.md',
 params:{grace_days:30,threshold_n:100,ece_max:0.1,window_years:3,embargo_days:0,label_policy:'cutoff_vintage',catalog_version:'macro-catalog/30bcaa2a33c5'},
 horizon:{unit:'calendar_months',n:3},
 deps:['src/lib/judgments/resolvers/macro.ts','src/lib/macro/read-api.ts','src/lib/macro/flags.ts','src/lib/macro/snapshots.ts','src/lib/macro/freshness.ts','src/lib/macro/db.ts','src/lib/dq/freshness.ts'],
 module:'src/lib/judgments/methodologies/macro-regime.v1.ts',
 status:'active',
 gather,resolveTarget,compute,condition,
};
// src/lib/judgments/methodology-sync.ts
// Core of scripts/judgments/sync-methodologies.ts (spec §4.1, §5.1 / §5.1b, §8.2). For each registry
// module: validate, hash (formula-hash.ts), compare with judgment_methodologies, and plan one action —
// register (new row), update (status / publishable changed), resync (unchanged; the RPC only bumps
// synced_at), drift (formula_hash or any immutable column differs from the stored row: the code or
// document changed without a new version — refused) or invalid (validation problems — refused). If
// any item is drift / invalid nothing is written and the script exits 2 (spec §13 formula_hash_drift).
// publishable becomes true only through --publishable <id@version> with an owner confirmation text
// (≥ 10 chars), recorded as the event reason, AND every origin key reachable from the method's
// input_kinds confirmed in docs/methodologies/licenses.json (commander decision D3: licences live
// outside every import closure; the script reads the file and passes it as o.licenses); without a
// flag the stored value is kept and a new method starts false (spec §4.1, §17). publishable is a
// metadata column: it never changes formula_hash. Validation: id / version patterns, public producer / subject / input
// kinds, markets ⊆ {A, HK, US}, label_policy, grace_days, horizon.n, window_years × 365 ≥ 3 × the
// horizon's calendar-day upper bound (§8.2; trading sessions × 1.52 as in §7.3, months × 31, quarters
// × 92), module / doc / deps exist, and no deps entry is already in the import closure (deps lists only
// what the import graph cannot see). Node-only (uses formula-hash.ts).
import {existsSync} from 'node:fs';
import {join,resolve} from 'node:path';
import type {Horizon,JudgmentsDb,Methodology,MethodologyRow} from './types';
import {PUBLIC_INPUT_KINDS,PUBLIC_PRODUCER_KINDS,PUBLIC_SUBJECT_TYPES} from './types';
import {canonicalize} from './canonical';
import {JudgmentError} from './errors';
import {formulaHashOf} from './formula-hash';
import type {FormulaHashes} from './formula-hash';
import {methodologyRowOf} from './registry';
import type {MethodologySyncRow} from './registry';
import {ORIGINS} from './origins';
import {labelPolicyOf} from './target';
import {graceDaysOf} from './time';

export type SyncAction='register'|'update'|'resync'|'drift'|'invalid';
export interface SyncPlanItem{key:string;action:SyncAction;problems:string[];row:MethodologySyncRow|null;existing:MethodologyRow|null;closure:string[];reason:string|null}
export const LICENSES_PATH='docs/methodologies/licenses.json';
export interface LicenseEntry{status:'unverified'|'confirmed';confirmed_by:string|null;confirmed_at:string|null;evidence:string|null}
export type LicenseTable=Readonly<Record<string,LicenseEntry>>;
export interface SyncOptions{repoRoot:string;codeVersion:string;only?:ReadonlySet<string>;publish?:ReadonlySet<string>;unpublish?:ReadonlySet<string>;ownerConfirmation?:string;licenses?:LicenseTable}
export const methodologyKey=(m:{id:string;version:string})=>`${m.id}@${m.version}`;
/** licenses.json: exactly the ORIGINS keys, each {status, confirmed_by, confirmed_at, evidence}; a confirmed row names who, when and the evidence. */
export function validateLicenseTable(raw:unknown):LicenseTable{
 const bad=(why:string):never=>{throw new JudgmentError('invalid_parameter',`${LICENSES_PATH}: ${why}`);};
 if(raw===null||typeof raw!=='object'||Array.isArray(raw))return bad('not an object');
 const t=raw as Record<string,unknown>;
 for(const k of Object.keys(ORIGINS))if(!(k in t))bad(`missing ${k}`);
 for(const [k,v] of Object.entries(t)){
  if(!(k in ORIGINS))bad(`unknown origin key ${k}`);
  const e=v as Record<string,unknown>|null;
  if(!e||typeof e!=='object'||Object.keys(e).sort().join(',')!=='confirmed_at,confirmed_by,evidence,status')bad(`${k}: fields must be status, confirmed_by, confirmed_at, evidence`);
  if(e!.status!=='unverified'&&e!.status!=='confirmed')bad(`${k}: status`);
  const str=(x:unknown)=>typeof x==='string'&&x.trim().length>0;
  if(e!.status==='confirmed'&&!(str(e!.confirmed_by)&&str(e!.confirmed_at)&&str(e!.evidence)))bad(`${k}: a confirmed licence needs confirmed_by, confirmed_at and evidence`);
 }
 return t as unknown as LicenseTable;
}
export const reachableOriginKeys=(m:Pick<Methodology,'input_kinds'>):string[]=>Object.keys(ORIGINS).filter(k=>(m.input_kinds as readonly string[]).includes(k.split('×')[0])).sort();
export const licenseProblems=(m:Pick<Methodology,'input_kinds'>,licenses:LicenseTable):string[]=>reachableOriginKeys(m).filter(k=>licenses[k]?.status!=='confirmed').map(k=>`license_unconfirmed:${k}`);
const IMMUTABLE=['judgment_type','kind','producer_kind','subject_types','input_kinds','markets','title_zh','title_en','doc_path','doc_sha256','implementation_sha256','params','params_json','horizon','upstream','deps_sha256'] as const;
export function horizonCalendarDays(h:Horizon):number{
 switch(h.unit){
  case 'trading_sessions':return Math.ceil(h.n*1.52);
  case 'calendar_days':return h.n;
  case 'calendar_months':return h.n*31;
  case 'fiscal_quarters':return h.n*92;
  default:return Number.NaN;
 }
}
const sameFile=(root:string,a:string,b:string)=>resolve(root,a)===resolve(root,b);
export function validateMethodology(m:Methodology,repoRoot:string,closure:readonly string[]=[]):string[]{
 const p:string[]=[];
 if(!/^[a-z][a-z0-9_]{1,63}$/.test(m.id))p.push('id_pattern');
 if(!/^v[1-9][0-9]{0,3}$/.test(m.version))p.push('version_pattern');
 if(!(PUBLIC_PRODUCER_KINDS as readonly string[]).includes(m.producer_kind))p.push(`producer_kind_not_public:${m.producer_kind}`);
 if(m.subject_types.length===0)p.push('subject_types_empty');
 for(const s of m.subject_types)if(!(PUBLIC_SUBJECT_TYPES as readonly string[]).includes(s))p.push(`subject_type_not_public:${s}`);
 if(m.input_kinds.length===0)p.push('input_kinds_empty');
 for(const k of m.input_kinds)if(!(PUBLIC_INPUT_KINDS as readonly string[]).includes(k))p.push(`input_kind_not_public:${k}`);
 for(const mk of m.markets??[])if(!['A','HK','US'].includes(mk))p.push(`market:${mk}`);
 try{labelPolicyOf(m.params);}catch{p.push('label_policy');}
 try{graceDaysOf(m.params,m.horizon);}catch{p.push('grace_days');}
 const unitOk=(['trading_sessions','calendar_days','calendar_months','fiscal_quarters'] as const).includes(m.horizon.unit);
 // n is a positive integer; calendar_months alone allows 0 (the as_of month, target.ts)
 const horizonOk=unitOk&&Number.isInteger(m.horizon.n)&&Number.isFinite(m.horizon.n)&&m.horizon.n>=(m.horizon.unit==='calendar_months'?0:1)&&Number.isFinite(horizonCalendarDays(m.horizon));
 if(!horizonOk)p.push('invalid_horizon');
 const wy=m.params.window_years??3;
 if(typeof wy!=='number'||!(wy>0))p.push('window_years');
 else if(horizonOk&&wy*365<3*horizonCalendarDays(m.horizon))p.push(`window_years_too_short:${wy}y<3x${horizonCalendarDays(m.horizon)}d`);
 if(!existsSync(join(repoRoot,m.module)))p.push(`module_missing:${m.module}`);
 if(!existsSync(join(repoRoot,m.doc)))p.push(`doc_missing:${m.doc}`);
 for(const d of m.deps){if(!existsSync(join(repoRoot,d)))p.push(`dep_missing:${d}`);if(closure.includes(d))p.push(`dep_in_import_closure:${d}`);if(sameFile(repoRoot,d,LICENSES_PATH)){p.push('licenses_in_deps');if(!p.includes('licenses_in_closure'))p.push('licenses_in_closure');}}
 if(closure.some(c=>sameFile(repoRoot,c,LICENSES_PATH))&&!p.includes('licenses_in_closure'))p.push('licenses_in_closure');
 return p;
}
export async function planMethodologySync(registry:readonly Methodology[],db:Pick<JudgmentsDb,'methodology'>,o:SyncOptions,hash:(m:Methodology,root:string)=>FormulaHashes=formulaHashOf):Promise<SyncPlanItem[]>{
 const seen=new Set<string>();const out:SyncPlanItem[]=[];
 for(const m of registry){
  const key=methodologyKey(m);
  if(o.only&&!o.only.has(key))continue;
  const problems:string[]=[];
  if(seen.has(key))problems.push('duplicate_in_registry');
  seen.add(key);
  const publish=o.publish?.has(key)===true,unpublish=o.unpublish?.has(key)===true;
  if(publish&&unpublish)problems.push('publish_and_unpublish');
  const confirmation=(o.ownerConfirmation??'').trim();
  if(publish&&confirmation.length<10)problems.push('owner_confirmation_required');
  const existing=await db.methodology(m.id,m.version);
  const wantPublishable=publish?true:unpublish?false:(existing?.publishable??false);
  const unlicensed=wantPublishable?licenseProblems(m,o.licenses??{}):[];
  let withdrawn=false;
  if(unlicensed.length>0){
   if(publish){if(confirmation.length>=10)problems.push(...unlicensed);}   // reported once the confirmation text is present
   else withdrawn=true;                                                    // already published, licence no longer confirmed
  }
  let h:FormulaHashes|null=null;
  try{h=hash(m,o.repoRoot);}catch(e){problems.push(`hash:${e instanceof Error?e.message:String(e)}`);}
  problems.push(...validateMethodology(m,o.repoRoot,h?.closure??[]));
  const publishable=withdrawn?false:wantPublishable;
  const row=h?methodologyRowOf(m,h,{publishable,code_version:o.codeVersion}):null;
  const reason=publish?`owner_confirmed:${confirmation}`:unpublish?'unpublished_by_script':withdrawn?'license_withdrawn':null;
  let action:SyncAction;
  if(problems.length>0||!row)action='invalid';
  else if(!existing)action='register';
  else{
   const changed=IMMUTABLE.filter(c=>canonicalize(existing[c]??null)!==canonicalize(row[c]??null));
   if(existing.formula_hash!==row.formula_hash||changed.length>0){action='drift';if(changed.length>0&&existing.formula_hash===row.formula_hash)problems.push(`immutable_columns_changed:${changed.join(',')}`);}
   else action=existing.status!==row.status||existing.publishable!==row.publishable?'update':'resync';
  }
  out.push({key,action,problems,row,existing,closure:h?.closure??[],reason});
 }
 return out;
}
export const planExitCode=(plan:readonly SyncPlanItem[]):0|2=>plan.some(p=>p.action==='drift'||p.action==='invalid')?2:0;
export async function applyMethodologySync(plan:readonly SyncPlanItem[],db:Pick<JudgmentsDb,'syncMethodology'>):Promise<{key:string;changed:boolean;seq:number}[]>{
 if(planExitCode(plan)!==0)throw new JudgmentError('formula_hash_drift','refusing to sync: the plan contains drift or invalid items');
 const out:{key:string;changed:boolean;seq:number}[]=[];
 for(const p of plan){const r=await db.syncMethodology(p.row!,'script',p.reason);out.push({key:p.key,...r});}
 return out;
}
// src/lib/judgments/registry.ts
// The methodology registry (spec §4). REGISTRY lists every method module the system may register
// judgments with; Task 19 appends macroRegimeV1. Test-only methods (testing/*, e.g.
// synthetic_fact_metric@v1) are never listed. judgment_methodologies mirrors REGISTRY through
// scripts/judgments/sync-methodologies.ts; methodologyRowOf maps a module + its hashes (formula-hash.ts)
// to the row sync_methodology writes. No fs / typescript imports here: app code may import this file.
import type {Methodology,MethodologyRow} from './types';

import {macroRegimeV1} from './methodologies/macro-regime.v1';

export const REGISTRY:readonly Methodology[]=[macroRegimeV1];
export interface MethodologyHashes{doc_sha256:string;implementation_sha256:string;deps_sha256:string;formula_hash:string}
export type MethodologySyncRow=Omit<MethodologyRow,'created_at'|'synced_at'>;
export function upstreamOf(m:Pick<Methodology,'upstream'>):Record<string,string>{
 return Object.fromEntries(Object.entries(m.upstream??{}).filter((e):e is [string,string]=>typeof e[1]==='string'));
}
