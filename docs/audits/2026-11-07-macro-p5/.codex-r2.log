 if(s.prev3m){
  if(type==='fx')d3=Number(s.prev3m.value_text)===0?null:Number(yoyPct(s.latest.value_text,s.prev3m.value_text));
  else d3=Number(subtract(s.latest.value_text,s.prev3m.value_text));
 }
