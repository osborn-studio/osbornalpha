            {openDisplay.reason ? <p className="text-xs text-text-dim">{openDisplay.reason}</p> : null}
            <p className="text-[11px] text-text-dim">{t('flow.formulaNote')}</p>
            <ObsRefTable refs={open.inputs} />
          </div>
        ) : null}
      </EvidencePairDrawer>
    </Panel>
  );
}

