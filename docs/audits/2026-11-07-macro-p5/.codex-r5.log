export interface IngestDeps{db:MacroDb;evidence:Pick<EvidenceStore,'put'>;tables:TableClient;codeVersion:string;now:()=>Date}
/** An adapter's own reading of one value (AKShare DataFrame), already mapped to period_end; cross-check only. */
export interface Claim{series_id:string;period_end:string;value_text:string}
export interface RetrievalInput{evidence:EvidenceInput;parsed:ParsedPoint[];claims?:Claim[]}
/** usable (第 6 稿 P2-1): inserted + versioned + duplicates minus previously_rejected — rows that are data; counts stay the six DQ counters. */
export interface IngestReceipt{counts:ChunkCounts;usable:number;errors:BatchError[];retrievalIds:string[]}
/** A protocol abort that must stop the request, never a counted data failure (第 5 稿): `fenced` — the run's owner token was
 *  superseded by a takeover (P1-3); `quarantine_link_failed` — a stored quarantined row could not be bound to an open item
 *  (P2-3). The ingest route answers 409 fenced / 500 without completing the chunk; cron closes its batch failed. */
export class IngestAbort extends Error{
 /** partial (四轮 P2-2): committed outcomes of the aborted call, attached by ingestEvidence / deriveAndWrite on the way out. */
 constructor(readonly code:'fenced'|'quarantine_link_failed',readonly key?:string,readonly partial?:IngestReceipt){super(key===undefined?code:`${code}:${key}`);this.name='IngestAbort';}
}
/** The batch error for an abort (callers push it once; partial.errors never contains it). */
export const abortError=(e:IngestAbort):BatchError=>e.key===undefined?{code:e.code}:{code:e.code,key:e.key};
const isFenced=(e:unknown)=>e instanceof MacroDbError&&e.code==='fenced';

export const DATASET_OF:Record<Adapter,'macro.fred'|'macro.akshare'>={fred_csv:'macro.fred',akshare:'macro.akshare'};
export const DATASET_OF_REGION:Record<Region,'macro.fred'|'macro.akshare'>={US:'macro.fred',CN:'macro.akshare'};
export const WRITE_CHUNK=1000;
/** Input periods read per derived series (complete history; daily inputs since 2000 are ≈ 7 000). */
export const DERIVE_MAX_ROWS=20000;
/** Conflicts that park the row in dq_quarantine; missing_evidence / missing_input are failures instead. */
const QUARANTINE_REASONS:readonly WriteConflictReason[]=['unexpected_revision','conflicting_rows','stale_delivery'];
const TABLE='macro_observations';

export const emptyChunkCounts=():ChunkCounts=>({fetched:0,inserted:0,duplicates:0,versioned:0,quarantined:0,failed:0});
export function addCounts(a:ChunkCounts,b:ChunkCounts):ChunkCounts{
 return {fetched:a.fetched+b.fetched,inserted:a.inserted+b.inserted,duplicates:a.duplicates+b.duplicates,versioned:a.versioned+b.versioned,quarantined:a.quarantined+b.quarantined,failed:a.failed+b.failed};
}
const keyOf=(seriesId:string,periodEnd:string)=>`${seriesId}|${periodEnd}`;

/** finishBatch's limits (src/lib/dq/batches.ts, private capErrors): macro_finalize_batch stores errors as given, so they are capped here. */
export const MAX_BATCH_ERRORS=100,MAX_ERROR_MESSAGE=500;
export function capBatchErrors(errors:readonly BatchError[]):BatchError[]{
 const kept=errors.slice(0,MAX_BATCH_ERRORS).map(e=>e.message!==undefined&&e.message.length>MAX_ERROR_MESSAGE?{...e,message:e.message.slice(0,MAX_ERROR_MESSAGE)}:e);
 return errors.length>MAX_BATCH_ERRORS?[...kept,{code:'truncated',message:`${errors.length-MAX_BATCH_ERRORS} more`}]:kept;
}
/**
 * The FinalizeInput finishBatch would write (第 6 稿 P1-1/P2-4): status from batchStatusFromCounts unless `force` (a fatal
 * abort passes 'failed', so native rows already written never make the batch 'partial'), the unaccounted marker finishBatch
 * prepends, errors capped like finishBatch. Throws invalid_now / invalid_counts like finishBatch.
 */
export function batchFinalizeInput(result:{counts:ChunkCounts;errors:BatchError[];rejected?:boolean},now:Date,force?:FinalStatus):FinalizeInput{
 const computed=batchStatusFromCounts(result.counts,result.errors,{rejected:result.rejected});
 if(!(now instanceof Date)||!Number.isFinite(now.getTime()))throw new Error('invalid_now');
 if(computed==='running')throw new Error('invalid_status');
 const c=result.counts;
 const unaccounted=!result.rejected&&c.fetched>0&&c.inserted+c.duplicates+c.versioned+c.quarantined+c.failed===0;
 return {status:force??computed,counts:{...c},errors:capBatchErrors(unaccounted?[UNACCOUNTED_ERROR,...result.errors]:result.errors),finishedAt:now.toISOString()};
}

/**
 * Splits rows into calls of about `size` rows without ever separating one (series_id, period_end) group,
 * so a duplicated period in one evidence is always judged inside one RPC call (conflicting_rows).
 */
export function chunkWrites<T extends {series_id:string;period_end:string}>(rows:readonly T[],size=WRITE_CHUNK):T[][]{
 const sorted=[...rows].sort((a,b)=>a.series_id<b.series_id?-1:a.series_id>b.series_id?1:a.period_end<b.period_end?-1:a.period_end>b.period_end?1:0);
 const out:T[][]=[];let cur:T[]=[];
 for(const r of sorted){
  const last=cur[cur.length-1];
  if(cur.length>=size&&last&&keyOf(last.series_id,last.period_end)!==keyOf(r.series_id,r.period_end)){out.push(cur);cur=[];}
  cur.push(r);
 }
 if(cur.length)out.push(cur);
 return out;
}

/** unit (四轮 P2-2): the retrieval / derived series in progress — its size and the outcome total when it began. */
interface Ctx{deps:IngestDeps;dataset:string;batchId:string;ownerToken:string|null;counts:ChunkCounts;usable:number;errors:BatchError[];unit:{size:number;base:number}|null}
const outcomesOf=(c:ChunkCounts)=>c.inserted+c.duplicates+c.versioned+c.quarantined+c.failed;
const beginUnit=(ctx:Ctx,n:number)=>{ctx.counts.fetched+=n;ctx.unit={size:n,base:outcomesOf(ctx.counts)};};
/** Committed outcomes so far: fetched leaves out the aborted unit's points that never got an outcome. */
function partialOf(ctx:Ctx,retrievalIds:readonly string[]):IngestReceipt{
 const unanswered=ctx.unit?Math.max(0,ctx.unit.size-(outcomesOf(ctx.counts)-ctx.unit.base)):0;
 return {counts:{...ctx.counts,fetched:ctx.counts.fetched-unanswered},usable:ctx.usable,errors:[...ctx.errors],retrievalIds:[...retrievalIds]};
}
/** Runs the body; an IngestAbort leaves with the partial receipt attached (四轮 P2-2). */
async function withPartial(ctx:Ctx,retrievalIds:readonly string[],body:()=>Promise<void>):Promise<void>{
 try{await body();}
 catch(e){if(e instanceof IngestAbort&&!e.partial)throw new IngestAbort(e.code,e.key,partialOf(ctx,retrievalIds));throw e;}
}

/** quarantine() that never aborts the batch: a failed insert into dq_quarantine is a failed row. Returns the (possibly
 *  reused) item id when parked, else null. */
async function park(ctx:Ctx,naturalKey:string,reasonCode:string,detail:Record<string,unknown>,payload:Record<string,unknown>):Promise<string|null>{
 try{
  return await quarantine(ctx.deps.tables,{dataset:ctx.dataset,table:TABLE,naturalKey,reasonCode,detail,payload,batchId:ctx.batchId});
 }catch{
  ctx.errors.push({code:'quarantine_failed',key:naturalKey});
  return null;
 }
}
/** Binds the stored quarantined row to its dq_quarantine item (macro_link_quarantine; 第 4 稿 P1-4, 第 5 稿 P2-3). The SQL
 *  locks the item row. A closed item whose exact member (this row) its resolution already accepted / rejected returns 0: the
 *  link is complete (第 6 稿 P2-3). quarantine_closed = the row is still quarantined but a resolution closed the item after
 *  quarantine() returned it → park again (quarantine() now opens a NEW item, the old one is no longer open) and link once
 *  more. Anything else, or a second failure, aborts: a quarantined row must never stay unbound. */
async function link(ctx:Ctx,itemId:string,observationId:string,naturalKey:string,repark:()=>Promise<string|null>):Promise<void>{
 const fence={batchId:ctx.batchId,ownerToken:ctx.ownerToken};
 try{await ctx.deps.db.linkQuarantine(itemId,[observationId],fence);return;}
 catch(e){
  if(isFenced(e))throw new IngestAbort('fenced',naturalKey);
  if(!(e instanceof MacroDbError&&e.code==='quarantine_closed'))throw new IngestAbort('quarantine_link_failed',naturalKey);
 }
 const again=await repark();
 if(!again)throw new IngestAbort('quarantine_link_failed',naturalKey);
 try{await ctx.deps.db.linkQuarantine(again,[observationId],fence);}
 catch(e){throw new IngestAbort(isFenced(e)?'fenced':'quarantine_link_failed',naturalKey);}
}

async function writeAll(ctx:Ctx,rows:ObservationWrite[]):Promise<void>{
 for(const chunk of chunkWrites(rows)){
  let res:WriteResult;
  try{res=await ctx.deps.db.writeObservations(ctx.batchId,ctx.deps.codeVersion,chunk,ctx.ownerToken);}
  catch(e){
   if(isFenced(e))throw new IngestAbort('fenced',chunk[0].series_id);
   ctx.counts.failed+=chunk.length;
   ctx.errors.push({code:e instanceof MacroDbError?`write_${e.code}`:'write_failed',key:chunk[0].series_id});
   continue;
  }
  ctx.counts.inserted+=res.inserted;ctx.counts.duplicates+=res.duplicates;ctx.counts.versioned+=res.versioned;ctx.counts.quarantined+=res.quarantined;
  ctx.usable+=res.inserted+res.duplicates+res.versioned-res.conflicts.filter(c=>c.reason==='previously_rejected').length;   // 第 6 稿 P2-1
  for(const c of res.conflicts){
   const key=keyOf(c.series_id,c.period_end);
   if(c.reason==='previously_rejected')continue;   // informational: the RPC counted it as a duplicate; a rejected value is final (第 5 稿 P1-2)
   if(QUARANTINE_REASONS.includes(c.reason)){
    // The RPC already stored the row as quarantined (and counted it). conflicting_rows stores nothing (observation_id null):
    // a failed park only adds an error. A stored row must end up bound to an open item, else the request aborts (P2-3).
    const repark=()=>park(ctx,key,c.reason,{value_text:c.value_text,current_value_text:c.current_value_text},{value_text:c.value_text});
    const itemId=await repark();
    if(c.observation_id){
     if(!itemId)throw new IngestAbort('quarantine_link_failed',key);
     await link(ctx,itemId,c.observation_id,key,repark);
    }
   }else{
    ctx.counts.failed+=1;ctx.errors.push({code:c.reason,key});
   }
  }
 }
}

const collectable=(def:MacroSeriesDef|undefined,adapter:Adapter):def is MacroSeriesDef=>
 !!def&&def.status==='active'&&!def.derive&&!def.aliasOf&&def.source?.adapter===adapter;

/** ownerToken: the AKShare run's token (第 5 稿 P1-3); omitted / null for cron (its batch has no run row). */
export async function ingestEvidence(deps:IngestDeps,input:{batchId:string;adapter:Adapter;retrievals:RetrievalInput[];ownerToken?:string|null}):Promise<IngestReceipt>{
 const ctx:Ctx={deps,dataset:DATASET_OF[input.adapter],batchId:input.batchId,ownerToken:input.ownerToken??null,counts:emptyChunkCounts(),usable:0,errors:[],unit:null};
 const retrievalIds:string[]=[];
 await withPartial(ctx,retrievalIds,async()=>{
 for(const r of input.retrievals){
  const e=r.evidence,n=r.parsed.length;
  const label=[...new Set(r.parsed.map(p=>p.seriesId))].join(',')||e.fetchUrl.slice(0,120);
  beginUnit(ctx,n);
  if(e.adapter!==input.adapter){ctx.counts.failed+=n;ctx.errors.push({code:'evidence_adapter_mismatch',key:label});continue;}
  let objectPath:string;
  try{({objectPath}=await deps.evidence.put(e));}
  catch{ctx.counts.failed+=n;ctx.errors.push({code:'evidence_upload_failed',key:label});continue;}
  let retrievalId:string;
  try{
   retrievalId=await deps.db.putRetrieval(
    {sha256:e.sha256,object_path:objectPath,adapter:e.adapter,content_type:e.contentType,byte_length:e.bytes.byteLength},
    {fetch_url:e.fetchUrl,fetch_host:e.fetchHost,http_status:e.httpStatus,fetched_at:e.fetchedAt,batch_id:input.batchId,tool_versions:e.toolVersions},ctx.ownerToken);
  }catch(x){
   if(isFenced(x))throw new IngestAbort('fenced',label);
   ctx.counts.failed+=n;ctx.errors.push({code:'retrieval_failed',key:label});continue;
  }
  retrievalIds.push(retrievalId);
  const claims=new Map<string,string[]>();
  for(const c of r.claims??[]){const k=keyOf(c.series_id,c.period_end);claims.set(k,[...(claims.get(k)??[]),c.value_text]);}
  const bySeries=new Map<string,ParsedPoint[]>();
  for(const p of r.parsed)bySeries.set(p.seriesId,[...(bySeries.get(p.seriesId)??[]),p]);
  const writes:ObservationWrite[]=[];
  for(const [seriesId,points] of bySeries){
   const def=catalogById(seriesId);
   if(!collectable(def,input.adapter)){ctx.counts.failed+=points.length;ctx.errors.push({code:'unknown_series',key:seriesId});continue;}
   // 第 7 稿 T6-1: distinct canonical values for one period across ALL points, judged before quality / claim filtering —
   // the whole group is quarantined (conflicting_rows), none of it is written or used as the jump baseline.
   const seen=new Map<string,Set<string>>();
   for(const p of points){let c:string;try{c=canonical(p.valueText);}catch{continue;}seen.set(p.periodEnd,(seen.get(p.periodEnd)??new Set<string>()).add(c));}
   const conflicting=new Set<string>();
   for(const [periodEnd,vals] of seen){
    if(vals.size<2)continue;
    conflicting.add(periodEnd);
    const valueTexts=[...vals].sort();
    if(await park(ctx,keyOf(seriesId,periodEnd),'conflicting_rows',{value_texts:valueTexts},{value_texts:valueTexts})!==null)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
   }
   let prev:string|null=null;
   for(const p of [...points].sort((a,b)=>a.periodEnd<b.periodEnd?-1:a.periodEnd>b.periodEnd?1:0)){
    const key=keyOf(seriesId,p.periodEnd);
    if(conflicting.has(p.periodEnd))continue;
    let value:string;
    try{value=canonical(p.valueText);}catch{ctx.counts.failed+=1;ctx.errors.push({code:'invalid_value',key});continue;}
    const payload={value_text:value,retrieval_id:retrievalId,locator:p.locator};
    const q=validatePoint(def,value,prev);
    if(!q.passed){
     let parked=false;
     for(const f of q.failed)parked=(await park(ctx,key,`rule_failed:${f.ruleId}`,{...(f.detail??{}),rules_version:q.version},payload))!==null||parked;
     if(parked)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
     continue;
    }
    const claimed=claims.get(key);
    if(claimed&&claimed.some(c=>{try{return !equals(c,value);}catch{return true;}})){
     if(await park(ctx,key,'adapter_mismatch',{value_text:value,claim_value_texts:claimed},payload)!==null)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
     continue;
    }
    prev=value;
    writes.push({series_id:seriesId,period_end:p.periodEnd,value_text:value,available_at:e.fetchedAt,revisable:def.revisionPolicy==='revisable',retrieval_id:retrievalId,locator:p.locator});
   }
  }
  await writeAll(ctx,writes);
  ctx.unit=null;
 }
 });
 return {counts:ctx.counts,usable:ctx.usable,errors:ctx.errors,retrievalIds};
}

/** Derived series of a region whose input is native come first, so a derived input is written before its dependants. */
export function derivedOf(region:Region):MacroSeriesDef[]{
 const defs=MACRO_CATALOG.filter(d=>d.region===region&&d.status==='active'&&d.derive);
 const depth=(d:MacroSeriesDef,seen=0):number=>{const input=d.derive?catalogById(d.derive.from):undefined;return input?.derive&&seen<8?1+depth(input,seen+1):0;};
 return [...defs].sort((a,b)=>depth(a)-depth(b));
}

/**
 * Recomputes every derived series of `region` from the inputs' COMPLETE eligible history (plus rows of the open batch
 * `batchId`) and writes it in that batch (spec §0.2 N3; 第 4 稿 P1-5/P1-7). No window: a revised input three years
 * back must reach its derived period and, for yoy, period + 12; unchanged rows return as duplicates.
 */
export async function deriveAndWrite(deps:IngestDeps,region:Region,batchId:string,ownerToken:string|null=null):Promise<IngestReceipt>{
 const ctx:Ctx={deps,dataset:DATASET_OF_REGION[region],batchId,ownerToken,counts:emptyChunkCounts(),usable:0,errors:[],unit:null};
 const now=deps.now();
 await withPartial(ctx,[],async()=>{
 for(const def of derivedOf(region)){
  const input=catalogById(def.derive!.from);
  if(!input){ctx.errors.push({code:'missing_derive_input',key:def.id});continue;}
  let history:ObservationRow[];
  try{history=await deps.db.eligibleHistory(input.id,{includeBatch:batchId,maxRows:DERIVE_MAX_ROWS});}
  catch(e){ctx.errors.push({code:e instanceof MacroDbError?`history_${e.code}`:'history_failed',key:def.id});continue;}
  let writes:ObservationWrite[];
  try{writes=deriveSeries(def,history,{now});}
  catch{ctx.errors.push({code:'derive_failed',key:def.id});continue;}
  beginUnit(ctx,writes.length);
  await writeAll(ctx,writes);
  ctx.unit=null;
 }
 });
 return {counts:ctx.counts,usable:ctx.usable,errors:ctx.errors,retrievalIds:[]};
}
// src/app/api/macro/ingest/route.ts
// AKShare ingest endpoint (spec §4.4, §8, §11; §0.2 M9/M24/N2/N3; plan 第 4 稿 P1-6/P2-1/P2-2/P2-4; 第 5 稿 P1-3/P1-4/
// P1-5/P2-1/P2-2). Auth: MACRO_INGEST_SECRET bearer compared in constant time (authorizedCronRequest); unset secret → 503.
// Body ≤ 4 MB. Every chunk / finish carries the owner_token that start returned; every MacroDb mutation passes it, and a
// superseded token (takeover) answers 409 fenced — the collector then restarts the whole collection under a new batch.
//  start  → upserts the catalog mirror, starts batch producer 'py-akshare' / dataset 'macro.akshare', then takes the
//           single-writer lease atomically (claimIngest: 2 h max age, 10 min processing timeout, takeover only when the
//           body asks): runs it aborted whose batch still runs finish failed ('aborted'); a live holder → our batch
//           finishes rejected ('concurrent_batch') and 409 batch_running; else {batch_id, owner_token}.
//  chunk  → every evidence item's bytes must hash to its sha256 (else 400 before any claim or write); then claimChunk:
//           only the claiming request ingests (a done repeat returns the stored receipt, a processing repeat → 409
//           chunk_in_progress). Evidence must come from the series' official host and data path with HTTP 200 and a
//           plausible fetched_at; the TS parser extracts the points — Python numbers are never stored; claims are
//           compared by decimal equality inside ingestEvidence. completeChunk stores counts, sanitized errors and the
//           claim / location key sets.
//  finish → beginFinish (owner only; all chunks done, else 409) hands out a finish token; resumable and exclusive via
//           finish_progress: CN derivation (N3; skipped when no usable native row landed, Σ native_usable = 0) →
//           MacroDb.finalizeBatch (fenced by owner + finish token, 第 6 稿 P1-1) with native chunk + derived counts, failed
//           series (series_outcomes), every stored error, the batch-wide unlocated-claims summary and no_native_outcomes →
//           MacroDb.recordFreshness('macro.akshare', daily, ok = status !== 'failed' && usable native rows; the upsert and the
//           freshness_recorded checkpoint in one fenced transaction) → the Task 11 publish step (publishRegion CN, keyed + fenced) → stored receipt (run
//           finished, lease released). A retry skips completed steps; a finished run returns its stored receipt. Only this
//           route publishes CN.
// Responses carry codes, keys and counts only.
import {createHash} from 'node:crypto';
import {NextResponse} from 'next/server';
import {emptyCounts,finishBatch,startBatch} from '@/lib/dq/batches';
import type {BatchError,BatchStatus} from '@/lib/dq/batches';
import type {Row} from '@/lib/db/table-client';
import {resolveCodeVersion} from '@/lib/facts/deps';
import {authorizedCronRequest} from '@/lib/observability/cron-auth';
import {CATALOG_VERSION,MACRO_CATALOG} from '@/lib/macro/catalog';
import {productionMacroDeps} from '@/lib/macro/deps';
import type {MacroDeps} from '@/lib/macro/deps';
import {MacroDbError} from '@/lib/macro/db';
import {IngestAbort,abortError,addCounts,batchFinalizeInput,deriveAndWrite,emptyChunkCounts,ingestEvidence} from '@/lib/macro/ingest';
import type {Claim,IngestReceipt,RetrievalInput} from '@/lib/macro/ingest';
import {MAX_BODY_BYTES,parseIngestBody} from '@/lib/macro/ingest-schema';
import type {IngestBody,SeriesOutcome} from '@/lib/macro/ingest-schema';
import {claimPeriodEnd,parserFor} from '@/lib/macro/parsers';
import {MACRO_RULES_VERSION} from '@/lib/macro/quality';
import {publishRegion} from '@/lib/macro/snapshots';
import type {ChunkCounts,ChunkError,ChunkRecord,EvidenceInput,FinishProgress,FinishStep,ParsedPoint} from '@/lib/macro/types';

export const dynamic='force-dynamic';
export const maxDuration=300;
const INGEST_ROUTE_VERSION='macro-ingest/1';
const DATASET='macro.akshare',PRODUCER='py-akshare';
const LEASE_MS=2*3600_000,PROCESSING_TIMEOUT_MS=10*60_000,MAX_FUTURE_MS=5*60_000,MAX_AGE_MS=24*3600_000;   // maxDuration (300 s) < processing timeout
const NO_STORE={'Cache-Control':'no-store'};
const json=(body:unknown,status=200)=>NextResponse.json(body,{status,headers:NO_STORE});
const err=(code:string,message:string,status:number,extra:Record<string,unknown>={})=>json({error:{code,message,...extra}},status);
/** Codes and keys only (messages may echo upstream text), except the skipped_summary INFO entry whose message is a count. */
const publicErrors=(errors:BatchError[])=>errors.map(e=>e.code==='skipped_summary'&&e.message?{code:e.code,key:e.key,message:e.message}:e.key===undefined?{code:e.code}:{code:e.code,key:e.key});
/** Stored chunk errors: code + key only, ≤ 500 per chunk (macro_complete_chunk limit). */
const storedErrors=(errors:BatchError[])=>errors.slice(0,500).map(e=>{
 const o:{code:string;key?:string;message?:string}={code:e.code};
 if(e.key!==undefined)o.key=e.key;
 if(e.code==='parse_failed'&&e.message)o.message=e.message.slice(0,500);   // T9-1: 'retrieval <id>: <parser code>' — an id and a code, never upstream text
 return o;
});

const fencedResponse=()=>err('fenced','This batch was taken over; restart the collection under a new batch',409);
/** The batch row; finishing:true also accepts a finished batch whose run is no longer open (a retried finish, P2-4). A batch
 *  whose run was aborted by a takeover answers fenced (第 5 稿 P1-3), so the collector restarts instead of giving up. */
async function batchRow(deps:MacroDeps,batchId:string,opts:{finishing?:boolean}={}):Promise<Row|NextResponse>{
 const [b]=await deps.tables.select('ingest_batches',{batch_id:batchId},{limit:1});
 if(!b||b.dataset!==DATASET||b.producer!==PRODUCER)return err('batch_not_found','Unknown batch',404);
 if(b.status!=='running'){
  const run=await deps.db.ingestRun(batchId);
  if(run?.state==='aborted')return fencedResponse();
  if(opts.finishing&&run&&run.state!=='open')return b;
  return err('batch_not_running','Batch is finished',409);
 }
 return b;
}
/** start's sweep of aborted / refused batches still uses the shared finishBatch; batch_not_running = finished elsewhere. */
const notRunning=(e:unknown)=>e instanceof Error&&e.message==='batch_not_running';

async function start(deps:MacroDeps,body:Extract<IngestBody,{action:'start'}>){
 await deps.db.upsertCatalog(MACRO_CATALOG,CATALOG_VERSION,MACRO_RULES_VERSION);
 const {batchId}=await startBatch(deps.tables,{producer:PRODUCER,dataset:DATASET,codeVersion:deps.codeVersion,triggeredBy:'script',
  toolVersions:{...body.tool_versions,ingest:INGEST_ROUTE_VERSION,catalog:CATALOG_VERSION,rules:MACRO_RULES_VERSION}});
 let claim:Awaited<ReturnType<MacroDeps['db']['claimIngest']>>;
 try{claim=await deps.db.claimIngest(batchId,DATASET,{maxAgeMs:LEASE_MS,processingTimeoutMs:PROCESSING_TIMEOUT_MS,takeover:body.takeover===true});}
 catch(e){
  // no orphan running batch: finalize the batch startBatch just created as failed (best effort, one retry, logged), then surface the error
  for(let attempt=0;attempt<2;attempt++){
   try{await finishBatch(deps.tables,batchId,{counts:emptyCounts(),errors:[{code:'claim_failed'}]});break;}
   catch(x){if(notRunning(x))break;if(attempt===1)console.error('[macro-ingest] finalizing the batch after a failed claim failed',batchId,x instanceof Error?x.message:x);}
  }
  throw e;
 }
 // Batches of aborted runs (第 5 稿 P1-3/P2-1): finish them failed. batch_not_running = finished elsewhere (idempotent); any other
 // failure is logged, never fatal here — claimIngest lists the batch again on the next start until it is finished.
 for(const id of claim.aborted){
  try{await finishBatch(deps.tables,id,{counts:emptyCounts(),errors:[{code:'aborted'}]});}
  catch(e){if(!notRunning(e))console.error('[macro-ingest] finishing aborted batch failed; retried on the next start',id,e instanceof Error?e.message:e);}
 }
 if(claim.status==='busy'){
  await finishBatch(deps.tables,batchId,{counts:emptyCounts(),errors:[{code:'concurrent_batch'}],rejected:true}).catch(()=>undefined);
  return err('batch_running','A macro.akshare batch is still running',409,{batch_id:claim.holder});
 }
 return json({batch_id:batchId,owner_token:claim.ownerToken});
}

const duplicateReceipt=(batchId:string,c:ChunkRecord)=>json({status:'duplicate',batch_id:batchId,seq:c.seq,counts:c.counts,errors:publicErrors(c.errors)});

async function chunk(deps:MacroDeps,body:Extract<IngestBody,{action:'chunk'}>){
 const b=await batchRow(deps,body.batch_id);
 if(b instanceof NextResponse)return b;
 const decoded=body.evidence.map(e=>({e,bytes:new Uint8Array(Buffer.from(e.bytes_b64,'base64'))}));
 for(const {e,bytes} of decoded)if(createHash('sha256').update(bytes).digest('hex')!==e.sha256)return err('sha256_mismatch','Evidence bytes do not match sha256',400,{series_id:e.series_id});
 const claim=await deps.db.claimChunk(body.batch_id,body.seq,body.total,body.owner_token);   // throws fenced / chunk_total_mismatch / batch_not_open
 if(claim.status==='processing')return err('chunk_in_progress','This chunk is being processed; retry later',409,{seq:body.seq});
 if(claim.status==='done')return duplicateReceipt(body.batch_id,claim.chunk);
 const batchTools=(b.tool_versions&&typeof b.tool_versions==='object'?b.tool_versions:{}) as Record<string,string>;
 const now=deps.now().getTime();
 let counts=emptyChunkCounts();const errors:BatchError[]=[];
 const retrievals:RetrievalInput[]=[];const located=new Set<string>();
 for(const {e,bytes} of decoded){
  const parser=parserFor(e.series_id);
  if(!parser){counts.failed+=1;errors.push({code:'unknown_series',key:e.series_id});continue;}
  let url:URL;
  try{url=new URL(e.url);}catch{counts.failed+=1;errors.push({code:'evidence_not_allowed',key:e.series_id});continue;}
  const fetched=Date.parse(e.fetched_at);
  // host (with port) must equal the allowed host exactly, and no userinfo
  if(url.host!==parser.spec.fetch_host||url.username!==''||url.password!==''||url.pathname!==parser.spec.evidence_path||e.status!==200){counts.failed+=1;errors.push({code:'evidence_not_allowed',key:e.series_id});continue;}
  if(fetched>now+MAX_FUTURE_MS||now-fetched>MAX_AGE_MS){counts.failed+=1;errors.push({code:'fetched_at_out_of_range',key:e.series_id});continue;}
  const evidenceInput:EvidenceInput={sha256:e.sha256,bytes,adapter:'akshare',fetchUrl:e.url,fetchHost:url.hostname,httpStatus:e.status,contentType:e.content_type,
   fetchedAt:new Date(fetched).toISOString(),toolVersions:{...batchTools,parser:parser.version}};
  let parsed:ParsedPoint[];
  try{parsed=parser.parse(bytes);}
  catch(x){
   // T9-1: hash-verified official bytes are kept even when the parser rejects them — store them and the retrieval receipt, and carry the
   // retrieval id in the chunk error so the failure can be investigated and replayed
   counts.failed+=1;
   const reason=(x as {code?:string}).code??'unparseable';
   let note=`retrieval unavailable: ${reason}`;
   try{
    const {objectPath}=await deps.evidence.put(evidenceInput);
    const id=await deps.db.putRetrieval({sha256:e.sha256,object_path:objectPath,adapter:'akshare',content_type:e.content_type,byte_length:bytes.byteLength},
     {fetch_url:e.url,fetch_host:url.hostname,http_status:e.status,fetched_at:evidenceInput.fetchedAt,batch_id:body.batch_id,tool_versions:evidenceInput.toolVersions},body.owner_token);
    note=`retrieval ${id}: ${reason}`;
   }catch(y){
    if(y instanceof MacroDbError&&y.code==='fenced')throw y;
   }
   errors.push({code:'parse_failed',key:e.series_id,message:note});
   continue;
  }
  const claims:Claim[]=[];
  for(const c of body.claims){
   if(c.series_id!==e.series_id)continue;
   const pe=claimPeriodEnd(c.period_label,parser.spec.period);
   if(pe)claims.push({series_id:c.series_id,period_end:pe,value_text:c.value_text});
  }
  for(const p of parsed)located.add(`${p.seriesId}|${p.periodEnd}`);
  retrievals.push({evidence:evidenceInput,parsed,claims});
 }
 // Claim identities: the batch-wide unlocated summary is computed at finish from these sets (P2-1), never per chunk.
 const claimKeys=[...new Set(body.claims.map(c=>{const p=parserFor(c.series_id),pe=p?claimPeriodEnd(c.period_label,p.spec.period):null;return pe?`${c.series_id}|${pe}`:`${c.series_id}|?${c.period_label}`;}))].sort();
 let rec:IngestReceipt;
 try{rec=await ingestEvidence(deps,{batchId:body.batch_id,adapter:'akshare',retrievals,ownerToken:body.owner_token});}
 catch(e){
  // 四轮 P2-2: an unbindable quarantined row aborts after committed writes. Merge the committed outcomes (partial) exactly once and
  // store them with the abort error through completeChunk — the chunk's single write; a retry gets the stored receipt — so finish
  // forces the batch failed with true counts. fenced (or no partial) propagates: 409 / 500 without completeChunk.
  if(!(e instanceof IngestAbort)||e.code!=='quarantine_link_failed'||!e.partial)throw e;
  counts=addCounts(counts,e.partial.counts);
  await deps.db.completeChunk(body.batch_id,body.seq,{counts,nativeUsable:e.partial.usable,errors:storedErrors([abortError(e),...errors,...e.partial.errors]),claimKeys,locatedKeys:[...located].sort()},body.owner_token);
  return err('quarantine_link_failed','A quarantined value could not be bound; the chunk is recorded and the batch will finish failed',500);
 }
 counts=addCounts(counts,rec.counts);errors.push(...rec.errors);
 // native_usable (第 6 稿 P2-1): rows that are data — previously_rejected redeliveries count as duplicates but not as usable
 const stored=await deps.db.completeChunk(body.batch_id,body.seq,{counts,nativeUsable:rec.usable,errors:storedErrors(errors),claimKeys,locatedKeys:[...located].sort()},body.owner_token);
 return json({status:'accepted',batch_id:body.batch_id,seq:body.seq,counts:stored.counts,errors:publicErrors(errors)});
}

/** Native outcomes of THIS collection = the chunk counts (chunks carry evidence only; 第 5 稿 P2-2). */
const nativeOf=(chunks:ChunkRecord[])=>chunks.reduce((acc,c)=>addCounts(acc,c.counts),emptyChunkCounts());
/** Usable native rows (第 6 稿 P2-1): the derivation / publication / freshness gate. Not the duplicates counter — it includes
 *  previously_rejected redeliveries. */
const usableOf=(chunks:ChunkRecord[])=>chunks.reduce((n,c)=>n+c.native_usable,0);
/** Batch totals for finalizeBatch: native chunks + derivation + failed series; every stored error plus the distinct unlocated-claims
 *  summary, and no_native_outcomes (non-INFO) when no usable native row landed (第 5 稿 P2-2, 第 6 稿 P2-1). */
function summarise(chunks:ChunkRecord[],derived:{counts:ChunkCounts;errors:ChunkError[]},outcomes:SeriesOutcome[],nativeUsable:number):{counts:ChunkCounts;errors:BatchError[];failedSeries:string[]}{
 const native=nativeOf(chunks);
 let counts=addCounts(native,derived.counts);
 const failed=outcomes.filter(o=>!o.ok);
 counts={...counts,failed:counts.failed+failed.length};
 const errors:BatchError[]=chunks.flatMap(c=>c.errors);
 const located=new Set(chunks.flatMap(c=>c.located_keys));
 const unlocated=new Set(chunks.flatMap(c=>c.claim_keys).filter(k=>!located.has(k))).size;
 // Owner ruling: an AKShare claim whose period has no TS-parsed raw value is NOT quarantined (no raw value to hold); it is
 // counted once per batch (distinct keys) under the existing INFO code skipped_summary, which does not degrade the batch.
 if(unlocated>0)errors.push({code:'skipped_summary',key:'unlocated_claims',message:`${unlocated} claims without a located raw value`});
 errors.push(...derived.errors);
 for(const o of failed)errors.push({code:o.code??'collect_failed',key:o.series_id});
 if(nativeUsable===0)errors.push({code:'no_native_outcomes'});
 return {counts,errors,failedSeries:failed.map(o=>o.series_id)};
}

const outcomesKey=(o:readonly SeriesOutcome[])=>JSON.stringify([...o].map(x=>[x.series_id,x.ok,x.code??null]).sort((a,b)=>String(a[0])<String(b[0])?-1:String(a[0])>String(b[0])?1:0));

async function finish(deps:MacroDeps,body:Extract<IngestBody,{action:'finish'}>){
 const b=await batchRow(deps,body.batch_id,{finishing:true});
 if(b instanceof NextResponse)return b;
 const begun=await deps.db.beginFinish(body.batch_id,body.total,body.owner_token);   // another owner / aborted run → fenced
 if(begun.status==='incomplete')return err('chunks_incomplete','Not every chunk has arrived',409,{missing:begun.missing.slice(0,50)});
 if(begun.status==='finished')return begun.progress.receipt?json(begun.progress.receipt):err('batch_not_running','Batch is finished',409);   // replay, re-run nothing
 // Only the holder of the latest finish token may record steps: a concurrent finish of the same owner is fenced at its next step.
 const fence={ownerToken:body.owner_token,finishToken:begun.finishToken};
 const step=(name:FinishStep,data:Record<string,unknown>)=>deps.db.recordFinishStep(body.batch_id,name,data,fence);
 let p:FinishProgress=begun.progress;
 const chunks=await deps.db.chunksOf(body.batch_id);
 const native=nativeOf(chunks);const nativeUsable=usableOf(chunks);const nativeLanded=nativeUsable>0;   // 第 6 稿 P2-1
 if(!p.derived){
  // idempotent by nature: a retry after a crash past deriveAndWrite writes duplicates only
  if(nativeLanded){
   let d:IngestReceipt;
   try{d=await deriveAndWrite(deps,'CN',body.batch_id,body.owner_token);}
   catch(e){
    // 四轮 P2-2: a derivation abort keeps its committed outcomes — merged exactly once through the 'derived' checkpoint (a retry
    // reads it back, never re-derives), with the abort error first so it survives the cap; finalize below is forced failed
    if(!(e instanceof IngestAbort)||e.code!=='quarantine_link_failed'||!e.partial)throw e;
    d={...e.partial,errors:[abortError(e),...e.partial.errors]};
   }
   // T9-2/T9-3: the outcome counts and the collector's series_outcomes are frozen in the very call that marks 'derived'
   p=await step('derived',{counts:d.counts,errors:storedErrors(d.errors),usable:d.usable,series_outcomes:body.series_outcomes});
  }else p=await step('derived',{skipped:'no_native_outcomes',series_outcomes:body.series_outcomes});                                       // 第 5 稿 P2-2
 }
 const derived='counts' in p.derived!?p.derived!:{counts:emptyChunkCounts(),errors:[]};
 // T9-3: retries use the frozen outcomes; a different payload is refused (checkpoints written before this field existed keep the request's)
 const frozen=p.derived!.series_outcomes;
 if(frozen&&outcomesKey(frozen)!==outcomesKey(body.series_outcomes))return err('finish_payload_conflict','series_outcomes differ from the first finish of this batch',409);
 const outcomes=frozen??body.series_outcomes;
 const {counts,errors,failedSeries}=summarise(chunks,derived,outcomes,nativeUsable);
 if(!p.batch_finished){
  // fenced side effect (第 6 稿 P1-1): written only under the current finish token and only while the batch runs; finalized:false =
  // an earlier attempt of this run finished it — the stored status is read back, never finished twice
  const fatal=errors.some(e=>e.code==='quarantine_link_failed');                                     // a chunk or the derivation aborted (四轮 P2-2)
  const fin=await deps.db.finalizeBatch(body.batch_id,batchFinalizeInput({counts,errors},deps.now(),fatal?'failed':undefined),fence);
  p=await step('batch_finished',{status:fin.status,date:deps.now().toISOString().slice(0,10)});
 }
 const batchStatus=p.batch_finished!.status as BatchStatus;
 const today=p.batch_finished!.date;
 const ok=batchStatus!=='failed'&&nativeLanded;
 if(!p.freshness_recorded){
  // the dq_freshness upsert and the freshness_recorded checkpoint commit together under the finish token (第 6 稿 P1-1): a crash
  // either loses both (the retry writes once) or keeps both (the retry skips) — never a double count, never a lost attempt
  p=await deps.db.recordFreshness(body.batch_id,{dataset:DATASET,ok,cadence:'daily',now:deps.now().toISOString(),
   detail:{batch_id:body.batch_id,batch_status:batchStatus,failed_series:failedSeries}},fence);
 }
 // Task 11 (spec §0.2 M24/N3; 第 4 稿 P2-4; 第 5 稿 P1-3/P1-4/P1-5/P2-2): CN publishes only here, after the batch's derivation,
 // keyed 'ingest:<batch_id>' and fenced by the owner + finish tokens, so a retry after a crash past the publish replays the same
 // snapshot. A failed batch or one without native outcomes is an intentional terminal skip. Any other non-published outcome is
 // retryable: recorded as a publish_attempt, the run stays finishing and the collector retries finish (503 publish_pending).
 // 'published' is checkpointed only after success (incl. replay) or an intentional skip.
 let publish=p.published;
 if(!publish){
  if(batchStatus==='failed'||!nativeLanded)publish={status:'skipped',region:'CN',reason:nativeLanded?'batch_failed':'no_native_outcomes'};
  else{
   const r=await publishRegion({db:deps.db},'CN',today,{publishKey:`ingest:${body.batch_id}`,fence:{batchId:body.batch_id,ownerToken:body.owner_token,finishToken:begun.finishToken}});
   if(r.status!=='published'){
    await step('publish_attempt',{at:deps.now().toISOString(),status:r.status,reason:r.status==='failed'?r.reason:null});
    return err('publish_pending','CN publication did not complete; retry finish with the same owner token',503,{publish:r.status});
   }
   publish={...r};
  }
  p=await step('published',publish);
 }
 const receipt={batch_id:body.batch_id,status:batchStatus,date:today,counts,native_counts:native,native_usable:nativeUsable,derived_counts:derived.counts,errors:publicErrors(errors),publish};
 await step('receipt',receipt);
 return json(receipt);
}

export async function POST(request:Request):Promise<NextResponse>{
 const secret=process.env.MACRO_INGEST_SECRET;
 if(!secret)return err('ingest_unavailable','Ingest unavailable',503);
 if(!authorizedCronRequest(request.headers.get('authorization'),secret))return err('unauthorized','Unauthorized',401);
 const declared=Number(request.headers.get('content-length')??'0');
 if(Number.isFinite(declared)&&declared>MAX_BODY_BYTES)return err('body_too_large','Body exceeds 4 MB',413);
 const raw=new Uint8Array(await request.arrayBuffer());
 if(raw.byteLength>MAX_BODY_BYTES)return err('body_too_large','Body exceeds 4 MB',413);
 let value:unknown;
 try{value=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(raw));}catch{return err('invalid_json','Body is not JSON',400);}
 const parsed=parseIngestBody(value);
 if(!parsed.ok)return err(parsed.error,'Invalid body',400);
 const codeVersion=resolveCodeVersion({allowGit:false});
 if(!codeVersion)return err('code_version_unavailable','VERCEL_GIT_COMMIT_SHA not set',503);
 const deps=productionMacroDeps({codeVersion});
 try{
  const body=parsed.body;
  return body.action==='start'?await start(deps,body):body.action==='chunk'?await chunk(deps,body):await finish(deps,body);
 }catch(e){
  // 第 5 稿 P1-3/P2-3: a superseded owner token → 409 fenced (the collector restarts under a new batch); an unbindable quarantined
  // row → 500 with the chunk left 'processing' (never completed), which the collector's stall path also restarts
  if(e instanceof IngestAbort)return e.code==='fenced'?fencedResponse():err('quarantine_link_failed','A quarantined value could not be bound; the chunk was not completed',500);
  if(e instanceof MacroDbError&&e.code==='fenced')return fencedResponse();
  // protocol refusals from the lease / chunk RPCs (MacroDbError rpc_failed with the SQL code as message) → 409
  const m=e instanceof MacroDbError||e instanceof Error?e.message:'';
  if(['chunk_total_mismatch','batch_not_open','batch_not_claimed','run_not_finishing'].includes(m))return err(m,'Ingest protocol refusal',409);
  return err('ingest_failed','Macro ingest failed',500);
 }
}
// src/lib/macro/cn-series.ts
// AKShare call specifications for the active CN series (spec §4.2, §4.4), derived from the catalog's
// source.seriesKey so the catalog stays the single source of truth:
//   macro_china_nbs_nation|<kind>|<tree path> > <indicator>   (indicator = NBS i_showname without whitespace)
//   bond_china_yield|<curve name>|<tenor column>
//   currency_boc_safe|<currency column>
// plus adapter-only parameters (NBS daily window, era leaves for history, ChinaBond windows) and the URL
// path of the one response per call that carries the data (the evidence the TS parsers read). Exported to
// scripts/macro/cn-series.json for the Python collector (scripts/macro/export-cn-series.ts); cn-series.test.ts
// enforces that the committed JSON equals this module's output.
import {collectableOf} from './catalog';
import type {MacroSeriesDef,PeriodKind} from './types';

export type CnFunction='macro_china_nbs_nation'|'bond_china_yield'|'currency_boc_safe';
export interface CnSeriesSpec{
 series_id:string;function:CnFunction;fetch_host:string;period:PeriodKind;
 /** URL path of the data response; other responses of the call (pages, trees, spreadsheets) are not evidence. */
 evidence_path:string;
 /** NBS: indicator i_showname (whitespace removed); ChinaBond: tenor column header; SAFE: currency column header. */
 column:string;
 kind?:string;path?:string;curve?:string;
 /** NBS: period argument of the daily call. */
 daily_period?:string;
 /** NBS history calls: [{path, period}] (era leaves). */
 backfill?:{path:string;period:string}[];
 /** ChinaBond: daily window length and the first day of the yearly history windows. */
 window_days?:number;backfill_from?:string;
}
export const CN_SPEC_VERSION='cn-series/1';
const NBS_PATH='/dg/website/publicrelease/web/external/stream/esData';
const CHINABOND_PATH='/cbweb-pbc-web/pbc/historyQuery';
const SAFE_PATH='/AppStructured/hlw/RMBQuery.do';
/** NBS splits some tables into era leaves; history comes from the sibling leaves (verified 2026-11-06). The current
 * catalog path is added in front by cnSpecOf, so a backfill reaches the present. */
const NBS_ERA_HISTORY:Record<string,{path:string;period:string}[]>={
 CN_CPI_INDEX:[
  {path:'价格指数 > 居民消费价格分类指数(上年同月=100) > 全国居民消费价格分类指数(上年同月=100)(2021-2025)',period:'2021-2025'},
  {path:'价格指数 > 居民消费价格分类指数(上年同月=100) > 全国居民消费价格分类指数(上年同月=100)(2016-2020)',period:'2016-2020'},
 ],
};
const strip=(s:string)=>s.replace(/\s+/g,'');

export function cnSpecOf(def:MacroSeriesDef):CnSeriesSpec{
 const src=def.source;
 if(!src||src.adapter!=='akshare')throw new Error(`not_akshare:${def.id}`);
 const parts=src.seriesKey.split('|');
 const base={series_id:def.id,fetch_host:src.fetchHost,period:def.period};
 if(parts[0]==='macro_china_nbs_nation'&&parts.length===3){
  const segs=parts[2].split('>').map(s=>s.trim()).filter(Boolean);
  if(segs.length<2)throw new Error(`bad_series_key:${def.id}`);
  const path=segs.slice(0,-1).join(' > ');
  const quarterly=def.period==='quarter';
  return {...base,function:'macro_china_nbs_nation',evidence_path:NBS_PATH,column:strip(segs[segs.length-1]),kind:parts[1],path,
   daily_period:quarterly?'LAST8':'LAST13',backfill:NBS_ERA_HISTORY[def.id]?[{path,period:'2026-'},...NBS_ERA_HISTORY[def.id]]:[{path,period:'2016-'}]};
 }
 if(parts[0]==='bond_china_yield'&&parts.length===3)return {...base,function:'bond_china_yield',evidence_path:CHINABOND_PATH,curve:parts[1],column:parts[2],window_days:45,backfill_from:'2016-01-01'};
 if(parts[0]==='currency_boc_safe'&&parts.length===2)return {...base,function:'currency_boc_safe',evidence_path:SAFE_PATH,column:parts[1]};
 throw new Error(`unsupported_series_key:${def.id}`);
}

/** Specs of every active native akshare series, catalog order. */
export function cnSeriesSpecs():CnSeriesSpec[]{return collectableOf('akshare').map(cnSpecOf);}
/** The JSON document the Python collector reads (stable key order, trailing newline). */
export function cnSeriesDocument():string{return JSON.stringify({version:CN_SPEC_VERSION,series:cnSeriesSpecs()},null,1)+'\n';}
// src/lib/macro/events.ts
// Read-time derived macro events (spec §6.1, version macro-events/1). Pure: the same observations give the
// same events. US policy events come from day-to-day changes of the official Fed target-range series
// (DFEDTARU / DFEDTARL via FRED). They are labelled 'derived' with their effective date and are never called
// "announcements". The FOMC meeting calendar is a separate 'calendar' kind (fomc.ts). China has no official
// automatic event source while LPR/MLF are missing (spec §6.1).
import {canonicalDecimal} from '@/lib/facts/json-numbers';
import {subtract} from './decimal';
import type {ObservationRow} from './types';
export const EVENTS_VERSION='macro-events/1';
export const US_TARGET_UPPER_ID='US_FED_TARGET_UPPER_D',US_TARGET_LOWER_ID='US_FED_TARGET_LOWER_D';
export type EventInput=Pick<ObservationRow,'observation_id'|'period_end'|'value_text'>;
export interface PolicyEvent{
 kind:'policy_target_change';region:'US';effective_date:string;upper_from:string;upper_to:string;lower_from:string;lower_to:string;change_bp:string;source:'derived';
 /** [upper prev, upper cur, lower prev, lower cur]: every input observation the event was derived from. */
 evidence:[string,string,string,string];version:string;
}
/** Exact decimal × 100 (percentage points → basis points). */
export const toBp=(delta:string):string=>canonicalDecimal(`${canonicalDecimal(delta)}e2`);
export const decimalSign=(v:string):-1|0|1=>{const c=canonicalDecimal(v);return c==='0'?0:c.startsWith('-')?-1:1;};
function assertAscending(rows:readonly EventInput[],label:string){
 for(let i=1;i<rows.length;i++)if(rows[i].period_end<=rows[i-1].period_end)throw new Error(`events_unsorted:${label}:${rows[i].period_end}`);
}
export function derivePolicyEvents(upper:readonly EventInput[],lower:readonly EventInput[]):PolicyEvent[]{
 assertAscending(upper,'upper');assertAscending(lower,'lower');
 const lowerBy=new Map(lower.map(r=>[r.period_end,r]));
 const days=upper.filter(u=>lowerBy.has(u.period_end)).map(u=>({u,l:lowerBy.get(u.period_end)!}));
 const out:PolicyEvent[]=[];
 for(let i=1;i<days.length;i++){
  const p=days[i-1],c=days[i];
  const du=subtract(c.u.value_text,p.u.value_text),dl=subtract(c.l.value_text,p.l.value_text);
  if(decimalSign(du)===0&&decimalSign(dl)===0)continue;
  out.push({kind:'policy_target_change',region:'US',effective_date:c.u.period_end,
   upper_from:canonicalDecimal(p.u.value_text),upper_to:canonicalDecimal(c.u.value_text),lower_from:canonicalDecimal(p.l.value_text),lower_to:canonicalDecimal(c.l.value_text),
   change_bp:toBp(decimalSign(du)!==0?du:dl),source:'derived',evidence:[p.u.observation_id,c.u.observation_id,p.l.observation_id,c.l.observation_id],version:EVENTS_VERSION});
 }
 return out;
}
// src/lib/macro/series-extras.ts
// Detail-page extras for GET /api/macro/series/[id] (spec §3.3, §6): derived US policy events, the FOMC calendar,
// cycle segments and enabled same-region asset moves per cycle. Reads full histories through
// MacroDb.seriesHistory, which pages to completion and throws `truncated` beyond maxRows; a partial series is never
// segmented. With asOf, every read is limited to rows available at asOf.
import {MACRO_CATALOG} from './catalog';
import {CYCLES_VERSION,assetChangeOverCycle,lastCompleteMonthEnd,policyCycles,seriesCycles,type AssetCycleChange,type Cycle,type InsufficientSegment} from './cycles';
import type {MacroDb} from './db';
import {EVENTS_VERSION,US_TARGET_LOWER_ID,US_TARGET_UPPER_ID,derivePolicyEvents,type PolicyEvent} from './events';
import {fomcCalendarEvents,type CalendarEvent} from './fomc';
import type {Bilingual,MacroSeriesDef} from './types';
export const DAILY_MAX_ROWS=20_000,MONTHLY_MAX_ROWS=5_000;
export interface AssetByCycle extends AssetCycleChange{cycle_index:number;asset_id:string;asset_name:Bilingual}
export interface SeriesExtras{events:PolicyEvent[];calendar:CalendarEvent[];cycles:Cycle[];insufficient:InsufficientSegment[];assetsByCycle:AssetByCycle[];eventsVersion:string;cyclesVersion:string}
export async function seriesExtras(db:Pick<MacroDb,'seriesHistory'>,def:MacroSeriesDef,opts:{asOf?:string}):Promise<SeriesExtras>{
 const read=(id:string,maxRows:number)=>db.seriesHistory(id,{asOf:opts.asOf,maxRows});
 let events:PolicyEvent[]=[];let lastTargetDay:string|null=null;
 if(def.region==='US'){
  const [upper,lower]=await Promise.all([read(US_TARGET_UPPER_ID,DAILY_MAX_ROWS),read(US_TARGET_LOWER_ID,DAILY_MAX_ROWS)]);
  events=derivePolicyEvents(upper,lower);
  lastTargetDay=upper.length?upper[upper.length-1].period_end:null;
 }
 let cycles:Cycle[]=[],insufficient:InsufficientSegment[]=[];
 if(def.region==='US'&&def.type==='policy_rate'){if(lastTargetDay)cycles=policyCycles(events,lastTargetDay);}
 else if(def.period==='month'&&def.role!=='event_source'){
  const r=seriesCycles(await read(def.aliasOf??def.id,MONTHLY_MAX_ROWS));cycles=r.cycles;insufficient=r.insufficient;
 }
 const self=def.aliasOf??def.id;
 const assets=MACRO_CATALOG.filter(a=>a.role==='asset'&&a.period==='month'&&a.status==='active'&&a.region===def.region&&a.id!==def.id&&(a.aliasOf??a.id)!==self);
 const assetsByCycle:AssetByCycle[]=[];
 if(cycles.length&&assets.length){
  const histories=await Promise.all(assets.map(a=>read(a.aliasOf??a.id,MONTHLY_MAX_ROWS)));
  cycles.forEach((c,ci)=>{
   const end=c.ongoing?lastCompleteMonthEnd(c.end):c.end;
   assets.forEach((a,ai)=>assetsByCycle.push({cycle_index:ci,asset_id:a.id,asset_name:a.name,...assetChangeOverCycle(histories[ai],{start:c.start,end},a.changeKind)}));
  });
 }
 return {events,calendar:def.region==='US'?fomcCalendarEvents(opts.asOf):[],cycles,insufficient,assetsByCycle,eventsVersion:EVENTS_VERSION,cyclesVersion:CYCLES_VERSION};
}

