import type {AnalysisKind,ChangeKind} from './types';
export const CORRELATION_VERSION='macro-correlation/1';
export const MIN_PAIRS=36,ROLLING_WINDOW=36,ROLLING_MIN_PAIRS=30,MIN_INDEPENDENT_EVENTS=5;
export const WINDOWS=['5y','10y','all'] as const;
export type AnalysisWindow=typeof WINDOWS[number];
export const EVENT_NS=[3,6,12] as const;
export type EventN=typeof EVENT_NS[number];
export interface AnalysisSpec{request_id:string;kind:AnalysisKind;indicator_id:string;asset_id:string;lag:number;window:AnalysisWindow;event_n?:EventN}
export interface FrozenObservation{observation_id:string;period_end:string;value_text:string}
export interface FrozenSeries{series_id:string;source_series_id:string;change_kind:ChangeKind;observations:FrozenObservation[]}
export interface FrozenEvent{effective_date:string;change_bp:string;evidence:string[]}
export interface FrozenInputs{indicator:FrozenSeries;asset:FrozenSeries;events?:FrozenEvent[];cutoff:string;catalog_version:string}
export type AnalysisErrorCode='insufficient_sample'|'zero_variance'|'non_positive_price'|'no_events'|'invalid_inputs'|'analysis_input_invalid';
export class AnalysisError extends Error{constructor(readonly code:AnalysisErrorCode,message?:string){super(message??code);this.name='AnalysisError';}}
export interface Pair{t:string;s:string;x:number;y:number}
export interface PairResult{kind:'change'|'level';r:number;r2:number;slope:number;intercept:number;n:number;from:string;to:string;lag:number;transform:'change'|'level';exploratory:boolean;x_unit:string;y_unit:string;pairs:Pair[];method_version:string;code_version:string}
export interface RollingResult{kind:'rolling';window_months:number;min_pairs:number;lag:number;points:{end:string;r:number;n:number}[];skipped_windows:number;from:string;to:string;method_version:string;code_version:string}
export interface Quartiles{median:number;q1:number;q3:number}
export interface EventRow{effective_date:string;anchor:string;change_bp:string;pre_from:string;post_to:string;pre:number;post:number}
export interface EventResult{kind:'event_window';n_months:number;events:EventRow[];candidates:number;independent:number;dropped:{effective_date:string;reason:'incomplete_window'|'overlap'}[];stats:{pre:Quartiles;post:Quartiles}|null;y_unit:string;method_version:string;code_version:string}
export type AnalysisResult=PairResult|RollingResult|EventResult;

const monthIndex=(d:string)=>Number(d.slice(0,4))*12+Number(d.slice(5,7))-1;
const monthKey=(i:number)=>`${Math.floor(i/12)}-${String(i%12+1).padStart(2,'0')}`;
const sign=(canonical:string)=>canonical==='0'?0:canonical.startsWith('-')?-1:1;
function byMonth(s:FrozenSeries):Map<number,string>{
 const out=new Map<number,string>();
 for(const o of s.observations){
  const k=monthIndex(o.period_end);
  if(out.has(k))throw new AnalysisError('invalid_inputs',`duplicate month ${o.period_end} in ${s.series_id}`);
  out.set(k,canonicalDecimal(o.value_text));
 }
 return out;
}
/** Indicator change in its changeKind units (exact decimal, then one float conversion). */
function indicatorDelta(cur:string,prev:string,kind:ChangeKind):number{
 if(kind==='bp')return Number(toBp(subtract(cur,prev)));
 if(kind==='pct'){if(sign(prev)<=0)throw new AnalysisError('non_positive_price',`base ${prev}`);return Number(yoyPct(cur,prev));}
 return Number(subtract(cur,prev));
}
/** Asset change: price (pct) → natural log return; yield (bp) → exact bp difference; otherwise plain difference. */
function assetDelta(cur:string,prev:string,kind:ChangeKind):number{
 if(kind==='pct'){if(sign(cur)<=0||sign(prev)<=0)throw new AnalysisError('non_positive_price',`${prev} → ${cur}`);return Math.log(Number(cur)/Number(prev));}
 if(kind==='bp')return Number(toBp(subtract(cur,prev)));
 return Number(subtract(cur,prev));
}
/** Asset move over an event window, in display units: pct → simple % (exact decimal), bp → bp, otherwise difference. */
function windowMove(to:string,from:string,kind:ChangeKind):number{
 if(kind==='pct'){if(sign(from)<=0)throw new AnalysisError('non_positive_price',`base ${from}`);return Number(yoyPct(to,from));}
 if(kind==='bp')return Number(toBp(subtract(to,from)));
 return Number(subtract(to,from));
}
/** Pair plus the exact-decimal keys its x and y were derived from (used only to detect constant inputs; never stored). */
interface KPair extends Pair{xk:string;yk:string}
const plain=(p:KPair):Pair=>({t:p.t,s:p.s,x:p.x,y:p.y});
const isConstant=(keys:readonly string[])=>keys.every(k=>k===keys[0]);
/** Constant x or y (all keys equal as canonical decimals): no variance, whatever float rounding says. */
const constantInput=(w:readonly KPair[])=>isConstant(w.map(p=>p.xk))||isConstant(w.map(p=>p.yk));
function alignedPairs(inputs:FrozenInputs,lag:number,transform:'change'|'level'):KPair[]{
 const xi=byMonth(inputs.indicator),ya=byMonth(inputs.asset);
 const out:KPair[]=[];
 for(const k of [...xi.keys()].sort((a,b)=>a-b)){
  const s=k+lag;const yCur=ya.get(s);if(yCur===undefined)continue;
  if(transform==='level'){out.push({t:monthKey(k),s:monthKey(s),x:Number(xi.get(k)!),y:Number(yCur),xk:xi.get(k)!,yk:yCur});continue;}
  const xPrev=xi.get(k-1),yPrev=ya.get(s-1);if(xPrev===undefined||yPrev===undefined)continue;
  const x=indicatorDelta(xi.get(k)!,xPrev,inputs.indicator.change_kind),y=assetDelta(yCur,yPrev,inputs.asset.change_kind);
  out.push({t:monthKey(k),s:monthKey(s),x,y,xk:inputs.indicator.change_kind==='pct'?String(x):subtract(xi.get(k)!,xPrev),yk:inputs.asset.change_kind==='pct'?String(y):subtract(yCur,yPrev)});
 }
 return out;
}
function windowed(pairs:KPair[],window:AnalysisWindow):KPair[]{
 if(window==='all'||!pairs.length)return pairs;
 const months=window==='5y'?60:120;const last=monthIndex(pairs[pairs.length-1].t);
 return pairs.filter(p=>monthIndex(p.t)>last-months);
}
export function pearson(xs:readonly number[],ys:readonly number[]):{r:number;slope:number;intercept:number}{
 const n=xs.length;if(n<2||ys.length!==n)throw new AnalysisError('insufficient_sample',`n=${n}`);
 let mx=0,my=0;for(let i=0;i<n;i++){mx+=xs[i];my+=ys[i];}mx/=n;my/=n;
 let sxx=0,syy=0,sxy=0;for(let i=0;i<n;i++){const dx=xs[i]-mx,dy=ys[i]-my;sxx+=dx*dx;syy+=dy*dy;sxy+=dx*dy;}
 if(sxx===0||syy===0)throw new AnalysisError('zero_variance');
 const r=Math.max(-1,Math.min(1,sxy/Math.sqrt(sxx*syy)));const slope=sxy/sxx;
 return {r,slope,intercept:my-slope*mx};
}
export function quartiles(values:readonly number[]):Quartiles{
 const s=[...values].sort((a,b)=>a-b);
 const q=(p:number)=>{const h=(s.length-1)*p,lo=Math.floor(h);return lo+1<s.length?s[lo]+(h-lo)*(s[lo+1]-s[lo]):s[lo];};
 return {median:q(0.5),q1:q(0.25),q3:q(0.75)};
}
const yUnit=(kind:ChangeKind,transform:'change'|'level')=>transform==='level'?'level':kind==='pct'?'log_return':kind;
export function runAnalysis(spec:AnalysisSpec,inputs:FrozenInputs,codeVersion:string):AnalysisResult{
 const base={method_version:CORRELATION_VERSION,code_version:codeVersion};
 if(spec.kind==='change'||spec.kind==='level'){
  const pairs=windowed(alignedPairs(inputs,spec.lag,spec.kind),spec.window);
  if(pairs.length<MIN_PAIRS)throw new AnalysisError('insufficient_sample',`n=${pairs.length} < ${MIN_PAIRS}`);
  if(constantInput(pairs))throw new AnalysisError('zero_variance','constant input');
  const {r,slope,intercept}=pearson(pairs.map(p=>p.x),pairs.map(p=>p.y));
  return {kind:spec.kind,r,r2:r*r,slope,intercept,n:pairs.length,from:pairs[0].t,to:pairs[pairs.length-1].t,lag:spec.lag,transform:spec.kind,exploratory:spec.kind==='level',
   x_unit:spec.kind==='level'?'level':inputs.indicator.change_kind,y_unit:yUnit(inputs.asset.change_kind,spec.kind),pairs:pairs.map(plain),...base};
 }
 if(spec.kind==='rolling'){
  const pairs=windowed(alignedPairs(inputs,spec.lag,'change'),spec.window);
  const idx=pairs.map(p=>monthIndex(p.t));
  const points:RollingResult['points']=[];
  let start=0,skipped=0;
  for(let j=0;j<pairs.length;j++){
   while(idx[start]<=idx[j]-ROLLING_WINDOW)start++;
   const w=pairs.slice(start,j+1);if(w.length<ROLLING_MIN_PAIRS)continue;
   if(constantInput(w)){skipped++;continue;}
   try{points.push({end:pairs[j].t,r:pearson(w.map(p=>p.x),w.map(p=>p.y)).r,n:w.length});}
   catch(e){if(e instanceof AnalysisError&&e.code==='zero_variance'){skipped++;continue;}throw e;}
  }
  if(!points.length)throw new AnalysisError('insufficient_sample',`no ${ROLLING_WINDOW}-month window with ≥ ${ROLLING_MIN_PAIRS} pairs`);
  return {kind:'rolling',window_months:ROLLING_WINDOW,min_pairs:ROLLING_MIN_PAIRS,lag:spec.lag,points,skipped_windows:skipped,from:points[0].end,to:points[points.length-1].end,...base};
 }
 // event_window
 const n=spec.event_n;if(n===undefined)throw new AnalysisError('invalid_inputs','event_n required');
 const yAll=byMonth(inputs.asset);
 const lastAsset=Math.max(...yAll.keys());
 const months=spec.window==='5y'?60:spec.window==='10y'?120:Infinity;
 // Completeness counts only asset months inside the selected window.
 const ya=new Map([...yAll].filter(([k])=>k>lastAsset-months));
 const events=[...(inputs.events??[])].sort((a,b)=>a.effective_date.localeCompare(b.effective_date)).filter(e=>monthIndex(e.effective_date)>lastAsset-months);
 if(!events.length)throw new AnalysisError('no_events');
 const kept:EventRow[]=[];const dropped:EventResult['dropped']=[];let lastKept:number|null=null;
 for(const e of events){
  const a=monthIndex(e.effective_date);
  let complete=true;for(let k=a-n;k<=a+n;k++)if(!ya.has(k)){complete=false;break;}
  if(!complete){dropped.push({effective_date:e.effective_date,reason:'incomplete_window'});continue;}
  if(lastKept!==null&&a-lastKept<=2*n){dropped.push({effective_date:e.effective_date,reason:'overlap'});continue;}
  kept.push({effective_date:e.effective_date,anchor:monthKey(a),change_bp:e.change_bp,pre_from:monthKey(a-n),post_to:monthKey(a+n),
   pre:windowMove(ya.get(a)!,ya.get(a-n)!,inputs.asset.change_kind),post:windowMove(ya.get(a+n)!,ya.get(a)!,inputs.asset.change_kind)});
  lastKept=a;
 }
 return {kind:'event_window',n_months:n,events:kept,candidates:events.length,independent:kept.length,dropped,
  stats:kept.length>=MIN_INDEPENDENT_EVENTS?{pre:quartiles(kept.map(k=>k.pre)),post:quartiles(kept.map(k=>k.post))}:null,
  y_unit:inputs.asset.change_kind==='pct'?'pct':inputs.asset.change_kind,...base};
}
  case 'interval':{
   const c=j.claim as IntervalClaim;
   const cov=state==='calibrated'&&s?.coverage!=null?both(` · 历史覆盖 ${pct(s.coverage)}%（名义 ${pct(c.nominal_coverage)}%）`,` · historical coverage ${pct(s.coverage)}% (nominal ${pct(c.nominal_coverage)}%)`):tag;
   return {headline:join(both(`${c.metric}：${fmt(c.low)} 至 ${fmt(c.high)} ${c.unit}（名义覆盖 ${pct(c.nominal_coverage)}%）`,`${c.metric}: ${fmt(c.low)} to ${fmt(c.high)} ${c.unit} (nominal coverage ${pct(c.nominal_coverage)}%)`),cov),percent:null,value:[c.low,c.high],nominal_coverage:c.nominal_coverage};
  }
 }
}
function overlay(e:Envelope,lifecycle:Lifecycle):Bilingual{
 const s=e.settlement;
 if(lifecycle==='settled'&&s){
  if(e.judgment.kind==='categorical'&&s.realized){const r=classLabel(String(s.realized.label??s.realized.value));return both(` · 实现：${r.zh}（${s.outcome==='hit'?'命中':'未命中'}）`,` · realized: ${r.en} (${s.outcome})`);}
  return both(` · 结果：${s.outcome==='hit'?'命中':'未命中'}`,` · result: ${s.outcome}`);
 }
 if(lifecycle==='void'&&s)return both(` · 作废：${s.reason??'—'}`,` · void: ${s.reason??'—'}`);
 if(lifecycle==='withdrawn'&&s)return both(` · 已撤回：${s.reason??'—'}`,` · withdrawn: ${s.reason??'—'}`);
 return both('','');
}
const inputHref=(i:Input):string|null=>i.kind==='judgment'?`/api/judgments/${i.ref.judgment_id}`:null;

export interface ToCardOptions{title:Bilingual;now:string;merged_from?:string}
/** Envelope → JudgmentCard (spec §9.2, §9.3). Pure; `now` (the cutoff for as_known views) is required so an expired report can never speak. */
export function toCard(e:Envelope,opts:ToCardOptions):JudgmentCard{
 const j=e.judgment;const lifecycle=lifecycleOf(e);
 const calibration=calibrationStateOf(e,j.kind,opts.now);
 const vc=validCalibration(e,j.kind,opts.now);
 const summary=vc?summaryOf(vc,j.kind):null;
 const display=displayOf(e,calibration,summary);
 display.headline=join(display.headline,overlay(e,lifecycle));
 const s=e.settlement;
 const card:JudgmentCard={
  judgment_id:j.judgment_id,subject:{type:j.subject_type,key:j.subject_key},judgment_type:j.judgment_type,kind:j.kind,
  lifecycle,outcome:lifecycle==='settled'&&s?s.outcome:null,calibration,retrospective:j.retrospective,as_of:j.as_of,registered_at:j.registered_at,
  methodology:{id:j.methodology_id,version:j.methodology_version,title:opts.title,href:`/intel/methods/${j.methodology_id}/${j.methodology_version}`},
  display,
  condition:j.abstained||!j.condition||!j.horizon||!j.target||!j.label_policy||!j.settle_after||!j.settle_by?null:{text:j.condition.text,horizon:j.horizon,target:j.target,label_policy:j.label_policy,settle_after:j.settle_after,settle_by:j.settle_by},
  settlement:s?{kind:s.kind,outcome:s.outcome,realized:s.realized,settled_at:s.settled_at,evidence_summary:both(`${s.resolver}@${s.resolver_version}${s.reason?` · 原因：${s.reason}`:''}`,`${s.resolver}@${s.resolver_version}${s.reason?` · reason: ${s.reason}`:''}`)}:null,
  calibration_summary:summary,
  inputs:j.inputs.map(i=>({kind:i.kind,ref:i.ref,available_at:i.available_at,origin:i.origin,href:inputHref(i)})),
 };
 if(!j.abstained&&j.kind==='probability'&&!validP((j.claim as ProbabilityClaim|null)?.p))card.missing=['invalid_claim'];
 if(j.abstained){card.abstain_reason=j.abstain_reason??undefined;}
 if(opts.merged_from!==undefined)card.merged_from=opts.merged_from;
 return card;
}

export interface CardsOptions{now:string;includeAbstained:boolean;requestedKey?:string}
/**
 * Envelopes → cards with the publication gate applied a second time (defence in depth over RLS,
 * spec §4.1): a method missing from `methods` or with publishable=false yields no card. Abstained
 * cards only when asked. A card whose subject_key differs from the requested issuer came through
 * the merged-issuer lookup (spec §12.4) and is marked merged_from.
 */
export function cardsOf(envelopes:Envelope[],methods:ReadonlyMap<string,MethodologyRow>,o:CardsOptions):JudgmentCard[]{
 const out:JudgmentCard[]=[];
 for(const e of envelopes){
  const m=methods.get(`${e.judgment.methodology_id}@${e.judgment.methodology_version}`);
  if(!m||!m.publishable)continue;
  if(e.judgment.abstained&&!o.includeAbstained)continue;
  const merged=o.requestedKey!==undefined&&e.judgment.subject_type==='issuer'&&e.judgment.subject_key!==o.requestedKey?e.judgment.subject_key:undefined;
  out.push(toCard(e,{title:{zh:m.title_zh,en:m.title_en},now:o.now,merged_from:merged}));
 }
 return out;
}
export const methodKey=(m:Pick<MethodologyRow,'methodology_id'|'version'>)=>`${m.methodology_id}@${m.version}`;

export type DerivedOdds={status:'not_computed';reasons:string[]}|{status:'computed';b:number;f:number};
const P_TOLERANCE=0.01,EPS=1e-9;
/**
 * spec §9.4: odds b = value_up / |value_down| and fractional Kelly f = k·(p·b − (1 − p)) / b, only when
 * both judgments are open and calibrated, the scenarios are the conditional distribution of the SAME
 * condition (scenario_event_hash = digest(winRate.condition)), Σp = 1, value_up > 0 > value_down, same
 * as_of / subject / target / horizon unit, |p_up − p| ≤ 0.01, and 0 < k ≤ 1. Otherwise every failed
 * precondition is listed and nothing is computed.
 */
export function derivedOdds(winRate:Envelope,returnRange:Envelope,opts:{k:number;now:string}):DerivedOdds{
 const reasons:string[]=[];
 const w=winRate.judgment,r=returnRange.judgment;
 if(w.judgment_type!=='thesis_win_rate'||w.kind!=='probability'||r.judgment_type!=='return_range'||r.kind!=='interval')reasons.push('wrong_type');
 if(lifecycleOf(winRate)!=='open'||lifecycleOf(returnRange)!=='open')reasons.push('not_open');
 if(calibrationStateOf(winRate,w.kind,opts.now)!=='calibrated'||calibrationStateOf(returnRange,r.kind,opts.now)!=='calibrated')reasons.push('not_calibrated');
 if(!(Number.isFinite(opts.k)&&opts.k>0&&opts.k<=1))reasons.push('invalid_k');
 const claim=r.claim as IntervalClaim|null;const p=(w.claim as ProbabilityClaim|null)?.p;
 if(!validP(p))reasons.push('invalid_probability');
 const sc=claim?.scenarios;
 const up=sc?.find(s=>s.label==='up'),down=sc?.find(s=>s.label==='down');
 if(!sc||sc.length!==2||!up||!down)reasons.push('scenarios_missing');
 else{
  if(!sc.every(s=>Number.isFinite(s.p)&&s.p>=0&&s.p<=1&&Number.isFinite(s.value)))reasons.push('scenario_values_invalid');
  else{
   if(Math.abs(up.p+down.p-1)>EPS)reasons.push('scenarios_not_normalized');
   if(!(up.value>0&&down.value<0))reasons.push('scenario_values_invalid');
   if(validP(p)&&Math.abs(up.p-(p as number))>P_TOLERANCE+EPS)reasons.push('inputs_inconsistent');
  }
 }
 if(!w.condition||!claim||claim.scenario_event_hash!==digest(w.condition))reasons.push('event_mismatch');
 if(w.as_of!==r.as_of)reasons.push('as_of_mismatch');
 if(w.subject_type!==r.subject_type||w.subject_key!==r.subject_key)reasons.push('subject_mismatch');
 if(!w.target||!r.target||canonicalize(w.target)!==canonicalize(r.target))reasons.push('target_mismatch');
 if(!w.horizon||!r.horizon||w.horizon.unit!==r.horizon.unit)reasons.push('unit_mismatch');
 if(reasons.length>0||!up||!down||typeof p!=='number')return {status:'not_computed',reasons:[...new Set(reasons)]};
 const b=up.value/Math.abs(down.value);
 const f=opts.k*(p*b-(1-p))/b;
 if(!(Number.isFinite(b)&&b>0&&Number.isFinite(f)))return {status:'not_computed',reasons:['odds_not_finite']};
 return {status:'computed',b,f};
}
export async function ingestEvidence(deps:IngestDeps,input:{batchId:string;adapter:Adapter;retrievals:RetrievalInput[];ownerToken?:string|null}):Promise<IngestReceipt>{
 const ctx:Ctx={deps,dataset:DATASET_OF[input.adapter],batchId:input.batchId,ownerToken:input.ownerToken??null,counts:emptyChunkCounts(),usable:0,errors:[],unit:null};
 const retrievalIds:string[]=[];
 await withPartial(ctx,retrievalIds,async()=>{
 for(const r of input.retrievals){
  const e=r.evidence,n=r.parsed.length;
  const label=[...new Set(r.parsed.map(p=>p.seriesId))].join(',')||e.fetchUrl.slice(0,120);
  beginUnit(ctx,n);
  if(e.adapter!==input.adapter){ctx.counts.failed+=n;ctx.errors.push({code:'evidence_adapter_mismatch',key:label});continue;}
  let objectPath:string;
  try{({objectPath}=await deps.evidence.put(e));}
  catch{ctx.counts.failed+=n;ctx.errors.push({code:'evidence_upload_failed',key:label});continue;}
  let retrievalId:string;
  try{
   retrievalId=await deps.db.putRetrieval(
    {sha256:e.sha256,object_path:objectPath,adapter:e.adapter,content_type:e.contentType,byte_length:e.bytes.byteLength},
    {fetch_url:e.fetchUrl,fetch_host:e.fetchHost,http_status:e.httpStatus,fetched_at:e.fetchedAt,batch_id:input.batchId,tool_versions:e.toolVersions},ctx.ownerToken);
  }catch(x){
   if(isFenced(x))throw new IngestAbort('fenced',label);
   ctx.counts.failed+=n;ctx.errors.push({code:'retrieval_failed',key:label});continue;
  }
  retrievalIds.push(retrievalId);
  const claims=new Map<string,string[]>();
  for(const c of r.claims??[]){const k=keyOf(c.series_id,c.period_end);claims.set(k,[...(claims.get(k)??[]),c.value_text]);}
  const bySeries=new Map<string,ParsedPoint[]>();
  for(const p of r.parsed)bySeries.set(p.seriesId,[...(bySeries.get(p.seriesId)??[]),p]);
  const writes:ObservationWrite[]=[];
  for(const [seriesId,points] of bySeries){
   const def=catalogById(seriesId);
   if(!collectable(def,input.adapter)){ctx.counts.failed+=points.length;ctx.errors.push({code:'unknown_series',key:seriesId});continue;}
   // 第 7 稿 T6-1: distinct canonical values for one period across ALL points, judged before quality / claim filtering —
   // the whole group is quarantined (conflicting_rows), none of it is written or used as the jump baseline.
   const seen=new Map<string,Set<string>>();
   for(const p of points){let c:string;try{c=canonical(p.valueText);}catch{continue;}seen.set(p.periodEnd,(seen.get(p.periodEnd)??new Set<string>()).add(c));}
   const conflicting=new Set<string>();
   for(const [periodEnd,vals] of seen){
    if(vals.size<2)continue;
    conflicting.add(periodEnd);
    const valueTexts=[...vals].sort();
    if(await park(ctx,keyOf(seriesId,periodEnd),'conflicting_rows',{value_texts:valueTexts},{value_texts:valueTexts})!==null)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
   }
   let prev:string|null=null;
   for(const p of [...points].sort((a,b)=>a.periodEnd<b.periodEnd?-1:a.periodEnd>b.periodEnd?1:0)){
    const key=keyOf(seriesId,p.periodEnd);
    if(conflicting.has(p.periodEnd))continue;
    let value:string;
    try{value=canonical(p.valueText);}catch{ctx.counts.failed+=1;ctx.errors.push({code:'invalid_value',key});continue;}
    const payload={value_text:value,retrieval_id:retrievalId,locator:p.locator};
    const q=validatePoint(def,value,prev);
    if(!q.passed){
     let parked=false;
     for(const f of q.failed)parked=(await park(ctx,key,`rule_failed:${f.ruleId}`,{...(f.detail??{}),rules_version:q.version},payload))!==null||parked;
     if(parked)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
     continue;
    }
    const claimed=claims.get(key);
    if(claimed&&claimed.some(c=>{try{return !equals(c,value);}catch{return true;}})){
     if(await park(ctx,key,'adapter_mismatch',{value_text:value,claim_value_texts:claimed},payload)!==null)ctx.counts.quarantined+=1;else ctx.counts.failed+=1;
     continue;
    }
    prev=value;
    writes.push({series_id:seriesId,period_end:p.periodEnd,value_text:value,available_at:e.fetchedAt,revisable:def.revisionPolicy==='revisable',retrieval_id:retrievalId,locator:p.locator});
   }
  }
  await writeAll(ctx,writes);
  ctx.unit=null;
 }
 });
 return {counts:ctx.counts,usable:ctx.usable,errors:ctx.errors,retrievalIds};
}

/** Derived series of a region whose input is native come first, so a derived input is written before its dependants. */
export function derivedOf(region:Region):MacroSeriesDef[]{
 const defs=MACRO_CATALOG.filter(d=>d.region===region&&d.status==='active'&&d.derive);
 const depth=(d:MacroSeriesDef,seen=0):number=>{const input=d.derive?catalogById(d.derive.from):undefined;return input?.derive&&seen<8?1+depth(input,seen+1):0;};
 return [...defs].sort((a,b)=>depth(a)-depth(b));
}

/**
 * Recomputes every derived series of `region` from the inputs' COMPLETE eligible history (plus rows of the open batch
 * `batchId`) and writes it in that batch (spec §0.2 N3; 第 4 稿 P1-5/P1-7). No window: a revised input three years
 * back must reach its derived period and, for yoy, period + 12; unchanged rows return as duplicates.
 */
export async function deriveAndWrite(deps:IngestDeps,region:Region,batchId:string,ownerToken:string|null=null):Promise<IngestReceipt>{
 const ctx:Ctx={deps,dataset:DATASET_OF_REGION[region],batchId,ownerToken,counts:emptyChunkCounts(),usable:0,errors:[],unit:null};
 const now=deps.now();
 await withPartial(ctx,[],async()=>{
 for(const def of derivedOf(region)){
  const input=catalogById(def.derive!.from);
  if(!input){ctx.errors.push({code:'missing_derive_input',key:def.id});continue;}
  let history:ObservationRow[];
  try{history=await deps.db.eligibleHistory(input.id,{includeBatch:batchId,maxRows:DERIVE_MAX_ROWS});}
  catch(e){ctx.errors.push({code:e instanceof MacroDbError?`history_${e.code}`:'history_failed',key:def.id});continue;}
  let writes:ObservationWrite[];
  try{writes=deriveSeries(def,history,{now});}
  catch{ctx.errors.push({code:'derive_failed',key:def.id});continue;}
  beginUnit(ctx,writes.length);
  await writeAll(ctx,writes);
  ctx.unit=null;
 }
 });
 return {counts:ctx.counts,usable:ctx.usable,errors:ctx.errors,retrievalIds:[]};
}
  },
  async seriesHistory(id,o){
   if(!Number.isInteger(o.maxRows)||o.maxRows<1)throw new MacroDbError('rpc_failed','invalid_max_rows');
   const make=()=>{
    let q=anon.from('macro_observations').select('*').eq('series_id',id).eq('status','ok');
    if(o.from)q=q.gte('period_end',o.from);
    if(o.to)q=q.lte('period_end',o.to);
    if(o.asOf)q=q.lte('available_at',o.asOf);
    return q.order('period_end',{ascending:true}).order('version',{ascending:true}) as Query;
   };
   const got=await pageAll(make,o.maxRows+1);
   if(got.length>o.maxRows)throw new MacroDbError('truncated',`series_history:${id}:>${o.maxRows}`);
   return highestPerPeriod(got.map(observationFromRow));
  },
  async versionsOf(id,periodEnd){
   // paged to completion (review T3-2): PostgREST silently caps a response at max_rows
   const got=await pageAll(()=>anon.from('macro_observations').select('*').eq('series_id',id).eq('period_end',periodEnd).eq('status','ok').order('version',{ascending:true}) as Query,Number.MAX_SAFE_INTEGER);
   return got.map(observationFromRow);
  },
  async observationsByIds(ids){
   const uniq=[...new Set(ids)];const found=new Map<string,ObservationRow>();
   for(let i=0;i<uniq.length;i+=IN_CHUNK){
    for(const r of await rows(anon.from('macro_observations').select('*').in('observation_id',uniq.slice(i,i+IN_CHUNK)).eq('status','ok')))found.set(String(r.observation_id),observationFromRow(r));
   }
   return uniq.flatMap(id=>{const o=found.get(id);return o?[o]:[];});
  },
  async publishState(region){
   const r=await maybe(admin.from('macro_publish_state').select('revision,input_revision').eq('region',region).maybeSingle());
   if(!r)throw new MacroDbError('not_found',`publish_state:${region}`);
   return {revision:Number(r.revision),inputRevision:Number(r.input_revision)};
  },

