// src/lib/macro/snapshots.ts
// Fact-snapshot publishing (spec §4.4 steps 4–5, §5.3, §11; §0.2 M7/M16/N3; 第 4 稿 P1-5/P1-8). A snapshot
// is the frozen manifest of each weighted active item's latest, previous and 3-months-earlier ELIGIBLE
// observations (ok + batch success/partial + ancestors eligible) plus the frozen sparkline history
// (history_ids); it is published regardless of coverage (regime=null only means "no classification").
// Optimistic: (revision, input_revision) is read first; stale_publisher → one retry from scratch, then give
// up. Other failures record a failed snapshot; active is untouched. 第 5 稿: an optional publish key makes a repeated
// publish replay the stored snapshot (replayed:true) — its receipt is read back from the persisted snapshot and regime row
// (第 6 稿 P2-2); the ingest finish adds its owner fence, and `fenced` propagates.
import {CATALOG_VERSION,catalogById,regimeInputsOf} from './catalog';
import {MacroDbError} from './db';
import type {MacroDb} from './db';
import {macroJudgmentsEnabled} from './flags';
import {shiftMonthEnd} from './freshness';
import {METHODOLOGY_VERSION,RULES_VERSION,WEIGHTS_V1,classifyRegime} from './regime';
import type {ObsRef,RegimeInput,RegimeSeriesInput} from './regime';
import type {CatalogCounts,MacroSeriesDef,ObservationRow,Region,SnapshotRecord} from './types';

/** prev = previous existing period within this window; an older gap leaves prev absent. */
export const HISTORY_MONTHS=24;
/** Frozen sparkline length per indicator (history_ids). */
export const SPARK_POINTS=24;
const ref=(r:ObservationRow):ObsRef=>({observation_id:r.observation_id,period_end:r.period_end,value_text:r.value_text});
/** observations = the manifest rows; historyIds = the frozen display history (last SPARK_POINTS eligible rows per input). */
export interface BuiltRegimeInput{input:RegimeInput;observations:ObservationRow[];historyIds:string[]}
/** Weighted catalog items of a region (active, missing and restricted), in WEIGHTS_V1 order: the overview rows and catalog counts. */
export function catalogItemsOf(region:Region):MacroSeriesDef[]{
 return Object.keys(WEIGHTS_V1).map(id=>catalogById(id)).filter((d):d is MacroSeriesDef=>d!==undefined&&d.region===region);
}
/** Latest eligible (≤ periodEndLte, available_at ≤ asOf), previous existing period, and the period exactly 3 months
 *  earlier (= previous quarter for quarterly). Missing comparison periods stay absent. Reads only publication-eligible
 *  rows (第 4 稿 P1-5) and returns the frozen sparkline history ids (P1-8). */
export async function buildRegimeInput(db:MacroDb,region:Region,opts:{asOf?:string;periodEndLte?:string}={}):Promise<BuiltRegimeInput>{
 const defs=regimeInputsOf(region).filter(d=>d.region===region);
 const histories=opts.asOf?await Promise.all(defs.map(d=>db.eligibleHistoryAsOf(d.id,{to:opts.periodEndLte??'9999-12-31',asOf:opts.asOf!,maxRows:10000}))):null;
 const latest=histories?histories.flatMap(h=>h.length?[h[h.length-1]]:[]):await db.latestEligible(defs.map(d=>d.id),{asOf:opts.asOf,periodEndLte:opts.periodEndLte});
 const series:Record<string,RegimeSeriesInput>={};
 const used=new Map<string,ObservationRow>();
 const historyIds:string[]=[];
 for(const row of latest){
  const def=defs.find(d=>d.id===row.series_id);
  if(!def)continue;
  const span=def.period==='quarter'?3*SPARK_POINTS:SPARK_POINTS;   // months covering SPARK_POINTS periods
  const all=histories?histories[defs.indexOf(def)].filter(h=>h.period_end>=shiftMonthEnd(row.period_end,-span)):await db.eligibleHistory(row.series_id,{from:shiftMonthEnd(row.period_end,-span),to:row.period_end,asOf:opts.asOf,maxRows:4*SPARK_POINTS});
  historyIds.push(...all.slice(-SPARK_POINTS).map(h=>h.observation_id));
  const windowStart=shiftMonthEnd(row.period_end,-HISTORY_MONTHS);
  const earlier=all.filter(h=>h.period_end<row.period_end&&h.period_end>=windowStart);   // ascending by contract
  const prev=earlier.at(-1);
  const target3m=shiftMonthEnd(row.period_end,-3);
  const prev3m=earlier.find(h=>h.period_end===target3m);
  const s:RegimeSeriesInput={latest:ref(row)};used.set(row.observation_id,row);
  if(prev){s.prev=ref(prev);used.set(prev.observation_id,prev);}
  if(prev3m){s.prev3m=ref(prev3m);used.set(prev3m.observation_id,prev3m);}
  series[row.series_id]=s;
 }
 return {input:{region,series},observations:[...used.values()],historyIds:[...new Set(historyIds)]};
}
/** verified = active items with ≥ 1 ok observation; missing = status missing + active without data; restricted. */
export async function catalogCounts(db:MacroDb,region:Region):Promise<CatalogCounts>{
 const items=catalogItemsOf(region);
 const active=items.filter(d=>d.status==='active');
 const seen=new Set((await db.latestEligible(active.map(d=>d.id))).map(r=>r.series_id));
 return {
  verified:active.filter(d=>seen.has(d.id)).length,
  missing:items.filter(d=>d.status==='missing').length+active.filter(d=>!seen.has(d.id)).length,
  restricted:items.filter(d=>d.status==='restricted').length,
 };
}
export type OnPublished=(snapshot:SnapshotRecord)=>Promise<void>;
/** Default judgment hook: F4 wires produce(macro_regime_v1, …) here later (F4 spec §11.1). */
export const noopOnPublished:OnPublished=async()=>{};
export interface PublishDeps{db:MacroDb;onPublished?:OnPublished;env?:Record<string,string|undefined>}
/** publishKey: 'cron:<batch>' | 'ingest:<batch>' (第 5 稿 P1-4); fence: the ingest run's batch + owner token (P1-3). */
export interface PublishOptions{publishKey?:string;fence?:{batchId:string;ownerToken:string|null;finishToken:string|null}}
export type PublishReceipt=
 |{status:'published';region:Region;snapshot_id:string;revision:number;observation_count:number;regime:'classified'|'null';uncovered_weight:number;attempts:number;hook:'skipped'|'ok'|'failed';replayed:boolean}
 |{status:'stale';region:Region;attempts:number}
 |{status:'failed';region:Region;reason:string;failed_snapshot_id:string|null;attempts:number};
async function runHook(deps:PublishDeps,env:Record<string,string|undefined>,snapshotId:string):Promise<'skipped'|'ok'|'failed'>{
 if(!macroJudgmentsEnabled(env))return 'skipped';
 try{
  const snap=await deps.db.snapshot(snapshotId);
  if(!snap)return 'failed';
  await (deps.onPublished??noopOnPublished)(snap);
  return 'ok';
 }catch(e){console.error('[macro-publish] judgment hook failed',e instanceof Error?e.message:e);return 'failed';}
}
const isFenced=(e:unknown)=>e instanceof MacroDbError&&e.code==='fenced';
/** Every outcome is a receipt, except `fenced` (a superseded ingest owner; 第 5 稿 P1-3), which is rethrown so the finish stops.
 *  `today` is the snapshot's as_of (YYYY-MM-DD). */
export async function publishRegion(deps:PublishDeps,region:Region,today:string,opts:PublishOptions={}):Promise<PublishReceipt>{
 const env=deps.env??process.env;
 let attempts=0;
 try{
  for(;;){
   attempts++;
   try{
    const state=await deps.db.publishState(region);
    const built=await buildRegimeInput(deps.db,region);
    const cls=classifyRegime(built.input);
    const counts=await catalogCounts(deps.db,region);
    const res=await deps.db.publishSnapshot({
     region,expectedRevision:state.revision,expectedInputRevision:state.inputRevision,asOf:today,
     methodologyVersion:METHODOLOGY_VERSION,catalogVersion:CATALOG_VERSION,observationIds:built.observations.map(o=>o.observation_id),historyIds:built.historyIds,
     catalogCounts:counts,regime:cls.regime,contributions:cls.contributions,rulesVersion:RULES_VERSION,uncoveredWeight:cls.uncoveredWeight,
     publishKey:opts.publishKey,batchId:opts.fence?.batchId,ownerToken:opts.fence?.ownerToken,finishToken:opts.fence?.finishToken,
    });
    if(res.replayed){
     // An earlier attempt published under this key (and ran or lost its hook; F4's produce is never re-triggered from a replay).
     // The receipt describes THAT snapshot from its persisted fields (第 6 稿 P2-2), not the inputs rebuilt above, which may differ.
     const snap=await deps.db.snapshot(res.snapshot_id);
     if(!snap)throw new MacroDbError('rpc_failed',`replayed_snapshot_missing:${res.snapshot_id}`);
     const stored=await deps.db.regimeOf(res.snapshot_id);                                             // admin read (service-only table)
     if(!stored)throw new MacroDbError('rpc_failed',`replayed_regime_missing:${res.snapshot_id}`);     // never invent uncovered_weight 0
     return {status:'published',region,snapshot_id:res.snapshot_id,revision:res.revision,observation_count:snap.observation_ids.length,
      regime:stored.regime?'classified':'null',uncovered_weight:stored.uncovered_weight,attempts,hook:'skipped',replayed:true};
    }
    const hook=await runHook(deps,env,res.snapshot_id);
    return {status:'published',region,snapshot_id:res.snapshot_id,revision:res.revision,observation_count:built.observations.length,
     regime:cls.regime?'classified':'null',uncovered_weight:cls.uncoveredWeight,attempts,hook,replayed:false};
   }catch(e){
    if(e instanceof MacroDbError&&e.code==='stale_publisher'){if(attempts<2)continue;return {status:'stale',region,attempts};}
    throw e;
   }
  }
 }catch(e){
  if(isFenced(e))throw e;                                                                             // protocol abort, not a failed publication
  const reason=(e instanceof MacroDbError?e.code:e instanceof Error?e.message:String(e)).slice(0,500);
  let failed:string|null=null;
  try{failed=await deps.db.recordFailedSnapshot({region,asOf:today,methodologyVersion:METHODOLOGY_VERSION,catalogVersion:CATALOG_VERSION,reason});}
  catch(e2){console.error('[macro-publish] recordFailedSnapshot failed',e2 instanceof Error?e2.message:e2);}
  return {status:'failed',region,reason,failed_snapshot_id:failed,attempts};
 }
}
// src/lib/macro/strategy/f4-client.ts
// F4 read client (spec 2026-11-07 §9.1 last paragraph, §5.2, §6.2, §6.4). P3/P4 never import src/lib/judgments: they read
// F4's public HTTP routes on this site (NEXT_PUBLIC_SITE_URL) with a 3-second timeout. Any failure (no base URL, network,
// timeout, non-2xx, a 404 that is not JSON i.e. the route does not exist, malformed body) throws F4Unavailable; a JSON 404
// from the detail route means "no such judgment" → null. Only number-free fields are projected (spec §5.2 N12).
// F4CardLite / F4JudgmentDetail live in f4-types.ts (Task 6) and are re-exported here, never redeclared.
import type {Region,Regime} from './contract';
import {REGIMES} from './contract';
import type {F4CardLite,F4JudgmentDetail} from './f4-types';

export type {F4CardLite,F4JudgmentDetail};
export interface F4Client{
 latestRegimeCard(region:Region,opts?:{asOf?:string}):Promise<F4CardLite|null>;
 judgmentDetail(id:string):Promise<F4JudgmentDetail|null>;
 history(id:string,before:string|null,limit:number):Promise<F4CardLite[]>;
}
export class F4Unavailable extends Error{constructor(message='f4_unavailable'){super(message);this.name='F4Unavailable';}}
export const F4_TIMEOUT_MS=3000;

type Json=Record<string,unknown>;
const isObj=(v:unknown):v is Json=>typeof v==='object'&&v!==null&&!Array.isArray(v);
const nonemptyObj=(v:unknown):v is Json=>isObj(v)&&Object.keys(v).length>0;
const str=(v:unknown):string|null=>typeof v==='string'?v:null;
export const asRegime=(v:unknown):Regime|null=>typeof v==='string'&&(REGIMES as readonly string[]).includes(v)?v as Regime:null;
/** JudgmentCard (F4 spec §9.2) → number-free projection; the categorical value of macro_regime is display.value. */
export function cardLite(c:unknown):F4CardLite{
 if(!isObj(c))throw new F4Unavailable('f4_malformed:card');
 const m=isObj(c.methodology)?c.methodology:null;const id=str(c.judgment_id);const asOf=str(c.as_of);
 if(!id||!asOf||!m||!str(m.id)||!str(m.version))throw new F4Unavailable('f4_malformed:card');
 const display=isObj(c.display)?c.display:{};
 return {judgment_id:id,lifecycle:str(c.lifecycle)??'unknown',calibration:str(c.calibration)??'unknown',as_of:asOf,methodology:{id:m.id as string,version:m.version as string},selected:asRegime(display.value)};
}
export function judgmentDetailOf(body:unknown):F4JudgmentDetail{
 if(!isObj(body)||!isObj(body.judgment))throw new F4Unavailable('f4_malformed:detail');
 const j=body.judgment;const card=isObj(body.card)?body.card:{};const display=isObj(card.display)?card.display:{};
 const id=str(j.judgment_id)??str(card.judgment_id);const asOf=str(j.as_of)??str(card.as_of);
 if(!id||!asOf)throw new F4Unavailable('f4_malformed:detail');
 const claim=isObj(j.claim)?j.claim:{};
 const bad=()=>new F4Unavailable('f4_malformed:detail');
 // Required collections are validated, never normalized: a missing / non-array collection or an invalid entry is malformed.
 if(!Array.isArray(j.inputs)||!Array.isArray(body.settlements))throw bad();
 const inputs=j.inputs.map(x=>{
  if(!isObj(x)||str(x.kind)===null||!nonemptyObj(x.ref)||!nonemptyObj(x.snapshot))throw bad();
  return {...x,kind:x.kind as string,ref:x.ref,snapshot:x.snapshot};
 });
 const settlements=body.settlements.map(s=>{
  const settledAt=isObj(s)?str(s.settled_at):null;
  if(!isObj(s)||!settledAt||Number.isNaN(Date.parse(settledAt))||str(s.outcome)===null||(s.settlement_id!==undefined&&str(s.settlement_id)===null)||!nonemptyObj(s.evidence))throw bad();
  return {...s,settlement_id:str(s.settlement_id)??undefined,outcome:str(s.outcome),realized:s.realized??null,evidence:s.evidence,settled_at:settledAt};
 });
 return {judgment_id:id,as_of:asOf,selected:asRegime(claim.selected)??asRegime(display.value),inputs,settlements};
}
export function createF4Client(o:{baseUrl?:string|null;fetch?:typeof fetch;timeoutMs?:number}={}):F4Client{
 const raw=o.baseUrl===undefined?process.env.NEXT_PUBLIC_SITE_URL??null:o.baseUrl;
 let base:string|null=null;
 if(raw){try{const u=new URL(raw);if((u.protocol==='https:'||(u.protocol==='http:'&&(u.hostname==='localhost'||u.hostname==='127.0.0.1')))&&!u.username&&!u.password&&u.pathname==='/'&&!u.search&&!u.hash)base=u.origin;}catch{/* invalid configuration */}}
 const doFetch=o.fetch??fetch;const timeoutMs=o.timeoutMs??F4_TIMEOUT_MS;
 async function get(path:string,params:Record<string,string>,allowNotFound:boolean):Promise<unknown|null>{
  if(!base)throw new F4Unavailable('f4_unconfigured');
  const url=`${base}${path}${Object.keys(params).length?`?${new URLSearchParams(params)}`:''}`;
  let res:Response;
  try{res=await doFetch(url,{signal:AbortSignal.timeout(timeoutMs),cache:'no-store',headers:{accept:'application/json'}});}
  catch(e){throw new F4Unavailable(`f4_fetch_failed:${e instanceof Error?e.name:'error'}`);}
  const json=(res.headers.get('content-type')??'').includes('application/json');
  if(res.status===404&&allowNotFound&&json)return null;
  if(!res.ok)throw new F4Unavailable(`f4_status:${res.status}`);
  if(!json)throw new F4Unavailable('f4_not_json');
  try{return await res.json();}catch{throw new F4Unavailable('f4_malformed:json');}
 }
 return {
  async latestRegimeCard(region,opts){
   const p:Record<string,string>={subject_type:'macro_region',subject_key:region,types:'macro_regime'};
   if(opts?.asOf){p.view='as_known';p.asOf=opts.asOf;}
   const body=await get('/api/judgments',p,false);
   if(!isObj(body)||!Array.isArray(body.cards))throw new F4Unavailable('f4_malformed:list');
   const card=body.cards.find(c=>isObj(c)&&c.judgment_type==='macro_regime')??null;
   return card?cardLite(card):null;
  },
  async judgmentDetail(id){
   const body=await get(`/api/judgments/${encodeURIComponent(id)}`,{},true);
   return body===null?null:judgmentDetailOf(body);
  },
  async history(id,before,limit){
   const p:Record<string,string>={limit:String(limit)};if(before)p.before=before;
   const body=await get(`/api/judgments/${encodeURIComponent(id)}/history`,p,false);
   const list=isObj(body)?(Array.isArray(body.cards)?body.cards:Array.isArray(body.items)?body.items:null):null;
   if(!list)throw new F4Unavailable('f4_malformed:history');
   return list.map(cardLite);
  },
 };
}
// src/lib/judgments/methodologies/macro-regime.v1.ts
// macro_regime@v1 (spec §11.1, §8.1 G28; doc docs/methodologies/macro_regime/v1.md): current-period nowcast of the US/CN
// growth–inflation regime, bound to one published macro snapshot (binding.snapshot_id, spec §6.4). The claim restates the
// snapshot's primary state as a categorical claim: distribution = norm flagged scores_are_not_probabilities, margin_pp in
// percentage points, catalog_version frozen. The label is the same classifier re-run for the same reference month on the
// cutoff vintage (resolver macro_regime_replay, label_policy cutoff_vintage, horizon 3 calendar months).
// Active: the landed macro API reuses classifyRegime. Licenses remain unverified: publishable=false.
import type {Abstained,Active,CategoricalClaim,Condition,Input,JudgmentInputsDb,MacroSnapshotSnapshot,Methodology,Regime,Subject,Target,WorkItem} from '@/lib/judgments/types';
import {buildInput} from '@/lib/judgments/inputs';
import {addMonthsPeriod} from '@/lib/judgments/time';

import {METHODOLOGY_VERSION} from '@/lib/macro/regime';
export const MACRO_UPSTREAM_VERSION=METHODOLOGY_VERSION;
export const MACRO_REGIMES:readonly Regime[]=['recovery','overheat','stagflation','recession'];
/** Allowed gap (pp) between the snapshot's stored margin and the one recomputed from norm; a fraction-valued margin fails it (G28). */
export const MARGIN_UNIT_TOLERANCE_PP=0.01;
/** Macro spec §5.3 classifies nothing below this coverage; re-checked because compute never trusts the snapshot status. */
const MIN_COVERAGE=0.6;
const ZH:Record<Regime,string>={recovery:'复苏',overheat:'过热',stagflation:'滞胀',recession:'衰退'};
type SnapshotInput=Extract<Input,{kind:'macro_snapshot'}>;

const abstain=(reason:string,missing?:string[]):Abstained=>missing?{abstained:true,reason,missing}:{abstained:true,reason};
const snapshotOf=(inputs:Input[]):MacroSnapshotSnapshot|null=>inputs.find((i):i is SnapshotInput=>i.kind==='macro_snapshot')?.snapshot??null;
/** (norm[primary] − norm[secondary]) × 100, rounded to 6 decimals: percentage points (spec §8.1). */
export const marginPp=(norm:Record<Regime,number>,primary:Regime,secondary:Regime)=>Math.round((norm[primary]-norm[secondary])*1e8)/1e6;

async function gather(item:WorkItem,db:JudgmentInputsDb):Promise<Input[]|Abstained>{
 const snapshotId=item.binding?.snapshot_id;
 if(!snapshotId)return abstain('binding_missing',['snapshot_id']);
 const published=await db.macro.snapshot(snapshotId);
 if(published&&published.status!=='active'&&published.status!=='superseded')return abstain('snapshot_not_published');
 const snap=await buildInput({kind:'macro_snapshot',ref:{snapshot_id:snapshotId}},db,item.asOf,item.observedAt);
 if(snap.kind!=='macro_snapshot')throw new Error(`buildInput returned ${snap.kind} for a macro_snapshot ref`);
 const s=snap.snapshot;
 if(s.region!==item.subject.key||s.as_of!==item.asOf)return abstain('binding_mismatch');
 // A foreign upstream version is not computed on; the snapshot alone is frozen so the abstention stays findable by snapshot_id.
 if(s.methodology_version!==MACRO_UPSTREAM_VERSION||s.catalog_version!==macroRegimeV1.params.catalog_version)return [snap];
 const inputs:Input[]=[snap];
 for(const id of s.observation_ids){
  const o=await db.macro.observation(id);   // locator lookup only; every frozen value comes from buildInput
  if(!o)return abstain('observation_missing',[id]);
  inputs.push(await buildInput({kind:'macro_observation',ref:{series_id:o.series_id,period_end:o.period_end,vintage_id:o.vintage_id}},db,item.asOf,item.observedAt));
 }
 return inputs;
}

async function resolveTarget(item:WorkItem):Promise<Target>{
 return {kind:'period',period:addMonthsPeriod(item.asOf.slice(0,7),3)};
}

function compute(subject:Subject,inputs:Input[]):Active<CategoricalClaim>|Abstained{
 const s=snapshotOf(inputs);
 if(!s)return abstain('input_missing',['macro_snapshot']);
 if(s.methodology_version!==MACRO_UPSTREAM_VERSION||s.catalog_version!==macroRegimeV1.params.catalog_version)return abstain('upstream_version_mismatch');
 if(s.region!==subject.key)return abstain('binding_mismatch');
 if(!MACRO_REGIMES.every(r=>Number.isFinite(s.scores?.[r])&&Number.isFinite(s.norm?.[r])&&s.norm[r]>=0)
  ||Math.abs(MACRO_REGIMES.reduce((sum,r)=>sum+s.norm[r],0)-1)>5e-6
  ||s.primary_state===null||s.secondary_state===null
  ||!MACRO_REGIMES.includes(s.primary_state)||!MACRO_REGIMES.includes(s.secondary_state)||s.primary_state===s.secondary_state
  ||!Number.isFinite(s.margin_pp))return abstain('invalid_snapshot');
 if(s.coverage<MIN_COVERAGE)return abstain('coverage_below_threshold');
 if(inputs.filter(i=>i.kind==='macro_observation').length!==s.observation_ids.length)return abstain('observation_missing');
 const margin=marginPp(s.norm,s.primary_state,s.secondary_state);
 if(s.margin_pp!==null&&Math.abs(s.margin_pp-margin)>MARGIN_UNIT_TOLERANCE_PP)return abstain('margin_unit_mismatch');
 return {abstained:false,claim:{selected:s.primary_state,classes:[...MACRO_REGIMES],distribution:Object.fromEntries(MACRO_REGIMES.map(r=>[r,s.norm[r]])),
  scores_are_not_probabilities:true,margin_pp:margin,catalog_version:s.catalog_version}};
}

function condition(subject:Subject,inputs:Input[],claim:CategoricalClaim):Condition{
 const s=snapshotOf(inputs);
 if(!s)throw new Error('macro_regime@v1 condition() needs the macro_snapshot input');
 const period=s.as_of.slice(0,7);const sel=claim.selected as Regime;
