+  expect(empty).toBeGreaterThan(0);expect(pts.length+empty).toBe(text.trimEnd().split('\n').length-1);
+  expect(pts.every(p=>/^-?\d+(\.\d+)?$/.test(p.valueText))).toBe(true);
+ });
+});
