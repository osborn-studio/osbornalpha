+  for(const p of parseFredCsv(fx('WTREGEN'),{seriesId:'US_WTREGEN_W',code:'WTREGEN',period:'day'}))expect(new Date(`${p.periodEnd}T00:00:00Z`).getUTCDay()).toBe(3);
